for _, c in ipairs(container:GetDescendants()) do
    if c:IsA("TextLabel") and c ~= percentText then 
        TweenService:Create(c, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { TextTransparency = 0 }):Play()
    elseif c:IsA("TextLabel") and c == percentText then
        TweenService:Create(c, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { TextTransparency = 0 }):Play()
    elseif c:IsA("Frame") and c ~= shine then 
        TweenService:Create(c, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { BackgroundTransparency = 0 }):Play()
    elseif c:IsA("UIStroke") and c ~= glow then 
        TweenService:Create(c, TweenInfo.new(0.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), { Transparency = 0.3 }):Play() 
    end
    task.wait(0.015)
end

TweenService:Create(shine, TweenInfo.new(0.5), { BackgroundTransparency = 0.5 }):Play()

-- Custom loading sequence
local currentProgress = 0
local totalMessages = #Messages

for i, msg in ipairs(Messages) do
    -- Update status text
    local textOut = TweenService:Create(statusText, TweenInfo.new(0.15), { TextTransparency = 1 })
    textOut:Play()
    textOut.Completed:Wait()
    statusText.Text = msg
    TweenService:Create(statusText, TweenInfo.new(0.2), { TextTransparency = 0 }):Play()
    
    -- Calculate progress for this step
    local targetProgress
    if i == 1 then
        targetProgress = 0.25 -- 25%
    elseif i == 2 then
        targetProgress = 0.50 -- 50%
    elseif i == 3 then
        targetProgress = 0.75 -- 75%
    else
        targetProgress = 0.98 -- 98%
    end
    
    -- Animate to target (mabilis)
    local duration = 0.8
    local startProgress = currentProgress
    local stepAmount = targetProgress - startProgress
    
    for t = 0, 1, 0.02 do
        local eased = t * t * (3 - 2 * t) -- smoothstep
        local progress = startProgress + (stepAmount * eased)
        barFill.Size = UDim2.new(progress, 0, 1, 0)
        percentText.Text = string.format("%.0f%%", progress * 100)
        task.wait(duration / 50)
    end
    
    currentProgress = targetProgress
    task.wait(0.3)
end

-- Wait at 98% for a moment
task.wait(0.5)

-- Slow progress from 98% to 99% (1 minute)
local startTime = tick()
local targetProgress = 0.99
local startProgress = currentProgress
local stepAmount = targetProgress - startProgress
local duration = 60 -- 1 minute

while tick() - startTime < duration do
    local elapsed = (tick() - startTime) / duration
    local eased = elapsed * elapsed * (3 - 2 * elapsed)
    local progress = startProgress + (stepAmount * eased)
    barFill.Size = UDim2.new(progress, 0, 1, 0)
    percentText.Text = string.format("%.1f%%", progress * 100)
    task.wait(0.1)
end

-- Ensure we're at exactly 99%
barFill.Size = UDim2.new(0.99, 0, 1, 0)
percentText.Text = "99.0%"
currentProgress = 0.99

-- Wait at 99% for a moment
task.wait(0.5)

-- Slow progress from 99% to 100% (10 minutes)
startTime = tick()
targetProgress = 1.0
startProgress = currentProgress
stepAmount = targetProgress - startProgress
duration = 10 

while tick() - startTime < duration do
    local elapsed = (tick() - startTime) / duration
    local eased = elapsed * elapsed * (3 - 2 * elapsed)
    local progress = startProgress + (stepAmount * eased)
    barFill.Size = UDim2.new(progress, 0, 1, 0)
    percentText.Text = string.format("%.1f%%", progress * 100)
    task.wait(0.1)
end

-- Ensure we're at exactly 100%
barFill.Size = UDim2.new(1, 0, 1, 0)
percentText.Text = "100%"
statusText.Text = "Complete!"

-- Glow effect at completion
