				CanvasSize = UDim2.new(0, 0, 0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ZIndex = 102,
				Parent = card,
			})
			local listLayout = Creator.ListLayout(Enum.FillDirection.Vertical, 2)
			listLayout.Parent = list

			table.clear(optionRows)

			for _, option in ipairs(self.Options) do
				local optionBtn = Creator.New("TextButton", {
					Name = tostring(option),
					Size = UDim2.new(1, -4, 0, 28),
					BackgroundColor3 = Theme.Get("Tertiary"),
					BackgroundTransparency = isSelected(option) and 0.3 or 1,
					AutoButtonColor = false,
					Text = "",
					ZIndex = 103,
					Parent = list,
				}, { Creator.Corner(5) })

				local optLabel = Creator.New("TextLabel", {
					Position = UDim2.new(0, 10, 0, 0),
					Size = UDim2.new(1, -34, 1, 0),
					BackgroundTransparency = 1,
					Font = Enum.Font.Gotham,
					Text = tostring(option),
					TextSize = 12,
					TextColor3 = isSelected(option) and Theme.Get("Accent") or Theme.Get("Text"),
					TextXAlignment = Enum.TextXAlignment.Left,
					ZIndex = 104,
					Parent = optionBtn,
				})

				local checkLabel = Creator.New("TextLabel", {
					AnchorPoint = Vector2.new(1, 0.5),
					Position = UDim2.new(1, -8, 0.5, 0),
					Size = UDim2.fromOffset(16, 16),
					BackgroundTransparency = 1,
					Font = Enum.Font.GothamBold,
					Text = isSelected(option) and CHECK or "",
					TextSize = 12,
					TextColor3 = Theme.Get("Accent"),
					ZIndex = 104,
					Parent = optionBtn,
				})

				optionRows[option] = { Button = optionBtn, Label = optLabel, Check = checkLabel }

				optionBtn.MouseEnter:Connect(function()
					if not isSelected(option) then
						Creator.Snap(optionBtn, { BackgroundTransparency = 0.6 })
					end
				end)
				optionBtn.MouseLeave:Connect(function()
					if not isSelected(option) then
						Creator.Snap(optionBtn, { BackgroundTransparency = 1 })
					end
				end)

				optionBtn.MouseButton1Click:Connect(function()
					if self.Multi then
						toggleMulti(option)
						local sel = isSelected(option)
						Creator.Snap(optionBtn, { BackgroundTransparency = sel and 0.3 or 1 })
						optLabel.TextColor3 = sel and Theme.Get("Accent") or Theme.Get("Text")
						checkLabel.Text = sel and CHECK or ""
					else
						selectSingle(option)
						context.Window:CloseActivePopup()
					end
				end)
			end

			if searchBox then
				searchBox:GetPropertyChangedSignal("Text"):Connect(function()
					local query = searchBox.Text:lower()
					for option, rowData in pairs(optionRows) do
						rowData.Button.Visible = query == "" or tostring(option):lower():find(query, 1, true) ~= nil
					end
				end)
			end

			popupHolder.Size = UDim2.new(popupHolder.Size.X.Scale, popupHolder.Size.X.Offset, 0, listTop + listHeight + 8)

			return function()
				open = false
				Creator.Animate(chevron, { Rotation = 0 }, 0.15)
			end
		end

		root.MouseButton1Click:Connect(function()
			if open then
				context.Window:CloseActivePopup()
				return
			end
			context.Window:OpenPopup(root, buildPopup)
		end)

		root.MouseEnter:Connect(function()
			Creator.Snap(root, { BackgroundColor3 = Theme.Get("Elevated") })
		end)
		root.MouseLeave:Connect(function()
			Creator.Snap(root, { BackgroundColor3 = Theme.Get("Tertiary") })
		end)

		if props.Flag and context.Config then
			context.Config:Register(props.Flag, {
				Get = function()
					return self.Value
				end,
				Set = function(value)
					self.Value = value
					refreshLabel()
					fireChanged()
				end,
			})
		end

		self.Set = function(_self, value, silent)
			if self.Multi then
				self.Value = value
				refreshLabel()
				if not silent then
					fireChanged()
				end
			else
				selectSingle(value, silent)
			end
		end
		self.Get = function(_self)
			return self.Value
		end

		self.Refresh = function(_self, options)
			self.Options = options
			if open then
				context.Window:CloseActivePopup()
			end
		end

		return self
	end

	function Dropdown:OnChanged(fn: (any) -> ())
		local previous = self.Callback
		self.Callback = function(value)
			if previous then
				previous(value)
			end
			fn(value)
		end
	end

	function Dropdown:SetVisible(visible: boolean)
		self.Root.Visible = visible
	end

	function Dropdown:Destroy()
		self.Root:Destroy()
	end

	return Dropdown
end)()


local Textbox = (function()
	-- Textbox: single-line text input with placeholder, optional numeric-only
	-- filtering, and commit-on-focus-lost / commit-on-enter behaviour.


	local Textbox = {}
	Textbox.__index = Textbox

	function Textbox.new(parent: Instance, props: { [string]: any }, context: { [string]: any })
		props = props or {}
		local Theme = context.Theme
		local self = setmetatable({}, Textbox)
		self._context = context
		self.Callback = props.Callback
		self.Numeric = props.Numeric == true
		self.Value = tostring(props.Default or "")

		local root = Creator.New("Frame", {
			Name = (props.Title or "Textbox") .. "Textbox",
			Size = UDim2.new(1, 0, 0, 38),
			BackgroundColor3 = Theme.Get("Tertiary"),
			LayoutOrder = props.LayoutOrder or 0,
			Visible = props.Visible ~= false,
			ZIndex = 2,
			Parent = parent,
		}, { Creator.Corner(6), Creator.Padding(0, 0, 10, 0, 10) })
		Theme.Register(root, { BackgroundColor3 = "Tertiary" })
		self.Root = root

		if props.Tooltip and context.Tooltip then
			context.Tooltip:Bind(root, props.Tooltip)
		end

		local title = Creator.New("TextLabel", {
			Name = "Title",
			Size = UDim2.new(0.4, 0, 1, 0),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamMedium,
			Text = props.Title or "",
			TextSize = 13,
			TextColor3 = Theme.Get("Text"),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 3,
			Parent = root,
		})
		Theme.Register(title, { TextColor3 = "Text" })

		local inputHolder = Creator.New("Frame", {
			Name = "InputHolder",
			Position = UDim2.new(0.4, 0, 0, 6),
			Size = UDim2.new(0.6, 0, 0, 26),
			BackgroundColor3 = Theme.Get("Secondary"),
			ZIndex = 3,
			Parent = root,
		}, { Creator.Corner(5), Creator.Stroke({ Color = Theme.Get("Border"), Thickness = 1 }) })
		Theme.Register(inputHolder, { BackgroundColor3 = "Secondary" })
		local inputStroke = inputHolder:FindFirstChildOfClass("UIStroke")
		if inputStroke then
			Theme.Register(inputStroke, { Color = "Border" })
		end

		local box = Creator.New("TextBox", {
			Name = "Box",
			Position = UDim2.new(0, 8, 0, 0),
			Size = UDim2.new(1, -16, 1, 0),
			BackgroundTransparency = 1,
			Font = Enum.Font.Gotham,
			PlaceholderText = props.Placeholder or "",
			Text = self.Value,
			TextSize = 12,
			TextColor3 = Theme.Get("Text"),
			PlaceholderColor3 = Theme.Get("SubText"),
			TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = false,
			ZIndex = 4,
			Parent = inputHolder,
		})
		Theme.Register(box, { TextColor3 = "Text", PlaceholderColor3 = "SubText" })
		self.Box = box

		box.Focused:Connect(function()
			Creator.Snap(inputStroke, { Color = Theme.Get("Accent") })
		end)

		local function commit(silent: boolean?)
			local text = box.Text
			if self.Numeric then
				text = text:gsub("[^%-%.%d]", "")
				box.Text = text
			end
			self.Value = text
			if not silent and self.Callback then
				local ok, err = pcall(self.Callback, self.Value)
				if not ok then
					warn("[UILibrary] Textbox callback error: " .. tostring(err))
				end
			end
		end

		box.FocusLost:Connect(function(enterPressed)
			if inputStroke then
				Creator.Snap(inputStroke, { Color = Theme.Get("Border") })
			end
			commit()
		end)

		self.Set = function(_self, value, silent)
			box.Text = tostring(value)
			self.Value = box.Text
			if not silent and self.Callback then
				self.Callback(self.Value)
			end
		end
		self.Get = function(_self)
			return self.Value
		end

		if props.Flag and context.Config then
			context.Config:Register(props.Flag, {
				Get = function()
					return self.Value
				end,
				Set = function(value)
					box.Text = tostring(value)
					self.Value = box.Text
					if self.Callback then
						pcall(self.Callback, self.Value)
					end
				end,
			})
		end

		return self
	end

	function Textbox:OnChanged(fn: (string) -> ())
		local previous = self.Callback
		self.Callback = function(value)
			if previous then
				previous(value)
			end
			fn(value)
		end
	end

	function Textbox:SetVisible(visible: boolean)
		self.Root.Visible = visible
	end

	function Textbox:Destroy()
		self.Root:Destroy()
	end

	return Textbox
end)()


local Keybind = (function()
	-- Keybind: click to rebind, listens for the next key/mouse input. Also
	-- works as a direct tap-trigger on touch devices, since there's no
	-- physical key to capture there.

	local UserInputService = game:GetService("UserInputService")

	local Keybind = {}
	Keybind.__index = Keybind

	local function inputName(keyCode: Enum.KeyCode?, mouseButton: Enum.UserInputType?): string
		if mouseButton then
			if mouseButton == Enum.UserInputType.MouseButton1 then
				return "MB1"
			elseif mouseButton == Enum.UserInputType.MouseButton2 then
				return "MB2"
			elseif mouseButton == Enum.UserInputType.MouseButton3 then
				return "MB3"
			end
		end
		if keyCode and keyCode ~= Enum.KeyCode.Unknown then
			return keyCode.Name
		end
		return "None"
	end

	function Keybind.new(parent: Instance, props: { [string]: any }, context: { [string]: any })
		props = props or {}
		local Theme = context.Theme
		local self = setmetatable({}, Keybind)
		self._context = context
		self.Callback = props.Callback
		self.KeyCode = props.Default
		self.MouseButton = nil

		local root = Creator.New("Frame", {
			Name = (props.Title or "Keybind") .. "Keybind",
			Size = UDim2.new(1, 0, 0, 38),
			BackgroundColor3 = Theme.Get("Tertiary"),
			LayoutOrder = props.LayoutOrder or 0,
			Visible = props.Visible ~= false,
			ZIndex = 2,
			Parent = parent,
		}, { Creator.Corner(6), Creator.Padding(0, 0, 10, 0, 10) })
		Theme.Register(root, { BackgroundColor3 = "Tertiary" })
		self.Root = root

		if props.Tooltip and context.Tooltip then
			context.Tooltip:Bind(root, props.Tooltip)
		end

		local title = Creator.New("TextLabel", {
			Name = "Title",
			Size = UDim2.new(1, -110, 1, 0),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamMedium,
			Text = props.Title or "",
			TextSize = 13,
			TextColor3 = Theme.Get("Text"),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 3,
			Parent = root,
		})
		Theme.Register(title, { TextColor3 = "Text" })

		local keyButton = Creator.New("TextButton", {
			Name = "KeyButton",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.fromOffset(96, 26),
			BackgroundColor3 = Theme.Get("Secondary"),
			AutoButtonColor = false,
			Font = Enum.Font.GothamMedium,
			Text = inputName(self.KeyCode),
			TextSize = 12,
			TextColor3 = Theme.Get("SubText"),
			ZIndex = 3,
			Parent = root,
		}, { Creator.Corner(5), Creator.Stroke({ Color = Theme.Get("Border"), Thickness = 1 }) })
		Theme.Register(keyButton, { BackgroundColor3 = "Secondary", TextColor3 = "SubText" })
		local keyStroke = keyButton:FindFirstChildOfClass("UIStroke")
		if keyStroke then
			Theme.Register(keyStroke, { Color = "Border" })
		end
		self.KeyButton = keyButton

		local listening = false
		local listenConn: RBXScriptConnection? = nil

		local function stopListening()
			listening = false
			if listenConn then
				listenConn:Disconnect()
				listenConn = nil
			end
			keyButton.Text = inputName(self.KeyCode, self.MouseButton)
			Creator.Snap(keyStroke, { Color = Theme.Get("Border") })
		end

		local function startListening()
			if listening then
				return
			end
			listening = true
			keyButton.Text = "..."
			Creator.Snap(keyStroke, { Color = Theme.Get("Accent") })
			listenConn = UserInputService.InputBegan:Connect(function(input, processed)
				if input.UserInputType == Enum.UserInputType.Keyboard then
					if input.KeyCode == Enum.KeyCode.Escape then
						self.KeyCode = nil
						self.MouseButton = nil
					else
						self.KeyCode = input.KeyCode
						self.MouseButton = nil
					end
					stopListening()
				elseif input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.MouseButton2
					or input.UserInputType == Enum.UserInputType.MouseButton3 then
					self.KeyCode = nil
					self.MouseButton = input.UserInputType
					stopListening()
				end
			end)
		end

		keyButton.MouseButton1Click:Connect(function()
			if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled then
				-- no physical keyboard: treat a tap as a direct trigger
				if self.Callback then
					self.Callback(true)
					task.wait()
					self.Callback(false)
				end
				return
			end
			if listening then
				stopListening()
			else
				startListening()
			end
		end)

		UserInputService.InputBegan:Connect(function(input, processed)
			if listening or processed then
				return
			end
			local matches = (self.KeyCode and input.KeyCode == self.KeyCode)
				or (self.MouseButton and input.UserInputType == self.MouseButton)
			if matches and self.Callback then
				local ok, err = pcall(self.Callback, true)
				if not ok then
					warn("[UILibrary] Keybind callback error: " .. tostring(err))
				end
			end
		end)
		UserInputService.InputEnded:Connect(function(input)
			local matches = (self.KeyCode and input.KeyCode == self.KeyCode)
				or (self.MouseButton and input.UserInputType == self.MouseButton)
			if matches and self.Callback then
				pcall(self.Callback, false)
			end
		end)

		self.Set = function(_self, keyCode, silent)
			self.KeyCode = keyCode
			self.MouseButton = nil
			keyButton.Text = inputName(self.KeyCode, self.MouseButton)
		end
		self.Get = function(_self)
			return self.KeyCode
		end

		if props.Flag and context.Config then
			context.Config:Register(props.Flag, {
				Get = function()
					return self.KeyCode and self.KeyCode.Name or nil
				end,
				Set = function(value)
					if value and Enum.KeyCode[value] then
						self.KeyCode = Enum.KeyCode[value]
						self.MouseButton = nil
						keyButton.Text = inputName(self.KeyCode)
					end
				end,
			})
		end

		return self
	end

	function Keybind:SetVisible(visible: boolean)
		self.Root.Visible = visible
	end

	function Keybind:Destroy()
		self.Root:Destroy()
	end

	return Keybind
end)()


local ColorPicker = (function()
	-- ColorPicker: HSV saturation/value square + hue strip + hex input,
	-- rendered on the Window overlay. The SV square is 3 stacked Frames
	-- (hue fill, white->transparent gradient, black->transparent gradient)
	-- rather than a per-pixel canvas -- cheap and fully vector/GPU composited.

	local UserInputService = game:GetService("UserInputService")

	local ColorPicker = {}
	ColorPicker.__index = ColorPicker

	local function isPointer(inputType: Enum.UserInputType): boolean
		return inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch
	end

	local function toHex(color: Color3): string
		return string.format("%02X%02X%02X", math.round(color.R * 255), math.round(color.G * 255), math.round(color.B * 255))
	end

	local function fromHex(hex: string): Color3?
		hex = hex:gsub("#", "")
		if #hex ~= 6 then
			return nil
		end
		local r = tonumber(hex:sub(1, 2), 16)
		local g = tonumber(hex:sub(3, 4), 16)
		local b = tonumber(hex:sub(5, 6), 16)
		if not (r and g and b) then
			return nil
		end
		return Color3.fromRGB(r, g, b)
	end

	function ColorPicker.new(parent: Instance, props: { [string]: any }, context: { [string]: any })
		props = props or {}
		local Theme = context.Theme
		local self = setmetatable({}, ColorPicker)
		self._context = context
		self.Callback = props.Callback

		local default = props.Default or Color3.fromRGB(88, 101, 242)
		local h, s, v = Color3.toHSV(default)
		self.Hue, self.Sat, self.Val = h, s, v
		self.Color = default

		local root = Creator.New("TextButton", {
			Name = (props.Title or "ColorPicker") .. "ColorPicker",
			Size = UDim2.new(1, 0, 0, 38),
			BackgroundColor3 = Theme.Get("Tertiary"),
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = props.LayoutOrder or 0,
			Visible = props.Visible ~= false,
			ZIndex = 2,
			Parent = parent,
		}, { Creator.Corner(6), Creator.Padding(0, 0, 10, 0, 10) })
		Theme.Register(root, { BackgroundColor3 = "Tertiary" })
		self.Root = root

		if props.Tooltip and context.Tooltip then
			context.Tooltip:Bind(root, props.Tooltip)
		end

		local title = Creator.New("TextLabel", {
			Name = "Title",
			Size = UDim2.new(1, -50, 1, 0),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamMedium,
			Text = props.Title or "",
			TextSize = 13,
			TextColor3 = Theme.Get("Text"),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 3,
			Parent = root,
		})
		Theme.Register(title, { TextColor3 = "Text" })

		local swatch = Creator.New("Frame", {
			Name = "Swatch",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.fromOffset(34, 22),
			BackgroundColor3 = self.Color,
			ZIndex = 3,
			Parent = root,
		}, { Creator.Corner(5), Creator.Stroke({ Color = Theme.Get("Border"), Thickness = 1 }) })
		local swatchStroke = swatch:FindFirstChildOfClass("UIStroke")
		if swatchStroke then
			Theme.Register(swatchStroke, { Color = "Border" })
		end
		self.Swatch = swatch

		local function currentColor(): Color3
			return Color3.fromHSV(self.Hue, self.Sat, self.Val)
		end

		local hexBoxRef: TextBox? = nil

		local function fireChanged(silent: boolean?)
			self.Color = currentColor()
			swatch.BackgroundColor3 = self.Color
			if not silent and self.Callback then
				local ok, err = pcall(self.Callback, self.Color)
				if not ok then
					warn("[UILibrary] ColorPicker callback error: " .. tostring(err))
				end
			end
		end

		local function syncVisuals()
			if hexBoxRef then
				hexBoxRef.Text = toHex(currentColor())
			end
		end

		local function buildPopup(popupHolder: Frame)
			Creator.Shadow(popupHolder, 8, 0.4)

			local card = Creator.New("Frame", {
				Name = "ColorCard",
				BackgroundColor3 = Theme.Get("Elevated"),
				Size = UDim2.new(1, 0, 0, 214),
				ZIndex = 101,
				Parent = popupHolder,
			}, { Creator.Corner(8), Creator.Stroke({ Color = Theme.Get("Border"), Thickness = 1 }), Creator.Padding(10) })
			Theme.Register(card, { BackgroundColor3 = "Elevated" })
			local cardStroke = card:FindFirstChildOfClass("UIStroke")
			if cardStroke then
				Theme.Register(cardStroke, { Color = "Border" })
			end
			popupHolder.Size = UDim2.new(popupHolder.Size.X.Scale, popupHolder.Size.X.Offset, 0, 214)

			-- SV square -----------------------------------------------------
			local svBox = Creator.New("Frame", {
				Name = "SVBox",
				Size = UDim2.new(1, 0, 0, 120),
				BackgroundColor3 = Color3.fromHSV(self.Hue, 1, 1),
				ClipsDescendants = true,
				ZIndex = 102,
				Parent = card,
			}, { Creator.Corner(6) })

			Creator.New("Frame", {
				Name = "WhiteOverlay",
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundColor3 = Color3.new(1, 1, 1),
				BorderSizePixel = 0,
				ZIndex = 103,
				Parent = svBox,
			}, {
				Creator.New("UIGradient", {
					Color = ColorSequence.new(Color3.new(1, 1, 1)),
					Transparency = NumberSequence.new({
						NumberSequenceKeypoint.new(0, 0),
						NumberSequenceKeypoint.new(1, 1),
					}),
				}),
			})

			Creator.New("Frame", {
				Name = "BlackOverlay",
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundColor3 = Color3.new(0, 0, 0),
				BorderSizePixel = 0,
				ZIndex = 104,
				Parent = svBox,
			}, {
				Creator.New("UIGradient", {
					Rotation = 90,
					Color = ColorSequence.new(Color3.new(0, 0, 0)),
					Transparency = NumberSequence.new({
						NumberSequenceKeypoint.new(0, 1),
						NumberSequenceKeypoint.new(1, 0),
					}),
				}),
			})

			local cursor = Creator.New("Frame", {
				Name = "Cursor",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Size = UDim2.fromOffset(12, 12),
				Position = UDim2.new(self.Sat, 0, 1 - self.Val, 0),
				BackgroundColor3 = Color3.new(1, 1, 1),
				ZIndex = 105,
				Parent = svBox,
			}, { Creator.Corner(999), Creator.Stroke({ Color = Color3.new(0, 0, 0), Thickness = 1.5, Transparency = 0.4 }) })

			local svDragging = false
			local function updateSV(x: number, y: number)
				local abs = svBox.AbsolutePosition
				local size = svBox.AbsoluteSize
				local fx = math.clamp((x - abs.X) / size.X, 0, 1)
				local fy = math.clamp((y - abs.Y) / size.Y, 0, 1)
				self.Sat = fx
				self.Val = 1 - fy
				cursor.Position = UDim2.new(fx, 0, fy, 0)
				fireChanged()
				syncVisuals()
			end
			svBox.InputBegan:Connect(function(input)
				if isPointer(input.UserInputType) then
					svDragging = true
					updateSV(input.Position.X, input.Position.Y)
				end
			end)

			-- Hue strip -------------------------------------------------------
			local hueBar = Creator.New("Frame", {
				Name = "HueBar",
				Position = UDim2.new(0, 0, 0, 132),
				Size = UDim2.new(1, 0, 0, 16),
				ZIndex = 102,
				Parent = card,
			}, {
				Creator.Corner(6),
				Creator.New("UIGradient", {
					Color = ColorSequence.new({
						ColorSequenceKeypoint.new(0, Color3.fromHSV(0, 1, 1)),
						ColorSequenceKeypoint.new(1 / 6, Color3.fromHSV(1 / 6, 1, 1)),
						ColorSequenceKeypoint.new(2 / 6, Color3.fromHSV(2 / 6, 1, 1)),
						ColorSequenceKeypoint.new(3 / 6, Color3.fromHSV(3 / 6, 1, 1)),
						ColorSequenceKeypoint.new(4 / 6, Color3.fromHSV(4 / 6, 1, 1)),
						ColorSequenceKeypoint.new(5 / 6, Color3.fromHSV(5 / 6, 1, 1)),
						ColorSequenceKeypoint.new(1, Color3.fromHSV(1, 1, 1)),
					}),
				}),
			})

			local hueMarker = Creator.New("Frame", {
				Name = "Marker",
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(self.Hue, 0, 0.5, 0),
				Size = UDim2.fromOffset(5, 20),
				BackgroundColor3 = Color3.new(1, 1, 1),
				ZIndex = 103,
				Parent = hueBar,
			}, { Creator.Corner(2), Creator.Stroke({ Color = Color3.new(0, 0, 0), Thickness = 1, Transparency = 0.5 }) })

			local hueDragging = false
			local function updateHue(x: number)
				local abs = hueBar.AbsolutePosition.X
				local size = hueBar.AbsoluteSize.X
				local fx = math.clamp((x - abs) / size, 0, 1)
				self.Hue = fx
				hueMarker.Position = UDim2.new(fx, 0, 0.5, 0)
				svBox.BackgroundColor3 = Color3.fromHSV(self.Hue, 1, 1)
				fireChanged()
				syncVisuals()
			end
			hueBar.InputBegan:Connect(function(input)
				if isPointer(input.UserInputType) then
					hueDragging = true
					updateHue(input.Position.X)
				end
			end)

			local moveConn = UserInputService.InputChanged:Connect(function(input)
				if not (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					return
				end
				if svDragging then
					updateSV(input.Position.X, input.Position.Y)
				elseif hueDragging then
					updateHue(input.Position.X)
				end
			end)
			local endConn = UserInputService.InputEnded:Connect(function(input)
				if isPointer(input.UserInputType) then
					svDragging = false
					hueDragging = false
				end
			end)

			-- Hex input ---------------------------------------------------------
			local hexHolder = Creator.New("Frame", {
				Position = UDim2.new(0, 0, 0, 158),
				Size = UDim2.new(1, 0, 0, 26),
				BackgroundColor3 = Theme.Get("Tertiary"),
				ZIndex = 102,
				Parent = card,
			}, { Creator.Corner(5) })
			Theme.Register(hexHolder, { BackgroundColor3 = "Tertiary" })

			local hashLabel = Creator.New("TextLabel", {
				Position = UDim2.new(0, 8, 0, 0),
				Size = UDim2.fromOffset(12, 26),
				BackgroundTransparency = 1,
				Font = Enum.Font.GothamMedium,
				Text = "#",
				TextSize = 12,
				TextColor3 = Theme.Get("SubText"),
				ZIndex = 103,
				Parent = hexHolder,
			})
			Theme.Register(hashLabel, { TextColor3 = "SubText" })

			local hexBox = Creator.New("TextBox", {
				Position = UDim2.new(0, 20, 0, 0),
				Size = UDim2.new(1, -28, 1, 0),
				BackgroundTransparency = 1,
				Font = Enum.Font.Gotham,
				Text = toHex(currentColor()),
				TextSize = 12,
				TextColor3 = Theme.Get("Text"),
				TextXAlignment = Enum.TextXAlignment.Left,
				ClearTextOnFocus = false,
				ZIndex = 103,
				Parent = hexHolder,
			})
			Theme.Register(hexBox, { TextColor3 = "Text" })
			hexBoxRef = hexBox

			hexBox.FocusLost:Connect(function()
				local color = fromHex(hexBox.Text)
				if color then
					local nh, ns, nv = Color3.toHSV(color)
					self.Hue, self.Sat, self.Val = nh, ns, nv
					cursor.Position = UDim2.new(self.Sat, 0, 1 - self.Val, 0)
					hueMarker.Position = UDim2.new(self.Hue, 0, 0.5, 0)
					svBox.BackgroundColor3 = Color3.fromHSV(self.Hue, 1, 1)
					fireChanged()
				end
				hexBox.Text = toHex(currentColor())
			end)

			return function()
				moveConn:Disconnect()
				endConn:Disconnect()
				hexBoxRef = nil
			end
		end

		root.MouseButton1Click:Connect(function()
			context.Window:OpenPopup(root, buildPopup)
		end)
		root.MouseEnter:Connect(function()
			Creator.Snap(root, { BackgroundColor3 = Theme.Get("Elevated") })
		end)
		root.MouseLeave:Connect(function()
			Creator.Snap(root, { BackgroundColor3 = Theme.Get("Tertiary") })
		end)

		self.Set = function(_self, color: Color3, silent: boolean?)
			local nh, ns, nv = Color3.toHSV(color)
			self.Hue, self.Sat, self.Val = nh, ns, nv
			fireChanged(silent)
		end
		self.Get = function(_self)
			return self.Color
		end

		if props.Flag and context.Config then
			context.Config:Register(props.Flag, {
				Get = function()
					return { toHex(self.Color) }
				end,
				Set = function(value)
					local hex = typeof(value) == "table" and value[1] or value
					local color = fromHex(tostring(hex))
					if color then
						local nh, ns, nv = Color3.toHSV(color)
						self.Hue, self.Sat, self.Val = nh, ns, nv
						-- config load should actually re-apply effects, not
						-- just silently sync the visual state
						fireChanged(false)
					end
				end,
			})
		end

		return self
	end

	function ColorPicker:OnChanged(fn: (Color3) -> ())
		local previous = self.Callback
		self.Callback = function(value)
			if previous then
				previous(value)
			end
			fn(value)
		end
	end

	function ColorPicker:SetVisible(visible: boolean)
		self.Root.Visible = visible
	end

	function ColorPicker:Destroy()
		self.Root:Destroy()
	end

	return ColorPicker
end)()


