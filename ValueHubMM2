					Parent = searchHolder,
				})
				Theme.Register(searchBox, { TextColor3 = "Text", PlaceholderColor3 = "SubText" })
				listTop = 36
			end

			local listHeight = math.min(maxHeight, #self.Options * 32 + 8)
			local list = Creator.New("ScrollingFrame", {
