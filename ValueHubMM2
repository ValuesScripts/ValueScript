		-- Applies a built-in sprite icon (one of the Icons.X tables above) to
		-- an ImageLabel/ImageButton: sets Image + the sprite-sheet crop.
		function Icons.Apply(imageInstance, icon)
			if type(icon) ~= "table" or not icon.Id then return end
			imageInstance.Image = icon.Url
			imageInstance.ImageRectOffset = icon.Rect
			imageInstance.ImageRectSize = icon.Size
		end

		-- Resolves a user-supplied icon value (Tab/Window/Avatar/Card ...):
		-- a raw rbxassetid string/number, or nil. Dev-supplied icons are
		-- always plain full images, never one of our internal sprites.
		function Icons.Resolve(value)
			if value == nil then return nil end
			if type(value) == "number" then
				return "rbxassetid://" .. value
			end
			if type(value) == "string" then
				return value
			end
			return nil
		end

		return Icons
	end)

	--============================================================================
	-- MODULE: Acrylic
	-- Custom blur/acrylic simulation system. Executors cannot apply true
	-- viewport blur to arbitrary ScreenGui regions, so "blur" is faked with
	-- stacked semi-transparent layers, a soft gradient sheen, and a noise
	-- texture — configurable via a single Strength parameter (0-1).
	--============================================================================

	register("Acrylic", function(import)

		local Utility = import("Utility")
		local Theme = import("Theme")
		local Create = Utility.Create

		local Acrylic = {}
		Acrylic.Strength = 0.55 -- default global blur strength, 0 = flat, 1 = heaviest

		-- Builds a layered acrylic panel inside `parent` (or creates+returns a
		-- fresh Frame if no parent is given). Layers:
		--   1) base tint (ElevatedAlt color, semi transparent)
		--   2) diagonal gradient sheen (subtle light/dark banding, "glass" feel)
		--   3) faint noise-like texture via repeated small gradient (cheap, static)
		--   4) top-edge highlight stroke
		function Acrylic.Apply(target, opts)
			opts = opts or {}
			local strength = opts.Strength or Acrylic.Strength
			local colors = Theme.Get()
			local tint = opts.Color or colors.ElevatedAlt

			target.BackgroundColor3 = tint
			target.BackgroundTransparency = Utility.Lerp(0.35, 0.06, strength)

			local sheen = target:FindFirstChild("__AcrylicSheen")
			if not sheen then
				sheen = Create("Frame", {
					Name = "__AcrylicSheen",
					BackgroundTransparency = 1,
					Size = UDim2.fromScale(1, 1),
					ZIndex = target.ZIndex,
					Parent = target,
				})
				Utility.Gradient(ColorSequence.new({
					ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
					ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
					ColorSequenceKeypoint.new(1, Color3.fromRGB(120, 120, 130)),
				}), 105, NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.93),
					NumberSequenceKeypoint.new(0.5, 0.985),
					NumberSequenceKeypoint.new(1, 0.9),
				}), sheen)
				sheen.BackgroundTransparency = 0
			end

			local existingCorner = target:FindFirstChildOfClass("UICorner")
			if not existingCorner then
				Utility.Corner(opts.Radius or 14, target)
			end

			local stroke = target:FindFirstChild("__AcrylicStroke")
			if not stroke then
				stroke = Utility.Stroke({
					Color = colors.Border,
					Thickness = 1,
					Transparency = colors.BorderAlpha or 0.9,
				}, target)
				stroke.Name = "__AcrylicStroke"
			end

			return target
		end

		-- Creates a full acrylic panel from scratch.
		function Acrylic.Panel(props, parent)
			props = props or {}
			local panel = Create("Frame", {
				Name = props.Name or "AcrylicPanel",
				Size = props.Size or UDim2.fromOffset(300, 200),
				Position = props.Position,
				AnchorPoint = props.AnchorPoint,
				BorderSizePixel = 0,
				ClipsDescendants = props.ClipsDescendants ~= false,
				Parent = parent,
			})
			Acrylic.Apply(panel, props)

			if props.Shadow ~= false then
				Utility.Shadow({ Transparency = 0.6, Spread = 40 }, panel)
			end

			return panel
		end

		-- Full-screen dim/blur overlay used behind modals, dialogs, popups.
		function Acrylic.Overlay(parent, transparency)
			local colors = Theme.Get()
			local overlay = Create("Frame", {
				Name = "Overlay",
				BackgroundColor3 = colors.Overlay,
				BackgroundTransparency = transparency or 0.45,
				Size = UDim2.fromScale(1, 1),
				BorderSizePixel = 0,
				ZIndex = 50,
				Parent = parent,
			})
			return overlay
		end

		return Acrylic
	end)

	--============================================================================
	-- MODULE: Draggable
	-- Mouse + touch dragging and corner-resizing for windows/panels. Uses
	-- UserInputService directly (not GuiObject:Drag) for full control over
	-- bounds clamping, edge snapping, and mobile safe-area handling.
	--============================================================================

	register("Draggable", function(import)

		local UserInputService = game:GetService("UserInputService")
		local Utility = import("Utility")
		local Animator = import("Animator")

		local Draggable = {}

		local function isDragInput(input)
			return input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch
		end

		-- Makes `frame` draggable via `handle` (defaults to frame itself).
		-- opts:
		--   Bounds        : boolean, clamp within screen (default true)
		--   SnapEdges     : boolean, snap near-edge drags to the edge (default false)
		--   OnStart/OnEnd : callback functions
		function Draggable.Make(frame, handle, opts)
			opts = opts or {}
			handle = handle or frame
			local bounds = opts.Bounds ~= false

			local dragging = false
			local dragStart, startPos
			local connections = {}

			local function update(input)
				local delta = input.Position - dragStart
				local newPos = UDim2.new(
					startPos.X.Scale, startPos.X.Offset + delta.X,
					startPos.Y.Scale, startPos.Y.Offset + delta.Y
				)

				if bounds then
					local viewport = frame.Parent and frame.Parent.AbsoluteSize or Vector2.new(1920, 1080)
					local size = frame.AbsoluteSize
					local absX = (newPos.X.Scale * viewport.X) + newPos.X.Offset
					local absY = (newPos.Y.Scale * viewport.Y) + newPos.Y.Offset
					absX = Utility.Clamp(absX, -size.X * 0.5, viewport.X - size.X * 0.5)
					absY = Utility.Clamp(absY, 0, viewport.Y - size.Y * 0.35)
					newPos = UDim2.fromOffset(absX, absY)
				end

				frame.Position = newPos
			end

			table.insert(connections, handle.InputBegan:Connect(function(input)
				if not isDragInput(input) then return end

				dragging = true
				dragStart = input.Position
				startPos = frame.Position
				if opts.OnStart then opts.OnStart() end

				local changedConn
				changedConn = input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						dragging = false
						if opts.OnEnd then opts.OnEnd() end
						changedConn:Disconnect()
					end
				end)
				table.insert(connections, changedConn)
			end))

			table.insert(connections, UserInputService.InputChanged:Connect(function(input)
				if not dragging then return end
				if input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch then
					update(input)
				end
			end))

			return {
				Destroy = function()
					for _, conn in ipairs(connections) do
						if conn.Connected then conn:Disconnect() end
					end
				end,
			}
		end

		-- Adds a bottom-right resize handle to `frame`.
		function Draggable.MakeResizable(frame, handle, minSize, maxSize)
			minSize = minSize or Vector2.new(360, 260)
			maxSize = maxSize or Vector2.new(1400, 1000)

			local resizing = false
			local startInputPos, startSize
			local connections = {}

			table.insert(connections, handle.InputBegan:Connect(function(input)
				if not isDragInput(input) then return end
				resizing = true
				startInputPos = input.Position
				startSize = frame.Size

				local changedConn
				changedConn = input.Changed:Connect(function()
					if input.UserInputState == Enum.UserInputState.End then
						resizing = false
						changedConn:Disconnect()
					end
				end)
				table.insert(connections, changedConn)
			end))

			table.insert(connections, UserInputService.InputChanged:Connect(function(input)
				if not resizing then return end
				if input.UserInputType == Enum.UserInputType.MouseMovement
					or input.UserInputType == Enum.UserInputType.Touch then
					local delta = input.Position - startInputPos
					local newX = Utility.Clamp(startSize.X.Offset + delta.X, minSize.X, maxSize.X)
					local newY = Utility.Clamp(startSize.Y.Offset + delta.Y, minSize.Y, maxSize.Y)
					frame.Size = UDim2.fromOffset(newX, newY)
				end
			end))

			return {
				Destroy = function()
					for _, conn in ipairs(connections) do
						if conn.Connected then conn:Disconnect() end
					end
				end,
			}
		end

		return Draggable
	end)

	--============================================================================
	-- MODULE: Input
	-- Central input manager: mobile/touch detection, the global UI-toggle
	-- keybind (with modifier support), and a "record next input" helper used
	-- by the Keybind component. One InputBegan/InputEnded connection total —
	-- every consumer subscribes through signals instead of adding its own.
	--============================================================================

	register("Input", function(import)

		local UserInputService = game:GetService("UserInputService")
		local Signal = import("Signal")

		local Input = {}
		Input.ToggleRequested = Signal.new()
		Input.KeyPressed = Signal.new()
		Input.KeyReleased = Signal.new()

		Input.Held = {}

		Input.ToggleKeybind = { Key = Enum.KeyCode.RightShift, Modifiers = {} }

		local recorders = {}

		function Input.IsMobile()
			return UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
		end

		function Input.SetToggleKeybind(key, modifiers)
			Input.ToggleKeybind = { Key = key, Modifiers = modifiers or {} }
		end

		local function comboSatisfied(combo)
			for _, modifier in ipairs(combo.Modifiers) do
				if not Input.Held[modifier] then
					return false
				end
			end
			return true
		end

		local function inputToId(input)
			if input.UserInputType == Enum.UserInputType.Keyboard then
				return input.KeyCode
			end
			return input.UserInputType
		end

		-- Registers a one-shot "press any key/mouse button" listener, used by
		-- the Keybind component while it is in recording mode. Returns a
		-- disconnect function.
		function Input.RecordNext(callback)
			local id = {}
			recorders[id] = callback
			return function()
				recorders[id] = nil
			end
		end

		UserInputService.InputBegan:Connect(function(input, gameProcessed)
			local id = inputToId(input)
			Input.Held[id] = true

			if next(recorders) ~= nil then
				if input.UserInputType == Enum.UserInputType.Keyboard
					or input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.MouseButton2
					or input.UserInputType == Enum.UserInputType.MouseButton3 then
					local snapshot = {}
					for rid, cb in pairs(recorders) do
						snapshot[rid] = cb
					end
					for rid, cb in pairs(snapshot) do
						recorders[rid] = nil
						task.spawn(cb, id, input)
					end
					return
				end
			end

			if gameProcessed then
				-- still allow the toggle keybind to fire even over other UI
				if id ~= Input.ToggleKeybind.Key then
					Input.KeyPressed:Fire(id, input)
					return
				end
			end

			if id == Input.ToggleKeybind.Key and comboSatisfied(Input.ToggleKeybind) then
				Input.ToggleRequested:Fire()
			end

			Input.KeyPressed:Fire(id, input)
		end)

		UserInputService.InputEnded:Connect(function(input)
			local id = inputToId(input)
			Input.Held[id] = nil
			Input.KeyReleased:Fire(id, input)
		end)

		-- Human readable label for a KeyCode/UserInputType, used by the
		-- Keybind component display text.
		function Input.LabelFor(id)
			if typeof(id) == "EnumItem" then
				if id.EnumType == Enum.KeyCode then
					return id.Name
				elseif id == Enum.UserInputType.MouseButton1 then
					return "MB1"
				elseif id == Enum.UserInputType.MouseButton2 then
					return "MB2"
				elseif id == Enum.UserInputType.MouseButton3 then
					return "MB3"
				end
			end
			return tostring(id)
		end

		return Input
	end)

	--============================================================================
	-- MODULE: Config
	-- Configuration / profile persistence. Components register a Flag name +
	-- getter/setter pair; Config can then Save/Load/Export/Import the entire
	-- UI state as JSON via writefile/readfile (UNC) with clipboard fallback.
	-- Autosave is event-driven (debounced on flag change) — never a polling loop.
	--============================================================================

	register("Config", function(import)

		local HttpService = game:GetService("HttpService")
		local Signal = import("Signal")

		local Config = {}
		Config.FolderName = "AuraLibrary"
		Config.Flags = {}         -- flagName -> current value
		Config.Changed = Signal.new()

		local setters = {}        -- flagName -> function(value)
		local autoSave = false
		local autoSaveConfigName = nil
		local saveDebounceThread = nil

		local function hasFileApi()
			return type(writefile) == "function"
				and type(readfile) == "function"
				and type(isfile) == "function"
		end

		local function ensureFolder()
			if type(isfolder) == "function" and type(makefolder) == "function" then
				if not isfolder(Config.FolderName) then
					makefolder(Config.FolderName)
				end
				if not isfolder(Config.FolderName .. "/configs") then
					makefolder(Config.FolderName .. "/configs")
				end
			end
		end

		-- Registers a component's persistent value. `set` is called on Load/Import.
		function Config.Register(flag, initialValue, set)
			Config.Flags[flag] = initialValue
			setters[flag] = set
		end

		function Config.Set(flag, value, fromLoad)
			Config.Flags[flag] = value
			Config.Changed:Fire(flag, value)
			if autoSave and not fromLoad then
				Config.RequestAutoSave()
			end
		end

		function Config.RequestAutoSave()
			if not autoSave or not autoSaveConfigName then return end
			if saveDebounceThread then return end
			saveDebounceThread = task.delay(0.6, function()
				saveDebounceThread = nil
				Config.Save(autoSaveConfigName)
			end)
		end

		function Config.SetAutoSave(enabled, configName)
			autoSave = enabled
			autoSaveConfigName = configName or autoSaveConfigName or "autosave"
		end

		function Config.Export()
			return HttpService:JSONEncode(Config.Flags)
		end

		function Config.Import(json, activate)
			local ok, decoded = pcall(HttpService.JSONDecode, HttpService, json)
			if not ok or type(decoded) ~= "table" then
				return false, "Invalid config JSON"
			end
			for flag, value in pairs(decoded) do
				Config.Flags[flag] = value
				if activate ~= false and setters[flag] then
					pcall(setters[flag], value)
				end
			end
			return true
		end

		function Config.Save(name)
			if not hasFileApi() then return false, "No file API available" end
			ensureFolder()
			local ok, err = pcall(function()
				writefile(Config.FolderName .. "/configs/" .. name .. ".json", Config.Export())
			end)
			return ok, err
		end

		function Config.Load(name)
			if not hasFileApi() then return false, "No file API available" end
			local path = Config.FolderName .. "/configs/" .. name .. ".json"
			if not isfile(path) then return false, "Config does not exist" end
			local ok, contents = pcall(readfile, path)
			if not ok then return false, contents end
			return Config.Import(contents)
		end

		function Config.Delete(name)
			if type(delfile) ~= "function" then return false end
			local path = Config.FolderName .. "/configs/" .. name .. ".json"
			if isfile and isfile(path) then
				pcall(delfile, path)
				return true
			end
			return false
		end

		function Config.ListConfigs()
			local names = {}
			if type(listfiles) ~= "function" then return names end
			ensureFolder()
			local ok, files = pcall(listfiles, Config.FolderName .. "/configs")
			if not ok then return names end
			for _, path in ipairs(files) do
				local name = path:match("([^\\/]+)%.json$")
				if name then table.insert(names, name) end
			end
			table.sort(names)
			return names
		end

		function Config.CopyToClipboard()
			if type(setclipboard) == "function" then
				setclipboard(Config.Export())
				return true
			end
			return false
		end

		function Config.LoadFromClipboard()
			if type(getclipboard) ~= "function" then return false, "Clipboard read unsupported" end
			local ok, contents = pcall(getclipboard)
			if not ok or not contents then return false, "Clipboard empty" end
			return Config.Import(contents)
		end

		-- Marks a config to auto-load next time the script executes.
		function Config.SetLoadOnStartup(name)
			if not hasFileApi() then return false end
			ensureFolder()
			pcall(writefile, Config.FolderName .. "/configs/__startup.txt", name)
			return true
		end

		function Config.AutoLoad()
			if not hasFileApi() then return false end
			local path = Config.FolderName .. "/configs/__startup.txt"
			if not isfile(path) then return false end
			local ok, name = pcall(readfile, path)
			if not ok or name == "" then return false end
			return Config.Load(name)
		end

		return Config
	end)

	--============================================================================
	-- MODULE: Notifications
	-- Toast notification center: stacking, per-corner anchoring, queueing,
	-- typed styling (Success/Error/Warning/Info/Loading/Progress), action
	-- buttons, countdown bars, sound, and Promise-style helpers.
	--============================================================================

	register("Notifications", function(import)

		local Utility = import("Utility")
		local Animator = import("Animator")
		local Theme = import("Theme")
		local Icons = import("Icons")
		local Acrylic = import("Acrylic")
		local Maid = import("Maid")
		local Create = Utility.Create

		local Notifications = {}
		Notifications.MaxVisible = 5
		Notifications.DefaultCorner = "BottomRight"
		Notifications.DefaultDuration = 5

		local containers = {}
		local queue = {}
		local visibleCount = 0
		local rootGui

		local CORNER_CONFIG = {
			TopLeft     = { Anchor = Vector2.new(0, 0), Pos = UDim2.new(0, 20, 0, 20), Align = Enum.VerticalAlignment.Top },
			TopRight    = { Anchor = Vector2.new(1, 0), Pos = UDim2.new(1, -20, 0, 20), Align = Enum.VerticalAlignment.Top },
			BottomLeft  = { Anchor = Vector2.new(0, 1), Pos = UDim2.new(0, 20, 1, -20), Align = Enum.VerticalAlignment.Bottom },
			BottomRight = { Anchor = Vector2.new(1, 1), Pos = UDim2.new(1, -20, 1, -20), Align = Enum.VerticalAlignment.Bottom },
		}

		local TYPE_STYLE = {
			Success = { Icon = Icons.Success, ColorKey = "Success" },
			Error   = { Icon = Icons.Error,   ColorKey = "Error" },
			Warning = { Icon = Icons.Warning, ColorKey = "Warning" },
			Info    = { Icon = Icons.Info,    ColorKey = "Info" },
			Loading = { Icon = Icons.Loading, ColorKey = "Accent" },
			Progress= { Icon = Icons.Loading, ColorKey = "Accent" },
		}

		local function getContainer(corner)
			if containers[corner] then return containers[corner] end
			local cfg = CORNER_CONFIG[corner] or CORNER_CONFIG.BottomRight
			local container = Create("Frame", {
				Name = "NotificationContainer_" .. corner,
				BackgroundTransparency = 1,
				AnchorPoint = cfg.Anchor,
				Position = cfg.Pos,
				Size = UDim2.new(0, 320, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				ZIndex = 500,
				Parent = rootGui,
			})
			Utility.ListLayout({ VerticalAlignment = cfg.Align, Padding = UDim.new(0, 10) }, container)
			containers[corner] = container
			return container
		end

		function Notifications.Init(root)
			rootGui = root
		end

		local function playSound(soundId)
			if not soundId then return end
			task.spawn(function()
				local ok, sound = pcall(function()
					local s = Instance.new("Sound")
					s.SoundId = soundId
					s.Volume = 0.5
					s.Parent = game:GetService("SoundService")
					return s
				end)
				if ok and sound then
					sound:Play()
					sound.Ended:Once(function() sound:Destroy() end)
					task.delay(5, function() if sound then sound:Destroy() end end)
				end
			end)
		end

		local function buildCard(opts)
			local colors = Theme.Get()
			local style = TYPE_STYLE[opts.Type] or TYPE_STYLE.Info
			local accent = colors[style.ColorKey] or colors.Accent

			local card = Acrylic.Panel({
				Name = "Notification",
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Radius = 14,
				ClipsDescendants = false,
				Strength = 0.65,
			})
			card.ZIndex = 501

			local accentBar = Create("Frame", {
				Name = "AccentBar",
				BackgroundColor3 = accent,
				BorderSizePixel = 0,
				Size = UDim2.new(0, 3, 1, -16),
				Position = UDim2.new(0, 0, 0.5, 0),
				AnchorPoint = Vector2.new(0, 0.5),
				ZIndex = card.ZIndex + 1,
				Parent = card,
			})
			Utility.Corner(2, accentBar)

			Utility.Padding({ Top = UDim.new(0, 14), Bottom = UDim.new(0, 14), Left = UDim.new(0, 16), Right = UDim.new(0, 14) }, card)

			local iconHolder = Create("Frame", {
				Name = "IconHolder",
				BackgroundColor3 = accent,
				BackgroundTransparency = 0.85,
				Size = UDim2.fromOffset(32, 32),
				ZIndex = card.ZIndex + 1,
				Parent = card,
			})
			Utility.Corner(10, iconHolder)
			local customIcon = Icons.Resolve(opts.Icon)
			local icon = Create("ImageLabel", {
				Image = customIcon or "",
				ImageColor3 = accent,
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(16, 16),
				Position = UDim2.fromScale(0.5, 0.5),
				AnchorPoint = Vector2.new(0.5, 0.5),
				ZIndex = card.ZIndex + 2,
				Parent = iconHolder,
			})
			if not customIcon then
				Icons.Apply(icon, style.Icon)
			end
			if opts.Type == "Loading" then
				Animator.Spin(icon, 1)
			end

			local textHolder = Create("Frame", {
				Name = "TextHolder",
				BackgroundTransparency = 1,
				Position = UDim2.fromOffset(46, 0),
				Size = UDim2.new(1, -46, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				ZIndex = card.ZIndex + 1,
				Parent = card,
			})
			Utility.ListLayout({ Padding = UDim.new(0, 2) }, textHolder)

			local title = Create("TextLabel", {
				Name = "Title",
				Text = opts.Title or "Notification",
				Font = Enum.Font.GothamMedium,
				TextSize = 14,
				TextColor3 = colors.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 18),
				ZIndex = card.ZIndex + 1,
				Parent = textHolder,
			})

			local message
			if opts.Message and opts.Message ~= "" then
				message = Create("TextLabel", {
					Name = "Message",
					Text = opts.Message,
					Font = Enum.Font.Gotham,
					TextSize = 13,
					TextColor3 = colors.SubText,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextWrapped = true,
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					ZIndex = card.ZIndex + 1,
					Parent = textHolder,
				})
			end

			local closeBtn = Create("ImageButton", {
				Name = "Close",
				ImageColor3 = colors.MutedText,
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(12, 12),
				Position = UDim2.new(1, 0, 0, 2),
				AnchorPoint = Vector2.new(1, 0),
				ZIndex = card.ZIndex + 2,
				Parent = card,
			})
			Icons.Apply(closeBtn, Icons.Close)

			-- Action buttons row
			if opts.Buttons and #opts.Buttons > 0 then
				local row = Create("Frame", {
					Name = "Actions",
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 26),
					Position = UDim2.new(0, 0, 0, 0),
					ZIndex = card.ZIndex + 1,
					Parent = textHolder,
				})
				Utility.ListLayout({ FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }, row)
				for _, btnDef in ipairs(opts.Buttons) do
					local btn = Create("TextButton", {
						Text = btnDef.Text or "Action",
						Font = Enum.Font.GothamMedium,
						TextSize = 12,
						TextColor3 = colors.Text,
						BackgroundColor3 = accent,
						BackgroundTransparency = 0.82,
						AutoButtonColor = false,
						Size = UDim2.fromOffset(0, 24),
						AutomaticSize = Enum.AutomaticSize.X,
						ZIndex = card.ZIndex + 1,
						Parent = row,
					})
					Utility.Corner(8, btn)
					Utility.Padding({ Left = UDim.new(0, 10), Right = UDim.new(0, 10) }, btn)
					btn.MouseButton1Click:Connect(function()
						if btnDef.Callback then task.spawn(btnDef.Callback) end
					end)
				end
			end

			-- countdown / progress bar
			local barTrack, barFill
			if opts.Type ~= "Loading" then
				barTrack = Create("Frame", {
					Name = "DurationTrack",
					BackgroundColor3 = accent,
					BackgroundTransparency = 0.85,
					Size = UDim2.new(1, 0, 0, 3),
					Position = UDim2.new(0, 0, 1, 6),
					ZIndex = card.ZIndex + 1,
					Parent = textHolder,
				})
				Utility.Corner(2, barTrack)
				barFill = Create("Frame", {
					Name = "DurationFill",
					BackgroundColor3 = accent,
					BorderSizePixel = 0,
					Size = UDim2.new(1, 0, 1, 0),
					ZIndex = card.ZIndex + 2,
					Parent = barTrack,
				})
				Utility.Corner(2, barFill)
			end

			return card, closeBtn, barFill
		end

		-- Displays a notification. Returns a handle for programmatic control.
		function Notifications.Notify(opts)
			opts = opts or {}
			if visibleCount >= Notifications.MaxVisible then
				table.insert(queue, opts)
				return
			end
			visibleCount += 1

			local corner = opts.Corner or Notifications.DefaultCorner
			local container = getContainer(corner)
			local duration = opts.Duration or Notifications.DefaultDuration
			local maid = Maid.new()

			local card, closeBtn, barFill = buildCard(opts)
			card.Parent = container

			local slideFrom = (corner:find("Right")) and UDim2.new(1.3, 0, 0, 0) or UDim2.new(-1.3, 0, 0, 0)
			card.Position = slideFrom

			local closed = false
			local function close()
				if closed then return end
				closed = true
				maid:Destroy()
				local outPos = (corner:find("Right")) and UDim2.new(1.3, 0, 0, 0) or UDim2.new(-1.3, 0, 0, 0)
				local tween = Animator.Close(card, { Position = outPos }, 0.28)
				tween.Completed:Once(function()
					card:Destroy()
					visibleCount = math.max(0, visibleCount - 1)
					if #queue > 0 then
						local nextOpts = table.remove(queue, 1)
						Notifications.Notify(nextOpts)
					end
				end)
			end

			Animator.Open(card, { Position = UDim2.new(0, 0, 0, 0) }, 0.4)

			if opts.Sound then playSound(opts.Sound) end

			maid:GiveTask(closeBtn.MouseButton1Click:Connect(close))

			local paused = false
			if barFill and duration and duration > 0 then
				local tween = Animator.Tween(barFill, { Size = UDim2.new(0, 0, 1, 0) }, duration, Animator.Easing.Sine, Enum.EasingDirection.Out)
				maid:GiveTask(tween.Completed:Once(function()
					if not paused then close() end
				end))
				maid:GiveTask(card.MouseEnter:Connect(function()
					paused = true
					tween:Pause()
				end))
				maid:GiveTask(card.MouseLeave:Connect(function()
					paused = false
					tween:Play()
				end))
			end

			local handle = {}
			function handle.Close() close() end
			function handle.SetProgress(percent)
				if barFill then
					Animator.Smooth(barFill, { Size = UDim2.new(Utility.Clamp(percent, 0, 100) / 100, 0, 1, 0) }, 0.2)
				end
			end
			function handle.SetTitle(text)
				local lbl = card:FindFirstChild("TextHolder") and card.TextHolder:FindFirstChild("Title")
				if lbl then lbl.Text = text end
			end
			function handle.SetMessage(text)
				local holder = card:FindFirstChild("TextHolder")
				local lbl = holder and holder:FindFirstChild("Message")
				if lbl then lbl.Text = text end
			end

			return handle
		end

		Notifications.Success = function(self, opts) opts = opts or self; opts.Type = "Success"; return Notifications.Notify(opts) end
		Notifications.Error   = function(self, opts) opts = opts or self; opts.Type = "Error"; return Notifications.Notify(opts) end
		Notifications.Warning = function(self, opts) opts = opts or self; opts.Type = "Warning"; return Notifications.Notify(opts) end
		Notifications.Info    = function(self, opts) opts = opts or self; opts.Type = "Info"; return Notifications.Notify(opts) end

		-- Promise-style flow: shows a Loading toast, then morphs it into
		-- Success/Error once `executor` resolves. `executor` can be a plain
		-- function (run via pcall in a new thread) or a Promise-like object
		-- exposing :andThen/:catch.
		function Notifications.Promise(executor, opts)
			opts = opts or {}
			local loadingOpts = opts.Loading or { Title = "Working...", Duration = 0 }
			loadingOpts.Type = "Loading"
			loadingOpts.Duration = 0
			local handle = Notifications.Notify(loadingOpts)

			local function onSuccess(result)
				if handle then handle.Close() end
				local successOpts = type(opts.Success) == "function" and opts.Success(result) or opts.Success
				successOpts = successOpts or { Title = "Success" }
				successOpts.Type = "Success"
				Notifications.Notify(successOpts)
			end

			local function onError(err)
				if handle then handle.Close() end
				local errorOpts = type(opts.Error) == "function" and opts.Error(err) or opts.Error
				errorOpts = errorOpts or { Title = "Error", Message = tostring(err) }
				errorOpts.Type = "Error"
				Notifications.Notify(errorOpts)
			end

			if type(executor) == "table" and executor.andThen then
				executor:andThen(onSuccess, onError)
			else
				task.spawn(function()
					local ok, result = pcall(executor)
					if ok then onSuccess(result) else onError(result) end
				end)
			end
		end

		return Notifications
	end)

	--============================================================================
	-- MODULE: ComponentRegistry
	-- Central registry component builder functions register themselves into.
	-- Section.CreateComponent(type, opts) dispatches through this, and every
	-- named convenience method (CreateToggle, CreateSlider, ...) is a thin
	-- wrapper generated from it — components never need Section to know about
	-- them ahead of time, keeping each component file fully self-contained.
	--============================================================================

	register("ComponentRegistry", function(import)

		local Registry = {}
		Registry.Builders = {}   -- typeName -> function(parent, opts, ctx, section)
		Registry.Methods = {}    -- methodName -> { Type = typeName, Preset = table? }

		-- Registers a component builder under `typeName`. `methodNames` is a
		-- string or array of strings (e.g. {"Toggle"} or {"Checkbox","Switch"})
		-- used to expose Section:CreateX() convenience wrappers, optionally with
		-- preset opts merged in (used for variants like Checkbox = Toggle style).
		function Registry.Register(typeName, builder, methodNames, preset)
			Registry.Builders[typeName] = builder
			methodNames = methodNames or { typeName }
			if type(methodNames) == "string" then methodNames = { methodNames } end
			for _, name in ipairs(methodNames) do
				Registry.Methods["Create" .. name] = { Type = typeName, Preset = preset }
			end
		end

		function Registry.Get(typeName)
			return Registry.Builders[typeName]
		end

		return Registry
	end)

	--============================================================================
	-- MODULE: Section
	-- Content grouping inside a Tab column. Supports normal / collapsible /
	-- bordered styles and is the surface every component attaches to via
	-- :CreateComponent (and its generated named wrappers, e.g. :CreateToggle).
	--============================================================================

	register("Section", function(import)

		local Utility = import("Utility")
		local Animator = import("Animator")
		local Theme = import("Theme")
		local Maid = import("Maid")
		local Registry = import("ComponentRegistry")
		local Icons = import("Icons")
		local Create = Utility.Create

		local Section = {}
		Section.__index = Section

		function Section.new(column, opts, ctx)
			opts = opts or {}
			local self = setmetatable({}, Section)
			self.Ctx = ctx
			self.Maid = Maid.new()
			self.Components = {}
			self.Collapsed = opts.StartCollapsed == true

			local colors = Theme.Get()

			self.Root = Create("Frame", {
				Name = "Section_" .. (opts.Name or "Section"),
				BackgroundColor3 = colors.Elevated,
				BackgroundTransparency = opts.Bordered and 1 or 0.15,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				ClipsDescendants = true,
				Parent = column,
			})
			Utility.Corner(14, self.Root)
			if opts.Bordered then
				Utility.Stroke({ Color = colors.Border, Transparency = colors.BorderAlpha, Thickness = 1 }, self.Root)
			end

			self.Header = Create("TextButton", {
				Name = "Header",
				Text = "",
				AutoButtonColor = false,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 38),
				Parent = self.Root,
			})

			self.TitleLabel = Create("TextLabel", {
				Name = "Title",
				Text = opts.Name or "Section",
				Font = Enum.Font.GothamBold,
				TextSize = 14,
				TextColor3 = colors.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 14, 0, 0),
				Size = UDim2.new(1, -44, 1, 0),
				Parent = self.Header,
			})

			self.Chevron = nil
			if opts.Collapsible then
				self.Chevron = Create("ImageLabel", {
					Name = "Chevron",
					ImageColor3 = colors.SubText,
					BackgroundTransparency = 1,
					Size = UDim2.fromOffset(12, 12),
					Position = UDim2.new(1, -16, 0.5, 0),
					AnchorPoint = Vector2.new(1, 0.5),
					Rotation = self.Collapsed and -90 or 0,
					Parent = self.Header,
				})
				Icons.Apply(self.Chevron, Icons.ChevronDown)
			end

			self.Body = Create("Frame", {
				Name = "Body",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Position = UDim2.new(0, 0, 0, 36),
				Visible = not self.Collapsed,
				Parent = self.Root,
			})
			Utility.Padding({ Left = UDim.new(0, 12), Right = UDim.new(0, 12), Bottom = UDim.new(0, 12) }, self.Body)
			Utility.ListLayout({ Padding = UDim.new(0, 8) }, self.Body)

			if not opts.Collapsible then
				-- static header, no chevron/body offset gap tweak needed
			end

			if opts.Collapsible then
				self.Header.MouseButton1Click:Connect(function()
					self:Toggle()
				end)
			end

			return self
		end

		function Section:Toggle()
			self.Collapsed = not self.Collapsed
			if self.Chevron then
				Animator.Smooth(self.Chevron, { Rotation = self.Collapsed and -90 or 0 }, 0.25)
			end
			if self.Collapsed then
				self.Body.Visible = false
			else
				self.Body.Visible = true
			end
		end

		-- Generic dispatcher: looks up the registered builder for `typeName`
		-- and mounts it inside this section's body.
		function Section:CreateComponent(typeName, opts)
			opts = opts or {}
			local Registry = import("ComponentRegistry")
			local builder = Registry.Get(typeName)
			assert(builder, "[Aura] No component registered for type: " .. tostring(typeName))
			local component = builder(self.Body, opts, self.Ctx, self)
			table.insert(self.Components, component)
			return component
		end

		function Section:SetVisible(visible)
			self.Root.Visible = visible
		end

		function Section:Destroy()
			self.Maid:Destroy()
			self.Root:Destroy()
		end

		-- Installs Create<Name>() convenience wrappers onto the Section
		-- metatable for every method registered so far in ComponentRegistry.
		-- Called once, lazily, right before the first Section is built (by
		-- which point every component module has been imported by Init).
		function Section._InstallMethods()
			local Registry = import("ComponentRegistry")
			for methodName, def in pairs(Registry.Methods) do
				if not Section[methodName] then
					Section[methodName] = function(self, opts)
						opts = opts or {}
						if def.Preset then
							local merged = {}
							for k, v in pairs(def.Preset) do merged[k] = v end
							for k, v in pairs(opts) do merged[k] = v end
							opts = merged
						end
						return self:CreateComponent(def.Type, opts)
					end
				end
			end
		end

		return Section
	end)

	--============================================================================
	-- MODULE: Tab
	-- A tab's scrollable content area, laid out as two auto-sizing columns
	-- (Left / Right) so sections use screen space efficiently — a dashboard
	-- feel rather than one long single-column list. Supports unlimited tabs;
	-- switching/animation is orchestrated by Window (sliding indicator + fade).
	--============================================================================

	register("Tab", function(import)

		local Utility = import("Utility")
		local Theme = import("Theme")
		local Maid = import("Maid")
		local SectionModule = import("Section")
		local Create = Utility.Create

		local Tab = {}
		Tab.__index = Tab

		function Tab.new(swapperParent, opts, ctx)
			opts = opts or {}
			local self = setmetatable({}, Tab)
			self.Name = opts.Name or "Tab"
			self.Icon = opts.Icon
			self.Badge = opts.Badge
			self.Ctx = ctx
			self.Maid = Maid.new()
			self.Sections = {}

			self.Content = Create("ScrollingFrame", {
				Name = "TabContent_" .. self.Name,
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				CanvasSize = UDim2.new(0, 0, 0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollBarThickness = 4,
				ScrollBarImageTransparency = 0.5,
				ScrollBarImageColor3 = Theme.Get().SubText,
				BorderSizePixel = 0,
				Visible = false,
				Parent = swapperParent,
			})
			Utility.Padding({ All = 16 }, self.Content)

			self.ColumnHolder = Create("Frame", {
				Name = "Columns",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Parent = self.Content,
			})
			Utility.ListLayout({
				FillDirection = Enum.FillDirection.Horizontal,
				Padding = UDim.new(0, 14),
			}, self.ColumnHolder)

			self.LeftColumn = Create("Frame", {
				Name = "Left",
				BackgroundTransparency = 1,
				Size = UDim2.new(0.5, -7, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Parent = self.ColumnHolder,
			})
			Utility.ListLayout({ Padding = UDim.new(0, 12) }, self.LeftColumn)

			self.RightColumn = Create("Frame", {
				Name = "Right",
				BackgroundTransparency = 1,
				Size = UDim2.new(0.5, -7, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Parent = self.ColumnHolder,
			})
			Utility.ListLayout({ Padding = UDim.new(0, 12) }, self.RightColumn)

			return self
		end

		-- CreateSection(name, opts) or CreateSection({ Name=..., Side=..., Collapsible=..., Bordered=... })
		function Tab:CreateSection(nameOrOpts, maybeOpts)
			local opts
			if type(nameOrOpts) == "string" then
				opts = maybeOpts or {}
				opts.Name = nameOrOpts
			else
				opts = nameOrOpts or {}
			end

			SectionModule._InstallMethods()

			local column = (opts.Side == "Right") and self.RightColumn or self.LeftColumn
			local section = SectionModule.new(column, opts, self.Ctx)
			table.insert(self.Sections, section)
			return section
		end

		function Tab:Show()
			self.Content.Visible = true
		end

		function Tab:Hide()
			self.Content.Visible = false
		end

		function Tab:Destroy()
			self.Maid:Destroy()
			self.Content:Destroy()
		end

		return Tab
	end)

	--============================================================================
	-- MODULE: Window
	-- The floating acrylic window: draggable + resizable titlebar chrome,
	-- animated collapsible sidebar with a sliding tab indicator, and a
	-- content swapper that fades/slides between tabs. Supports multiple
	-- independent windows per Library instance.
	--============================================================================

	register("Window", function(import)

		local Utility = import("Utility")
		local Animator = import("Animator")
		local Theme = import("Theme")
		local Icons = import("Icons")
		local Acrylic = import("Acrylic")
		local Draggable = import("Draggable")
		local Maid = import("Maid")
		local Signal = import("Signal")
		local TabModule = import("Tab")
		local Create = Utility.Create

		local Window = {}
		Window.__index = Window

		-- `icon` is one of the Icons.X sprite tables (see the Icons module) —
		-- real Lucide glyphs cropped from the WindUI-style icon sheet.
		local function iconButton(parent, icon, colors, size)
			size = size or 28
			local btn = Create("TextButton", {
				Text = "",
				BackgroundColor3 = colors.Text,
				BackgroundTransparency = 1,
				AutoButtonColor = false,
				Size = UDim2.fromOffset(size, size),
				Parent = parent,
			})
			Utility.Corner(8, btn)
			local iconSize = size >= 28 and 12 or 10
			local img = Create("ImageLabel", {
				ImageColor3 = colors.SubText,
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(iconSize, iconSize),
				Position = UDim2.fromScale(0.5, 0.5),
				AnchorPoint = Vector2.new(0.5, 0.5),
				Parent = btn,
			})
			Icons.Apply(img, icon)
			btn.MouseEnter:Connect(function()
				Animator.Smooth(btn, { BackgroundTransparency = 0.85 }, 0.15)
			end)
			btn.MouseLeave:Connect(function()
				Animator.Smooth(btn, { BackgroundTransparency = 1 }, 0.15)
			end)
			return btn, img
		end

		function Window.new(root, opts, ctx)
			opts = opts or {}
			local self = setmetatable({}, Window)
			self.Ctx = ctx
			self.Maid = Maid.new()
			self.Tabs = {}
			self.SidebarItems = {}
			self.ActiveTab = nil
			self.Minimized = false
			self.Maximized = false
			self.Visible = true

			self.Closed = Signal.new()
			self.TabChanged = Signal.new()

			local colors = Theme.Get()
			local size = opts.Size or UDim2.fromOffset(760, 500)
			self.MinSize = opts.MinSize or Vector2.new(560, 360)
			self.SidebarExpanded = true
			self.SidebarWidth = 190
			self.SidebarCollapsedWidth = 68

			self.Root = Create("Frame", {
				Name = "AuraWindow",
				Size = UDim2.fromOffset(size.X.Offset, size.Y.Offset),
				Position = opts.Position or UDim2.new(0.5, -size.X.Offset / 2, 0.5, -size.Y.Offset / 2),
				BackgroundColor3 = colors.Background,
				BorderSizePixel = 0,
				ClipsDescendants = true,
				Parent = root,
			})
			Acrylic.Apply(self.Root, { Strength = 0.7, Radius = 10 })
			Utility.Shadow({ Transparency = 0.45, Spread = 60 }, self.Root)

			-- opening animation
			self.Root.Size = UDim2.fromOffset(size.X.Offset * 0.92, size.Y.Offset * 0.92)
			local targetSize = UDim2.fromOffset(size.X.Offset, size.Y.Offset)
			self.WindowedSize = targetSize
			Animator.Open(self.Root, { Size = targetSize }, 0.45)

			-- ================= Titlebar =================
			self.Titlebar = Create("Frame", {
				Name = "Titlebar",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 46),
				Parent = self.Root,
			})
			Utility.Stroke({ Color = colors.Border, Transparency = 0.94, Thickness = 1 }, self.Titlebar)

			local titleIcon
			local iconValue = Icons.Resolve(opts.Icon)
			if iconValue then
				titleIcon = Create("ImageLabel", {
					Image = iconValue,
					BackgroundTransparency = 1,
					Size = UDim2.fromOffset(20, 20),
					Position = UDim2.new(0, 16, 0.5, 0),
					AnchorPoint = Vector2.new(0, 0.5),
					Parent = self.Titlebar,
				})
			end

			local titleTextX = iconValue and 46 or 16
			self.TitleLabel = Create("TextLabel", {
				Text = opts.Title or "Aura",
				Font = Enum.Font.GothamBold,
				TextSize = 15,
				TextColor3 = colors.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				BackgroundTransparency = 1,
				Position = UDim2.new(0, titleTextX, 0, opts.Subtitle and 6 or 0),
				Size = UDim2.new(1, -160, 0, 18),
				Parent = self.Titlebar,
			})

			if opts.Subtitle then
				Create("TextLabel", {
					Text = opts.Subtitle,
					Font = Enum.Font.Gotham,
					TextSize = 11,
					TextColor3 = colors.SubText,
					TextXAlignment = Enum.TextXAlignment.Left,
					BackgroundTransparency = 1,
					Position = UDim2.new(0, titleTextX, 0, 23),
					Size = UDim2.new(1, -160, 0, 14),
					Parent = self.Titlebar,
				})
			end

			local controls = Create("Frame", {
				Name = "Controls",
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(96, 30),
				Position = UDim2.new(1, -10, 0.5, 0),
				AnchorPoint = Vector2.new(1, 0.5),
				Parent = self.Titlebar,
			})
			Utility.ListLayout({ FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), HorizontalAlignment = Enum.HorizontalAlignment.Right }, controls)

			if opts.Minimizable ~= false then
				local minBtn = iconButton(controls, Icons.Minimize, colors)
				minBtn.MouseButton1Click:Connect(function() self:ToggleMinimize() end)
			end
			if opts.Maximizable ~= false then
				local maxBtn = iconButton(controls, Icons.Maximize, colors)
				maxBtn.MouseButton1Click:Connect(function() self:ToggleMaximize() end)
			end
			if opts.Closable ~= false then
				local closeBtn = iconButton(controls, Icons.Close, colors)
				closeBtn.MouseButton1Click:Connect(function() self:Close() end)
			end

			self.Maid:GiveTask(Draggable.Make(self.Root, self.Titlebar, { Bounds = true }))

			-- ================= Body (sidebar + content) =================
			self.Body = Create("Frame", {
				Name = "Body",
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 0, 0, 46),
				Size = UDim2.new(1, 0, 1, -46),
				Parent = self.Root,
			})

			-- No boxed background: Fluent/Windows-11-style sidebars float their
			-- nav items directly on the window's own acrylic surface instead of
			-- a separate panel, which avoids a large mostly-empty dark slab
			-- whenever there are only a few tabs.
			self.Sidebar = Create("Frame", {
				Name = "Sidebar",
				BackgroundTransparency = 1,
				Size = UDim2.new(0, self.SidebarWidth, 1, -20),
				Position = UDim2.new(0, 10, 0, 10),
				Parent = self.Body,
			})

			self.SidebarDivider = Create("Frame", {
				Name = "SidebarDivider",
				BackgroundColor3 = colors.Divider,
				BackgroundTransparency = 0.9,
				BorderSizePixel = 0,
				Size = UDim2.new(0, 1, 1, -8),
				Position = UDim2.new(1, 6, 0.5, 0),
				AnchorPoint = Vector2.new(0, 0.5),
				Parent = self.Sidebar,
			})

			self.TabList = Create("Frame", {
				Name = "TabList",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Position = UDim2.new(0, 0, 0, 4),
				Parent = self.Sidebar,
			})
			Utility.ListLayout({ Padding = UDim.new(0, 4) }, self.TabList)

			-- sliding active-tab indicator (pill behind the selected sidebar item)
			self.Indicator = Create("Frame", {
				Name = "Indicator",
				BackgroundColor3 = colors.Accent,
				BackgroundTransparency = 0.85,
				Size = UDim2.new(1, 0, 0, 34),
				ZIndex = 1,
				Visible = false,
				Parent = self.TabList,
			})
			Utility.Corner(9, self.Indicator)

			local collapseRow = Create("Frame", {
				Name = "CollapseRow",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 38),
				Position = UDim2.new(0, 0, 1, -38),
				Parent = self.Sidebar,
			})
			local collapseBtn, collapseIcon = iconButton(collapseRow, Icons.ChevronLeft, colors, 26)
			collapseBtn.Position = UDim2.new(1, -8, 0.5, 0)
			collapseBtn.AnchorPoint = Vector2.new(1, 0.5)
			collapseBtn.MouseButton1Click:Connect(function() self:ToggleSidebar() end)
			self._collapseIcon = collapseIcon

			self.ContentSwapper = Create("Frame", {
				Name = "ContentSwapper",
				BackgroundTransparency = 1,
				Position = UDim2.new(0, self.SidebarWidth + 16, 0, 0),
				Size = UDim2.new(1, -(self.SidebarWidth + 22), 1, -10),
				ClipsDescendants = true,
				Parent = self.Body,
			})

			if opts.Resizable ~= false then
				self.ResizeGrip = Create("Frame", {
					Name = "ResizeGrip",
					BackgroundTransparency = 1,
					Size = UDim2.fromOffset(18, 18),
					Position = UDim2.new(1, 0, 1, 0),
					AnchorPoint = Vector2.new(1, 1),
					Parent = self.Root,
				})
				self.Maid:GiveTask(Draggable.MakeResizable(self.Root, self.ResizeGrip, self.MinSize, opts.MaxSize or Vector2.new(1400, 980)))
			end

			self.Maid:GiveTask(Theme.Changed:Connect(function()
				self:_ApplyTheme()
			end))

			return self
		end

		function Window:_ApplyTheme()
			local colors = Theme.Get()
			Acrylic.Apply(self.Root, { Strength = 0.7 })
			self.TitleLabel.TextColor3 = colors.Text
			self.Sidebar.BackgroundColor3 = colors.ElevatedAlt
			self.Indicator.BackgroundColor3 = colors.Accent
			for _, item in ipairs(self.SidebarItems) do
				item.Label.TextColor3 = item.Active and colors.Text or colors.SubText
				if item.IconImg then
					item.IconImg.ImageColor3 = item.Active and colors.Accent or colors.SubText
				end
			end
		end

		function Window:CreateTab(opts)
			opts = opts or {}
			local tab = TabModule.new(self.ContentSwapper, opts, self.Ctx)
			table.insert(self.Tabs, tab)

			local colors = Theme.Get()
			local item = Create("TextButton", {
				Name = "SidebarItem_" .. tab.Name,
				Text = "",
				AutoButtonColor = false,
				BackgroundColor3 = colors.Accent,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 34),
				ZIndex = 2,
				Parent = self.TabList,
			})
			Utility.Corner(9, item)

			local iconImg
			local resolvedIcon = Icons.Resolve(tab.Icon)
			if resolvedIcon then
				iconImg = Create("ImageLabel", {
					Image = resolvedIcon,
					ImageColor3 = colors.SubText,
					BackgroundTransparency = 1,
					Size = UDim2.fromOffset(16, 16),
					Position = UDim2.new(0, 12, 0.5, 0),
					AnchorPoint = Vector2.new(0, 0.5),
					ZIndex = 3,
					Parent = item,
				})
			end

			local label = Create("TextLabel", {
				Text = tab.Name,
				Font = Enum.Font.GothamMedium,
				TextSize = 13,
				TextColor3 = colors.SubText,
				TextXAlignment = Enum.TextXAlignment.Left,
				BackgroundTransparency = 1,
				Position = UDim2.new(0, resolvedIcon and 38 or 14, 0, 0),
				Size = UDim2.new(1, -50, 1, 0),
				ZIndex = 3,
				Parent = item,
			})

			if tab.Badge then
				local badge = Create("TextLabel", {
					Text = tostring(tab.Badge),
					Font = Enum.Font.GothamBold,
					TextSize = 10,
					TextColor3 = colors.Background,
					BackgroundColor3 = colors.Accent,
					Size = UDim2.fromOffset(16, 16),
					Position = UDim2.new(1, -8, 0.5, 0),
					AnchorPoint = Vector2.new(1, 0.5),
					ZIndex = 3,
					Parent = item,
				})
				Utility.Corner(8, badge)
			end

			local entry = { Tab = tab, Item = item, Label = label, IconImg = iconImg, Active = false }
			table.insert(self.SidebarItems, entry)

			item.MouseEnter:Connect(function()
				if not entry.Active then
					Animator.Smooth(item, { BackgroundTransparency = 0.9 }, 0.15)
				end
			end)
			item.MouseLeave:Connect(function()
				if not entry.Active then
					Animator.Smooth(item, { BackgroundTransparency = 1 }, 0.15)
				end
			end)
			item.MouseButton1Click:Connect(function()
				self:SelectTab(tab)
			end)

			if not self.ActiveTab then
				self:SelectTab(tab)
			end

			return tab
		end

		function Window:SelectTab(tab)
			if self.ActiveTab == tab then return end
			local colors = Theme.Get()
			local previous = self.ActiveTab
			self.ActiveTab = tab

			for _, entry in ipairs(self.SidebarItems) do
				local active = entry.Tab == tab
				entry.Active = active
				Animator.Smooth(entry.Label, { TextColor3 = active and colors.Text or colors.SubText }, 0.15)
				if entry.IconImg then
					Animator.Smooth(entry.IconImg, { ImageColor3 = active and colors.Accent or colors.SubText }, 0.15)
				end
				if active then
					self.Indicator.Visible = true
					Animator.Snap(self.Indicator, { Position = UDim2.new(0, 0, 0, entry.Item.Position.Y.Offset) }, 0.28)
				end
			end

			if previous then
				local oldContent = previous.Content
				Animator.Tween(oldContent, { Position = UDim2.new(0, -14, 0, 0) }, 0.18, Animator.Easing.Sine, Enum.EasingDirection.In)
				task.delay(0.16, function()
					previous:Hide()
					oldContent.Position = UDim2.new(0, 0, 0, 0)
				end)
			end

			tab.Content.Position = UDim2.new(0, 14, 0, 0)
			tab:Show()
			Animator.Tween(tab.Content, { Position = UDim2.new(0, 0, 0, 0) }, 0.22, Animator.Easing.Quint, Enum.EasingDirection.Out)

			self.TabChanged:Fire(tab)
		end

		function Window:ToggleSidebar()
			self.SidebarExpanded = not self.SidebarExpanded
			local width = self.SidebarExpanded and self.SidebarWidth or self.SidebarCollapsedWidth
			Animator.Smooth(self.Sidebar, { Size = UDim2.new(0, width, 1, -20) }, 0.28)
			Animator.Smooth(self.ContentSwapper, {
				Position = UDim2.new(0, width + 16, 0, 0),
				Size = UDim2.new(1, -(width + 22), 1, -10),
			}, 0.28)
			Animator.Smooth(self._collapseIcon, { Rotation = self.SidebarExpanded and 0 or 180 }, 0.28)
			for _, entry in ipairs(self.SidebarItems) do
				Animator.Smooth(entry.Label, { TextTransparency = self.SidebarExpanded and 0 or 1 }, 0.18)
			end
		end

		function Window:ToggleMinimize()
			self.Minimized = not self.Minimized
			if self.Minimized then
				self._preMinimizeSize = self.Root.Size
				Animator.Smooth(self.Root, { Size = UDim2.new(0, self.Root.Size.X.Offset, 0, 46) }, 0.3)
				self.Body.Visible = false
			else
				self.Body.Visible = true
				Animator.Smooth(self.Root, { Size = self._preMinimizeSize or self.WindowedSize }, 0.3)
			end
		end

		function Window:ToggleMaximize()
			self.Maximized = not self.Maximized
			if self.Maximized then
				self._preMaxSize = self.Root.Size
				self._preMaxPos = self.Root.Position
				local viewport = self.Root.Parent.AbsoluteSize
				Animator.Open(self.Root, { Size = UDim2.fromOffset(viewport.X - 24, viewport.Y - 24), Position = UDim2.fromOffset(12, 12) }, 0.3)
			else
				Animator.Open(self.Root, { Size = self._preMaxSize or self.WindowedSize, Position = self._preMaxPos }, 0.3)
			end
		end

		function Window:Show()
			self.Visible = true
			self.Root.Visible = true
			self.Root.Size = UDim2.fromOffset(self.WindowedSize.X.Offset * 0.94, self.WindowedSize.Y.Offset * 0.94)
			Animator.Open(self.Root, { Size = self.WindowedSize }, 0.35)
		end

		function Window:Hide()
			self.Visible = false
			local tween = Animator.Close(self.Root, { Size = UDim2.fromOffset(self.Root.Size.X.Offset * 0.94, self.Root.Size.Y.Offset * 0.94) }, 0.2)
			tween.Completed:Once(function()
				if not self.Visible then self.Root.Visible = false end
			end)
		end

		function Window:Toggle()
			if self.Visible then self:Hide() else self:Show() end
		end

		function Window:Close()
			local tween = Animator.Close(self.Root, {
				Size = UDim2.fromOffset(self.Root.Size.X.Offset * 0.9, self.Root.Size.Y.Offset * 0.9),
			}, 0.25)
			Animator.Tween(self.Root, { BackgroundTransparency = 1 }, 0.2)
			tween.Completed:Once(function()
				self.Closed:Fire()
				self:Destroy()
			end)
		end

		function Window:Destroy()
			self.Maid:Destroy()
			for _, tab in ipairs(self.Tabs) do
				tab:Destroy()
			end
			self.Root:Destroy()
		end

		return Window
	end)

	--============================================================================
	-- MODULE: ComponentBase
	-- Shared scaffolding every component builder is built on top of: the
	-- "card" container (title + optional description + hover highlight),
	-- ripple wiring, tooltip attachment, and disabled-state handling. Keeping
	-- this in one place is what keeps every component file short and DRY.
	--============================================================================

	register("ComponentBase", function(import)

		local Utility = import("Utility")
		local Animator = import("Animator")
		local Theme = import("Theme")
		local Create = Utility.Create

		local Base = {}

		-- Builds the shared card scaffold.
		-- opts.Inline = true   -> title(+desc) on the left, small control on the right (Toggle/Checkbox/Keybind row)
		-- opts.Inline = false  -> title(+desc) on top, full-width Body below for the control (Slider/Dropdown/Textbox/...)
		function Base.Card(parent, opts, cardOpts)
			cardOpts = cardOpts or {}
			local colors = Theme.Get()

			local root = Create("Frame", {
				Name = (opts.Flag or opts.Title or "Component") .. "_Card",
				BackgroundColor3 = colors.ElevatedAlt,
				BackgroundTransparency = 0.25,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Visible = opts.Visible ~= false,
				Parent = parent,
			})
			Utility.Corner(12, root)
			Utility.Padding({ All = 12 }, root)
			Utility.ListLayout({ Padding = UDim.new(0, 8) }, root)

			local headerRow = Create("Frame", {
				Name = "Header",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y,
				Parent = root,
			})

			local controlHolder
			local titleWidth = 1
			if cardOpts.Inline then
				controlHolder = Create("Frame", {
					Name = "Control",
					BackgroundTransparency = 1,
					Size = cardOpts.ControlSize or UDim2.fromOffset(44, 24),
					Position = UDim2.new(1, 0, 0, 0),
					AnchorPoint = Vector2.new(1, 0),
					Parent = headerRow,
				})
			end

			local reservedRight = 0
			if cardOpts.Inline then
				reservedRight = (cardOpts.ControlSize and cardOpts.ControlSize.X.Offset or 44) + 10
			elseif cardOpts.ValueLabel then
				reservedRight = 74
			end

			local title = Create("TextLabel", {
				Name = "Title",
				Text = opts.Title or opts.Name or "",
				Font = Enum.Font.GothamMedium,
				TextSize = 13.5,
				TextColor3 = colors.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextYAlignment = Enum.TextYAlignment.Center,
				BackgroundTransparency = 1,
				Size = cardOpts.Inline and UDim2.new(1, -reservedRight, 0, 22) or UDim2.new(1, -reservedRight, 0, 18),
				Parent = headerRow,
			})

			local valueLabel
			if cardOpts.ValueLabel then
				valueLabel = Create("TextLabel", {
					Name = "Value",
					Text = "",
					Font = Enum.Font.GothamBold,
					TextSize = 13,
					TextColor3 = colors.Accent,
					TextXAlignment = Enum.TextXAlignment.Right,
					BackgroundTransparency = 1,
					Size = UDim2.new(0, 70, 0, 18),
					Position = UDim2.new(1, 0, 0, 0),
					AnchorPoint = Vector2.new(1, 0),
					Parent = headerRow,
				})
			end

			local desc
			if opts.Description and opts.Description ~= "" then
				desc = Create("TextLabel", {
					Name = "Description",
					Text = opts.Description,
					Font = Enum.Font.Gotham,
					TextSize = 12,
					TextColor3 = colors.SubText,
					TextXAlignment = Enum.TextXAlignment.Left,
					TextWrapped = true,
					BackgroundTransparency = 1,
					Size = UDim2.new(1, cardOpts.Inline and -54 or 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					Position = UDim2.new(0, 0, 0, 20),
					Parent = headerRow,
				})
			end

			local body
			if not cardOpts.Inline then
				body = Create("Frame", {
					Name = "Body",
					BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					Parent = root,
				})
			end

			if cardOpts.Hoverable ~= false then
				root.MouseEnter:Connect(function()
					Animator.Smooth(root, { BackgroundTransparency = 0.08 }, 0.18)
				end)
				root.MouseLeave:Connect(function()
					Animator.Smooth(root, { BackgroundTransparency = 0.25 }, 0.18)
				end)
			end

			return {
				Root = root,
				Header = headerRow,
				Title = title,
				Desc = desc,
				Value = valueLabel,
				Control = controlHolder,
				Body = body,
				Colors = colors,
			}
		end

		-- Spawns an Animator.Ripple at the click position local to `instance`.
		function Base.WireRipple(instance, colorGetter)
			instance.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					local absPos = instance.AbsolutePosition
					local mouse = input.Position
					local color = colorGetter and colorGetter() or Color3.fromRGB(255, 255, 255)
					Animator.Ripple(instance, mouse.X - absPos.X, mouse.Y - absPos.Y, color)
				end
			end)
		end

		-- Attaches a floating tooltip to `instance`, shown after a short hover delay.
		function Base.AttachTooltip(instance, text, guiParent)
			if not text or text == "" then return end
			local colors = Theme.Get()
			local tooltip
			local hovering = false

			instance.MouseEnter:Connect(function()
				hovering = true
				task.delay(0.35, function()
					if not hovering then return end
					tooltip = Create("TextLabel", {
						Name = "Tooltip",
						Text = text,
						Font = Enum.Font.Gotham,
						TextSize = 12,
						TextColor3 = colors.Text,
						BackgroundColor3 = colors.ElevatedAlt,
						BackgroundTransparency = 0.05,
						AutomaticSize = Enum.AutomaticSize.X,
						Size = UDim2.new(0, 0, 0, 26),
						Position = UDim2.new(0, instance.AbsolutePosition.X + instance.AbsoluteSize.X / 2, 0, instance.AbsolutePosition.Y - 30),
						ZIndex = 1000,
						TextTransparency = 1,
						BackgroundTransparency = 1,
						Parent = guiParent or instance.Parent,
					})
					Utility.Corner(6, tooltip)
					Utility.Padding({ Left = UDim.new(0, 8), Right = UDim.new(0, 8) }, tooltip)
					Utility.Stroke({ Color = colors.Border, Transparency = colors.BorderAlpha }, tooltip)
					Animator.Smooth(tooltip, { TextTransparency = 0, BackgroundTransparency = 0.05 }, 0.15)
				end)
			end)

			instance.MouseLeave:Connect(function()
				hovering = false
				if tooltip then
					local t = tooltip
					tooltip = nil
					Animator.Smooth(t, { TextTransparency = 1, BackgroundTransparency = 1 }, 0.12).Completed:Once(function()
						t:Destroy()
					end)
				end
			end)
		end

		-- Returns a UDim2 offset placing item `index` of `count` evenly around a
		-- circle of `radius` pixels, used by Spinner / CircularProgress / RadialMenu.
		function Base.PlaceRadial(index, count, radius)
			local angle = (index - 1) / count * math.pi * 2 - math.pi / 2
			return UDim2.new(0.5, math.cos(angle) * radius, 0.5, math.sin(angle) * radius), math.deg(angle) + 90
		end

		function Base.SetInteractable(guiObject, enabled)
			guiObject.Active = enabled
			if guiObject:IsA("GuiButton") then
				guiObject.AutoButtonColor = false
			end
		end

		return Base
	end)

