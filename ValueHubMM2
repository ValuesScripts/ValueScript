					Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -22, 1, 0), Parent = row,
				})
				row.MouseEnter:Connect(function() Animator.Smooth(row, { BackgroundTransparency = 0.1 }, 0.12) end)
				row.MouseLeave:Connect(function() Animator.Smooth(row, { BackgroundTransparency = selectedRow == row and 0.1 or 0.3 }, 0.12) end)
				row.MouseButton1Click:Connect(function()
					if opts.Selectable then
						if selectedRow then Animator.Smooth(selectedRow, { BackgroundTransparency = 0.3 }, 0.12) end
						selectedRow = row
					end
					if opts.OnSelect then task.spawn(opts.OnSelect, item) end
				end)
			end

			local api = { Instance = holder }
			function api.Destroy() holder:Destroy() end
			return api
		end
		Registry.Register("List", buildList, { "List" })

		-- ---------- Tree View ----------
		local function renderTreeNode(container, node, depth, colors)
			local row = Create("TextButton", {
				Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 28), Parent = container,
			})
			Utility.Corner(6, row)
			local hasChildren = node.Children and #node.Children > 0
			local chevron
			if hasChildren then
				chevron = Create("ImageLabel", {
					ImageColor3 = colors.SubText, BackgroundTransparency = 1,
					Size = UDim2.fromOffset(10, 10), Position = UDim2.new(0, depth * 16, 0.5, 0),
					AnchorPoint = Vector2.new(0, 0.5), Rotation = node.Expanded and 90 or 0, Parent = row,
				})
				Icons.Apply(chevron, Icons.ChevronRight)
			end
			Create("TextLabel", {
				Text = node.Text or node.Name or "", Font = Enum.Font.Gotham, TextSize = 12.5, TextColor3 = colors.Text,
				TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
				Position = UDim2.new(0, depth * 16 + 16, 0, 0), Size = UDim2.new(1, -(depth * 16 + 16), 1, 0),
				Parent = row,
			})
			row.MouseEnter:Connect(function() Animator.Smooth(row, { BackgroundTransparency = 0.9 }, 0.1) end)
			row.MouseLeave:Connect(function() Animator.Smooth(row, { BackgroundTransparency = 1 }, 0.1) end)

			local childHolder
			if hasChildren then
				childHolder = Create("Frame", {
					BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y, Visible = node.Expanded == true,
					Parent = container,
				})
				Utility.ListLayout({ Padding = UDim.new(0, 2) }, childHolder)
				for _, child in ipairs(node.Children) do
					renderTreeNode(childHolder, child, depth + 1, colors)
				end

				row.MouseButton1Click:Connect(function()
					node.Expanded = not node.Expanded
					childHolder.Visible = node.Expanded
					Animator.Smooth(chevron, { Rotation = node.Expanded and 90 or 0 }, 0.15)
				end)
			elseif node.Callback then
				row.MouseButton1Click:Connect(function() task.spawn(node.Callback) end)
			end
		end

		local function buildTreeView(parent, opts, ctx)
			local colors = Theme.Get()
			local holder = Create("Frame", {
				BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
				AutomaticSize = Enum.AutomaticSize.Y, Parent = parent,
			})
			Utility.ListLayout({ Padding = UDim.new(0, 1) }, holder)
			for _, node in ipairs(opts.Nodes or {}) do
				renderTreeNode(holder, node, 0, colors)
			end
			local api = { Instance = holder }
			function api.Destroy() holder:Destroy() end
			return api
		end
		Registry.Register("TreeView", buildTreeView, { "TreeView" })

