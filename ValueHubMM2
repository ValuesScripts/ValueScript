			local row = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 20), Parent = parent })
			local icon = Create("TextLabel", {
				Text = "ⓘ", Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = colors.MutedText,
				BackgroundTransparency = 1, Size = UDim2.fromOffset(16, 20), Parent = row,
