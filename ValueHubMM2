			})
			Utility.Corner(13, chip)
			Utility.Stroke({ Color = color, Thickness = 1, Transparency = selected and 0.4 or 0.75 }, chip)
			Utility.Padding({ Left = UDim.new(0, 12), Right = UDim.new(0, 12) }, chip)
			local label = Create("TextLabel", {
				Text = opts.Text or "Chip",
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextColor3 = selected and color or colors.SubText,
				BackgroundTransparency = 1,
				Size = UDim2.new(0, 0, 1, 0),
				AutomaticSize = Enum.AutomaticSize.X,
				Parent = chip,
			})

			local api = {}
			api.Changed = import("Signal").new()
			api.Instance = chip

			local function apply(v)
				selected = v
				local stroke = chip:FindFirstChildOfClass("UIStroke")
				Animator.Smooth(chip, { BackgroundTransparency = v and 0.82 or 0.92 }, 0.15)
				if stroke then Animator.Smooth(stroke, { Transparency = v and 0.4 or 0.75 }, 0.15) end
				Animator.Smooth(label, { TextColor3 = v and color or colors.SubText }, 0.15)
			end

			chip.MouseButton1Click:Connect(function()
				selected = not selected
				apply(selected)
				if opts.Callback then task.spawn(opts.Callback, selected) end
				api.Changed:Fire(selected)
			end)

			function api.Set(v) apply(v) end
			function api.Get() return selected end
			function api.Destroy() chip:Destroy() end
			return api
		end
		Registry.Register("Chip", buildChip, { "Chip" })

		-- ---------- Status / Online Indicator ----------
		local function buildStatusIndicator(parent, opts, ctx)
			local colors = Theme.Get()
			local statusColors = { Online = colors.Success, Away = colors.Warning, Offline = colors.MutedText, Busy = colors.Error }
			local status = opts.Default or (opts.Online and "Online" or "Offline") or "Offline"

			local row = Create("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(0, 20),
				AutomaticSize = Enum.AutomaticSize.X,
				Parent = parent,
			})
			Utility.ListLayout({ FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 6) }, row)

			local dot = Create("Frame", {
				BackgroundColor3 = statusColors[status] or colors.MutedText,
				Size = UDim2.fromOffset(8, 8),
				Parent = row,
			})
			Utility.Corner(4, dot)
			local breathing = Animator.Breathe(dot, "BackgroundTransparency", 0, 0.5, 1.4)

			local label = Create("TextLabel", {
				Text = opts.Text or status,
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextColor3 = colors.SubText,
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(0, 16),
				AutomaticSize = Enum.AutomaticSize.X,
				Parent = row,
			})

			local api = { Instance = row }
			function api.Set(newStatus, text)
				status = newStatus
				Animator.Smooth(dot, { BackgroundColor3 = statusColors[status] or colors.MutedText }, 0.15)
				label.Text = text or status
			end
			function api.Destroy() breathing.Stop(); row:Destroy() end
			return api
		end
		Registry.Register("StatusIndicator", buildStatusIndicator, { "StatusIndicator" })
		Registry.Register("StatusIndicator", buildStatusIndicator, { "OnlineIndicator" })

		return true
	end)

	--============================================================================
	-- MODULE: Overlays
	-- Global (non-section) surfaces: Modal, ConfirmDialog, Popup, ContextMenu,
	-- CommandPalette. These float above the whole UI rather than living inside
	-- a Tab/Section, so they're exposed as Library-level methods by Init.
	--============================================================================

	register("Overlays", function(import)

		local Utility = import("Utility")
		local Animator = import("Animator")
		local Theme = import("Theme")
		local Acrylic = import("Acrylic")
		local Icons = import("Icons")
		local Create = Utility.Create

		local Overlays = {}

		-- ---------- Modal ----------
		function Overlays.Modal(root, opts)
			opts = opts or {}
			local colors = Theme.Get()
			local overlay = Acrylic.Overlay(root, 0.55)
			overlay.ZIndex = 800

			local panel = Acrylic.Panel({
				Name = "Modal",
				Size = opts.Size or UDim2.fromOffset(400, 220),
				Radius = 16,
				Strength = 0.75,
			})
			panel.Position = UDim2.fromScale(0.5, 0.5)
			panel.AnchorPoint = Vector2.new(0.5, 0.5)
			panel.ZIndex = 801
			panel.Parent = overlay

			local titleBar = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 40), Parent = panel })
			Create("TextLabel", {
				Text = opts.Title or "Modal",
				Font = Enum.Font.GothamBold, TextSize = 15, TextColor3 = colors.Text,
				TextXAlignment = Enum.TextXAlignment.Left,
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 16, 0, 0), Size = UDim2.new(1, -50, 1, 0),
				Parent = titleBar,
			})

			local function close()
				local t = Animator.Close(panel, { Size = UDim2.new(panel.Size.X.Scale, panel.Size.X.Offset * 0.94, panel.Size.Y.Scale, panel.Size.Y.Offset * 0.94) }, 0.18)
				Animator.Tween(overlay, { BackgroundTransparency = 1 }, 0.18)
				t.Completed:Once(function() overlay:Destroy() end)
			end

			if opts.Closable ~= false then
				local closeBtn = Create("ImageButton", {
					ImageColor3 = colors.SubText, BackgroundTransparency = 1,
					Size = UDim2.fromOffset(14, 14), Position = UDim2.new(1, -16, 0, 14),
					AnchorPoint = Vector2.new(1, 0), Parent = panel,
				})
				Icons.Apply(closeBtn, Icons.Close)
				closeBtn.MouseButton1Click:Connect(close)
			end

			local body = Create("Frame", {
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 16, 0, 44),
				Size = UDim2.new(1, -32, 1, -(opts.Buttons and 100 or 60)),
				Parent = panel,
			})
			if opts.Message then
				Create("TextLabel", {
					Text = opts.Message, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = colors.SubText,
					TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
					BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = body,
				})
			end
			if opts.Build then opts.Build(body) end

			if opts.Buttons then
				local btnRow = Create("Frame", {
					BackgroundTransparency = 1,
					Position = UDim2.new(0, 16, 1, -52),
					Size = UDim2.new(1, -32, 0, 36),
					Parent = panel,
				})
				Utility.ListLayout({ FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 8) }, btnRow)
				for _, def in ipairs(opts.Buttons) do
					local isDanger = def.Style == "Danger"
					local isPrimary = def.Style == "Primary" or (not isDanger and def.Style ~= "Secondary")
					local btnColor = isDanger and colors.Error or colors.Accent
					local btn = Create("TextButton", {
						Text = def.Text or "OK",
						Font = Enum.Font.GothamMedium, TextSize = 13,
						TextColor3 = (isPrimary or isDanger) and Color3.new(1, 1, 1) or colors.Text,
						BackgroundColor3 = btnColor,
						BackgroundTransparency = (isPrimary or isDanger) and 0.05 or 0.85,
						AutoButtonColor = false,
						Size = UDim2.fromOffset(0, 36), AutomaticSize = Enum.AutomaticSize.X,
						Parent = btnRow,
					})
					Utility.Corner(9, btn)
					Utility.Padding({ Left = UDim.new(0, 16), Right = UDim.new(0, 16) }, btn)
					btn.MouseButton1Click:Connect(function()
						if def.Callback then task.spawn(def.Callback) end
						close()
					end)
				end
			end

			panel.Size = UDim2.new(panel.Size.X.Scale, panel.Size.X.Offset * 0.92, panel.Size.Y.Scale, panel.Size.Y.Offset * 0.92)
			Animator.Open(panel, { Size = opts.Size or UDim2.fromOffset(400, 220) }, 0.3)

			return { Close = close, Instance = panel }
		end

		-- ---------- Confirmation Dialog ----------
		function Overlays.Confirm(root, opts)
			opts = opts or {}
			return Overlays.Modal(root, {
				Title = opts.Title or "Are you sure?",
				Message = opts.Message,
				Size = opts.Size or UDim2.fromOffset(380, 180),
				Buttons = {
					{ Text = opts.CancelText or "Cancel", Style = "Secondary", Callback = opts.OnCancel },
					{ Text = opts.ConfirmText or "Confirm", Style = opts.Danger and "Danger" or "Primary", Callback = opts.OnConfirm },
				},
			})
		end

		-- ---------- Popup (lightweight, optionally auto-dismiss) ----------
		function Overlays.Popup(root, opts)
			opts = opts or {}
			local colors = Theme.Get()
			local panel = Acrylic.Panel({
				Name = "Popup", Size = opts.Size or UDim2.fromOffset(280, 100), Radius = 14, Strength = 0.75,
			})
			panel.Position = UDim2.fromScale(0.5, 0.12)
			panel.AnchorPoint = Vector2.new(0.5, 0)
			panel.ZIndex = 850
			panel.Parent = root
			Utility.Padding({ All = 14 }, panel)

			if opts.Title then
				Create("TextLabel", {
					Text = opts.Title, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = colors.Text,
					TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
					Size = UDim2.new(1, 0, 0, 18), Parent = panel,
				})
			end
			if opts.Message then
				Create("TextLabel", {
					Text = opts.Message, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = colors.SubText,
					TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left,
					Position = UDim2.new(0, 0, 0, opts.Title and 22 or 0),
					Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
					Parent = panel,
				})
			end

			panel.Position = UDim2.fromScale(0.5, 0.05)
			Animator.Open(panel, { Position = UDim2.fromScale(0.5, 0.12) }, 0.35)

			local function close()
				local t = Animator.Close(panel, { Position = UDim2.fromScale(0.5, 0.05) }, 0.2)
				Animator.Tween(panel, { BackgroundTransparency = 1 }, 0.2)
				t.Completed:Once(function() panel:Destroy() end)
			end
			if opts.Duration then task.delay(opts.Duration, close) end

			return { Close = close, Instance = panel }
		end

		-- ---------- Context Menu ----------
		function Overlays.ContextMenu(root, x, y, items)
			local colors = Theme.Get()
			local catcher = Create("TextButton", {
				Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1), ZIndex = 899, Parent = root,
			})
			local menu = Create("Frame", {
				BackgroundColor3 = colors.ElevatedAlt, BackgroundTransparency = 0.05,
				Size = UDim2.fromOffset(180, 0), AutomaticSize = Enum.AutomaticSize.Y,
				Position = UDim2.fromOffset(x, y), ZIndex = 900, Parent = root,
			})
			Utility.Corner(10, menu)
			Utility.Stroke({ Color = colors.Border, Transparency = colors.BorderAlpha }, menu)
			Utility.Shadow({ Transparency = 0.5, Spread = 24 }, menu)
			Utility.Padding({ All = 6 }, menu)
			Utility.ListLayout({ Padding = UDim.new(0, 2) }, menu)

			local function close()
				catcher:Destroy()
				local t = Animator.Close(menu, { Size = UDim2.new(0, menu.AbsoluteSize.X, 0, 0) }, 0.14)
				t.Completed:Once(function() menu:Destroy() end)
			end
			catcher.MouseButton1Click:Connect(close)

			for _, item in ipairs(items) do
				if item.Divider then
					Create("Frame", { BackgroundColor3 = colors.Divider, BackgroundTransparency = 0.85, Size = UDim2.new(1, 0, 0, 1), Parent = menu })
				else
					local row = Create("TextButton", {
						Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
						Size = UDim2.new(1, 0, 0, 30), Parent = menu,
					})
					Utility.Corner(7, row)
					Create("TextLabel", {
						Text = item.Text, Font = Enum.Font.Gotham, TextSize = 12.5, TextColor3 = colors.Text,
						TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
						Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -20, 1, 0),
						Parent = row,
					})
					row.MouseEnter:Connect(function() Animator.Smooth(row, { BackgroundTransparency = 0.85 }, 0.1) end)
					row.MouseLeave:Connect(function() Animator.Smooth(row, { BackgroundTransparency = 1 }, 0.1) end)
					row.MouseButton1Click:Connect(function()
						close()
						if item.Callback then task.spawn(item.Callback) end
					end)
				end
			end
			return { Close = close, Instance = menu }
		end

		function Overlays.AttachContextMenu(root, target, items)
			target.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton2 then
					local pos = input.Position
					Overlays.ContextMenu(root, pos.X, pos.Y, type(items) == "function" and items() or items)
				end
			end)
		end

		-- ---------- Command Palette ----------
		function Overlays.CommandPalette(root, opts, ctx)
			opts = opts or {}
			local colors = Theme.Get()
			local commands = opts.Commands or {}

			local overlay = Acrylic.Overlay(root, 0.5)
			overlay.ZIndex = 870

			local panel = Acrylic.Panel({ Size = UDim2.fromOffset(460, 360), Radius = 14, Strength = 0.8 })
			panel.Position = UDim2.fromScale(0.5, 0.16)
			panel.AnchorPoint = Vector2.new(0.5, 0)
			panel.ZIndex = 871
			panel.Parent = overlay
			Utility.Padding({ All = 12 }, panel)

			local searchField = Create("Frame", { BackgroundColor3 = colors.Elevated, Size = UDim2.new(1, 0, 0, 38), Parent = panel })
			Utility.Corner(9, searchField)
			local searchBox = Create("TextBox", {
				Text = "", PlaceholderText = "Type a command...", PlaceholderColor3 = colors.MutedText,
				Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = colors.Text, TextXAlignment = Enum.TextXAlignment.Left,
				BackgroundTransparency = 1, Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -24, 1, 0),
				Parent = searchField,
			})

			local list = Create("ScrollingFrame", {
				BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 46), Size = UDim2.new(1, 0, 1, -46),
				CanvasSize = UDim2.new(0, 0, 0, 0), AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollBarThickness = 3, Parent = panel,
			})
			Utility.ListLayout({ Padding = UDim.new(0, 2) }, list)

			local function close()
				local t = Animator.Close(panel, { Position = UDim2.fromScale(0.5, 0.1) }, 0.18)
				Animator.Tween(overlay, { BackgroundTransparency = 1 }, 0.18)
				t.Completed:Once(function() overlay:Destroy() end)
			end

			local catcherClose = Create("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 869, Parent = overlay })
			catcherClose.MouseButton1Click:Connect(close)
			panel.Active = true

			local function render(query)
				for _, c in ipairs(list:GetChildren()) do
					if c:IsA("TextButton") then c:Destroy() end
				end
				query = query:lower()
				for _, cmd in ipairs(commands) do
					if query == "" or cmd.Text:lower():find(query, 1, true) then
						local row = Create("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34), Parent = list })
						Utility.Corner(8, row)
						Create("TextLabel", {
							Text = cmd.Text, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = colors.Text,
							TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1,
							Position = UDim2.new(0, 10, 0, 0), Size = UDim2.new(1, -20, 1, 0), Parent = row,
						})
						row.MouseEnter:Connect(function() Animator.Smooth(row, { BackgroundTransparency = 0.9 }, 0.1) end)
						row.MouseLeave:Connect(function() Animator.Smooth(row, { BackgroundTransparency = 1 }, 0.1) end)
						row.MouseButton1Click:Connect(function()
							close()
							if cmd.Callback then task.spawn(cmd.Callback) end
						end)
					end
				end
			end
			render("")
			searchBox:GetPropertyChangedSignal("Text"):Connect(function() render(searchBox.Text) end)

			panel.Position = UDim2.fromScale(0.5, 0.1)
			Animator.Open(panel, { Position = UDim2.fromScale(0.5, 0.16) }, 0.3)

			task.defer(function() searchBox:CaptureFocus() end)

			return { Close = close, Instance = panel }
		end

		return Overlays
	end)

