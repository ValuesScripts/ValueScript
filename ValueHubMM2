				Utility.ListLayout({ Padding = UDim.new(0, 2) }, list)

				for _, option in ipairs(options) do
					buildOptionRow(list, option)
				end

				if searchBox then
					searchBox:GetPropertyChangedSignal("Text"):Connect(function()
						local query = searchBox.Text:lower()
						for _, child in ipairs(list:GetChildren()) do
							if child:IsA("TextButton") then
								child.Visible = query == "" or child:FindFirstChildOfClass("TextLabel").Text:lower():find(query, 1, true) ~= nil
							end
						end
					end)
				end

				local contentHeight = math.min(maxHeight, #options * 34 + listTop + 10)
				Animator.Open(popup, { Size = UDim2.fromOffset(field.AbsoluteSize.X, contentHeight) }, 0.22)

				renderConn = RunService.RenderStepped:Connect(function()
					if not field.Parent then closePopup(); return end
					popup.Position = UDim2.fromOffset(field.AbsolutePosition.X, field.AbsolutePosition.Y + field.AbsoluteSize.Y + 6)
					catcher.Size = UDim2.fromScale(1, 1)
				end)
			end

			field.MouseButton1Click:Connect(function()
				if popupOpen then closePopup() else openPopup() end
			end)

			function api.Set(value, silent)
				if multi then
					selectedSet = {}
					for _, v in ipairs(value or {}) do selectedSet[v] = true end
				else
					selectedSingle = value
				end
				refreshLabel()
				if not silent then fireSelection() end
			end
			function api.Get()
				if multi then
					local list = {}
					for k, v in pairs(selectedSet) do if v then table.insert(list, k) end end
					return list
				end
				return selectedSingle
			end
			function api.Refresh(newOptions)
				options = newOptions
			end
			function api.Destroy()
				closePopup()
				card.Root:Destroy()
			end

			if opts.Flag then
				Config.Register(opts.Flag, api.Get(), function(v) api.Set(v, true) end)
			end

			return api
		end

		Registry.Register("Dropdown", build, { "Dropdown" })
		Registry.Register("Dropdown", build, { "MultiDropdown" }, { Multi = true })
		Registry.Register("Dropdown", build, { "SearchableDropdown" }, { Searchable = true })
		return build
	end)

