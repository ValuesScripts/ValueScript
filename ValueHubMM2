--[[
	================================================================================
	 AURA UI LIBRARY
	 A premium, glassmorphism-inspired Roblox executor UI library.
	 Single-file distributable — load via loadstring(game:HttpGet(URL))().

	 Design language : Acrylic / Fluent / Windows 11 / VisionOS inspired
	 Rendering       : Pure Instance + TweenService, no external assets required
	 Compatibility   : UNC executors (PC + Mobile), Synapse X, Script-Ware,
	                   Fluxus, Krnl, Delta, etc.

	 Internally the file is organized as independent logical modules registered
	 into a tiny dependency-injected module registry (register/import), so each
	 concern (Signal, Theme, Animator, Window, components, ...) lives in its own
	 clearly-scoped section below even though it ships as one physical file.
	================================================================================
]]

local AuraLibrary = (function()

	--============================================================================
	-- MODULE REGISTRY (tiny DI container — lazy, memoized, order independent)
	--============================================================================

	local ModuleRegistry = {}
	local ModuleCache = {}

	local function register(name, factory)
		ModuleRegistry[name] = factory
	end

	local function import(name)
		local cached = ModuleCache[name]
		if cached ~= nil then
			return cached
		end
		local factory = ModuleRegistry[name]
		assert(factory, "[Aura] Unknown module: " .. tostring(name))
		local result = factory(import)
		ModuleCache[name] = result
		return result
	end

	--============================================================================
	-- MODULE: Signal
	-- Minimal, allocation-light event implementation used instead of
	-- BindableEvents (cheaper, no engine round-trip).
	--============================================================================

	register("Signal", function(import)

		local Signal = {}
		Signal.__index = Signal

		function Signal.new()
			return setmetatable({ _handlers = {} }, Signal)
		end

		function Signal:Connect(fn)
			local handlers = self._handlers
			local handler = { Fn = fn, Connected = true }
			table.insert(handlers, handler)

			local Connection = {}
			function Connection.Disconnect()
				if not handler.Connected then return end
				handler.Connected = false
				for i = #handlers, 1, -1 do
					if handlers[i] == handler then
						table.remove(handlers, i)
						break
					end
				end
			end
			Connection.Destroy = Connection.Disconnect

			return Connection
		end

		function Signal:Once(fn)
			local connection
			connection = self:Connect(function(...)
				connection.Disconnect()
				fn(...)
			end)
			return connection
		end

		function Signal:Wait()
			local thread = coroutine.running()
			local connection
			connection = self:Connect(function(...)
				connection.Disconnect()
				task.spawn(thread, ...)
			end)
			return coroutine.yield()
		end

		function Signal:Fire(...)
			local handlers = self._handlers
			for i = 1, #handlers do
				local h = handlers[i]
				if h.Connected then
					task.spawn(h.Fn, ...)
				end
			end
		end

		function Signal:DisconnectAll()
			table.clear(self._handlers)
		end

		function Signal:Destroy()
			self:DisconnectAll()
		end

		return Signal
	end)

	--============================================================================
	-- MODULE: Maid (cleanup manager)
	-- Every component/window/tab owns a Maid so all connections, tweens, and
	-- instances it creates are guaranteed to be released on :Destroy().
	--============================================================================

	register("Maid", function(import)

		local Maid = {}
		Maid.__index = Maid

		function Maid.new()
			return setmetatable({ _tasks = {}, _destroyed = false }, Maid)
		end

		local function cleanupTask(job)
			local t = type(job)
			if t == "function" then
				job()
			elseif t == "table" then
				if typeof(job) == "RBXScriptConnection" then
					job:Disconnect()
				elseif job.Destroy then
					job:Destroy()
				elseif job.Disconnect then
					job:Disconnect()
				end
			elseif t == "userdata" then
				local ok = pcall(function() job:Destroy() end)
				if not ok then pcall(function() job:Disconnect() end) end
			end
		end

		function Maid:GiveTask(job, key)
			if self._destroyed then
				cleanupTask(job)
				return
			end
			key = key or (#self._tasks + 1)
			if self._tasks[key] then
				cleanupTask(self._tasks[key])
			end
			self._tasks[key] = job
			return key
		end

		function Maid:Remove(key)
			local job = self._tasks[key]
			if job then
				cleanupTask(job)
				self._tasks[key] = nil
			end
		end

		function Maid:DoCleaning()
			local tasks = self._tasks
			self._tasks = {}
			for _, job in pairs(tasks) do
				cleanupTask(job)
			end
		end

		function Maid:Destroy()
			self._destroyed = true
			self:DoCleaning()
		end

		return Maid
	end)

	--============================================================================
	-- MODULE: Utility
	-- Shared low-level helpers: instance construction, rounded corners, strokes,
	-- soft-shadow simulation, gradients, math helpers, executor-safe GUI parenting.
	--============================================================================

	register("Utility", function(import)

		local Utility = {}

		-- ---------- Instance construction ----------

		-- Hyperscript-style instance creator: Create("Frame", { Prop = value, [Child1, Child2] })
		function Utility.Create(className, props)
			local inst = Instance.new(className)
			if props then
				for key, value in pairs(props) do
					if type(key) == "number" then
						value.Parent = inst
					elseif key ~= "Parent" then
						inst[key] = value
					end
				end
				if props.Parent then
					inst.Parent = props.Parent
				end
			end
			return inst
		end

		local Create = Utility.Create

		function Utility.Corner(radius, parent)
			return Create("UICorner", {
				CornerRadius = UDim.new(0, radius or 8),
				Parent = parent,
			})
		end

		function Utility.Stroke(props, parent)
			props = props or {}
			return Create("UIStroke", {
				Color = props.Color or Color3.fromRGB(255, 255, 255),
				Thickness = props.Thickness or 1,
				Transparency = props.Transparency or 0.8,
				ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
				Parent = parent,
			})
		end

		function Utility.Padding(props, parent)
			props = props or {}
			local all = props.All
			return Create("UIPadding", {
				PaddingTop = props.Top or (all and UDim.new(0, all)) or UDim.new(0, 0),
				PaddingBottom = props.Bottom or (all and UDim.new(0, all)) or UDim.new(0, 0),
				PaddingLeft = props.Left or (all and UDim.new(0, all)) or UDim.new(0, 0),
				PaddingRight = props.Right or (all and UDim.new(0, all)) or UDim.new(0, 0),
				Parent = parent,
			})
		end

		function Utility.Gradient(colorSequence, rotation, transparency, parent)
			return Create("UIGradient", {
				Color = colorSequence,
				Rotation = rotation or 0,
				Transparency = transparency,
				Parent = parent,
			})
		end

		function Utility.ListLayout(props, parent)
			props = props or {}
			return Create("UIListLayout", {
				FillDirection = props.FillDirection or Enum.FillDirection.Vertical,
				HorizontalAlignment = props.HorizontalAlignment or Enum.HorizontalAlignment.Left,
				VerticalAlignment = props.VerticalAlignment or Enum.VerticalAlignment.Top,
				Padding = props.Padding or UDim.new(0, 6),
				SortOrder = Enum.SortOrder.LayoutOrder,
				Parent = parent,
			})
		end

		-- Soft drop-shadow built from stacked, progressively larger, low-opacity
		-- rounded frames (no image asset — guaranteed to render identically on
		-- every executor, unlike a referenced rbxassetid which may not exist).
		function Utility.Shadow(props, parent)
			props = props or {}
			local layers = props.Layers or 5
			local spread = props.Spread or 34
			local baseAlpha = 1 - (props.Transparency or 0.55)
			local radius = props.Radius or 16

			local holder = Create("Frame", {
				Name = "Shadow",
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				ZIndex = props.ZIndex or -1,
				Parent = parent,
			})

			for i = 1, layers do
				local t = i / layers
				local layerSpread = spread * t
				local layerAlpha = baseAlpha * (1 - t) * 0.5
				local layer = Create("Frame", {
					BackgroundColor3 = props.Color or Color3.fromRGB(0, 0, 0),
					BackgroundTransparency = 1 - layerAlpha,
					BorderSizePixel = 0,
					Size = UDim2.new(1, layerSpread, 1, layerSpread),
					Position = UDim2.new(0.5, 0, 0.5, props.YOffset or 4),
					AnchorPoint = Vector2.new(0.5, 0.5),
					Parent = holder,
				})
				Utility.Corner(radius + layerSpread / 2, layer)
			end

			return holder
		end

		-- Simulated glow (used for focus rings / accent highlights / breathing
		-- effects) — same stacked-frame technique as Utility.Shadow, tuned brighter.
		function Utility.Glow(props, parent)
			props = props or {}
			local layers = props.Layers or 4
			local spread = props.Spread or 60
			local baseAlpha = 1 - (props.Transparency or 0.7)
			local radius = props.Radius or 16

			local holder = Create("Frame", {
				Name = "Glow",
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				ZIndex = props.ZIndex or -2,
				Parent = parent,
			})

			for i = 1, layers do
				local t = i / layers
				local layerSpread = spread * t
				local layerAlpha = baseAlpha * (1 - t) * 0.6
				local layer = Create("Frame", {
					BackgroundColor3 = props.Color or Color3.fromRGB(255, 255, 255),
					BackgroundTransparency = 1 - layerAlpha,
					BorderSizePixel = 0,
					Size = UDim2.new(1, layerSpread, 1, layerSpread),
					Position = UDim2.fromScale(0.5, 0.5),
					AnchorPoint = Vector2.new(0.5, 0.5),
					Parent = holder,
				})
				Utility.Corner(radius + layerSpread / 2, layer)
			end

			return holder
		end

		-- ---------- Math helpers ----------

		function Utility.Clamp(n, min, max)
			if n < min then return min end
			if n > max then return max end
			return n
		end

		function Utility.Lerp(a, b, t)
			return a + (b - a) * t
		end

		function Utility.Round(n, decimals)
			local mult = 10 ^ (decimals or 0)
			return math.floor(n * mult + 0.5) / mult
		end

		function Utility.MapRange(n, inMin, inMax, outMin, outMax)
			if inMax == inMin then return outMin end
			return outMin + ((n - inMin) / (inMax - inMin)) * (outMax - outMin)
		end

		-- ---------- Misc ----------

		local uidCounter = 0
		function Utility.UID()
			uidCounter += 1
			return string.format("%d_%d", math.floor(os.clock() * 1000), uidCounter)
		end

		function Utility.DeepCopy(tbl)
			local copy = {}
			for k, v in pairs(tbl) do
				copy[k] = (type(v) == "table") and Utility.DeepCopy(v) or v
			end
			return copy
		end

		function Utility.Debounce(fn, wait)
			local last = 0
			return function(...)
				local now = os.clock()
				if now - last >= wait then
					last = now
					fn(...)
				end
			end
		end

		function Utility.Truncate(text, maxChars)
			if #text <= maxChars then return text end
			return string.sub(text, 1, maxChars - 1) .. "…"
		end

		-- Finds the safest GUI parent for maximum executor compatibility
		-- (UNC gethui() > CoreGui > PlayerGui)
		function Utility.GetGuiParent()
			local ok, hui = pcall(function()
				return gethui and gethui()
			end)
			if ok and hui then
				return hui
			end

			local success, coreGui = pcall(function()
				return game:GetService("CoreGui")
			end)
			if success and coreGui then
				return coreGui
			end

			local player = game:GetService("Players").LocalPlayer
			return player:WaitForChild("PlayerGui")
		end

		-- Protects a ScreenGui from anti-cheat GUI destruction when supported.
		function Utility.ProtectGui(gui)
			pcall(function()
				if syn and syn.protect_gui then
					syn.protect_gui(gui)
				elseif protectgui then
					protectgui(gui)
				end
			end)
		end

		return Utility
	end)

	--============================================================================
	-- MODULE: Animator
	-- Central animation manager wrapping TweenService. Provides named easing
	-- presets (Quint / Circular / Exponential / Back / Sine), reusable TweenInfo
	-- objects (avoids per-call allocation), ripple effects, and breathing/pulse
	-- loops used across every interactive component.
	--============================================================================

	register("Animator", function(import)

		local TweenService = game:GetService("TweenService")
		local Utility = import("Utility")

		local Animator = {}

		-- Named easing presets. "Fast" variants are used for micro-interactions
		-- (hover, press) while base variants are used for larger motions
		-- (window open/close, tab switch, panel resize).
		Animator.Easing = {
			Quint      = Enum.EasingStyle.Quint,
			Circular   = Enum.EasingStyle.Circular,
			Exponential = Enum.EasingStyle.Exponential,
			Back       = Enum.EasingStyle.Back,
			Sine       = Enum.EasingStyle.Sine,
			Quad       = Enum.EasingStyle.Quad,
			Cubic      = Enum.EasingStyle.Cubic,
		}

		local infoCache = {}

		-- Returns (and caches) a TweenInfo for the given parameters so repeated
		-- animations of the same "shape" reuse the same object instead of
		-- allocating a new one every call.
		function Animator.Info(duration, style, direction, repeatCount, reverses, delay)
			style = style or Animator.Easing.Quint
			direction = direction or Enum.EasingDirection.Out
			repeatCount = repeatCount or 0
			reverses = reverses or false
			delay = delay or 0

			local key = string.format("%.3f|%s|%s|%d|%s|%.3f",
				duration, style.Name, direction.Name, repeatCount, tostring(reverses), delay)

			local cached = infoCache[key]
			if cached then return cached end

			local info = TweenInfo.new(duration, style, direction, repeatCount, reverses, delay)
			infoCache[key] = info
			return info
		end

		-- Core tween shortcut. Returns the Tween so callers can chain
		-- :Play()/Completed if needed; auto-plays by default.
		function Animator.Tween(instance, props, duration, style, direction, autoplay)
			if autoplay == nil then autoplay = true end
			local info = Animator.Info(duration or 0.25, style, direction)
			local tween = TweenService:Create(instance, info, props)
			if autoplay then
				tween:Play()
			end
			return tween
		end

		-- Semantic shortcuts matching the interactions called out in the spec.
		function Animator.Open(instance, props, duration)
			return Animator.Tween(instance, props, duration or 0.35, Animator.Easing.Back, Enum.EasingDirection.Out)
		end

		function Animator.Close(instance, props, duration)
			return Animator.Tween(instance, props, duration or 0.22, Animator.Easing.Quint, Enum.EasingDirection.In)
		end

		function Animator.Smooth(instance, props, duration)
			return Animator.Tween(instance, props, duration or 0.2, Animator.Easing.Quint, Enum.EasingDirection.Out)
		end

		function Animator.Snap(instance, props, duration)
			return Animator.Tween(instance, props, duration or 0.15, Animator.Easing.Circular, Enum.EasingDirection.Out)
		end

		-- Expanding-circle ripple used by buttons/toggles/tab items. Cleans
		-- itself up on completion — no dangling instances.
		function Animator.Ripple(parent, x, y, color, sizeMultiplier)
			local absSize = parent.AbsoluteSize
			local diameter = math.max(absSize.X, absSize.Y) * (sizeMultiplier or 1.6)

			local ripple = Utility.Create("Frame", {
				Name = "Ripple",
				BackgroundColor3 = color or Color3.fromRGB(255, 255, 255),
				BackgroundTransparency = 0.75,
				BorderSizePixel = 0,
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromOffset(x, y),
				Size = UDim2.fromOffset(0, 0),
				ZIndex = (parent.ZIndex or 1) + 5,
				Parent = parent,
			})
			Utility.Corner(1000, ripple)

			local tween = Animator.Tween(ripple, {
				Size = UDim2.fromOffset(diameter, diameter),
				BackgroundTransparency = 1,
			}, 0.55, Animator.Easing.Quint, Enum.EasingDirection.Out)

			tween.Completed:Once(function()
				ripple:Destroy()
			end)

			return ripple
		end

		-- Continuous, low-amplitude "breathing" glow loop. Returns a controller
		-- table with :Stop() to halt and clean up.
		function Animator.Breathe(instance, property, low, high, duration)
			local running = true
			local tween

			local function step()
				if not running or not instance.Parent then return end
				tween = Animator.Tween(instance, { [property] = high }, duration or 1.6, Animator.Easing.Sine, Enum.EasingDirection.InOut)
				tween.Completed:Once(function()
					if not running or not instance.Parent then return end
					tween = Animator.Tween(instance, { [property] = low }, duration or 1.6, Animator.Easing.Sine, Enum.EasingDirection.InOut)
					tween.Completed:Once(function()
						if running then step() end
					end)
				end)
			end
			step()

			return {
				Stop = function()
					running = false
					if tween then tween:Cancel() end
				end,
			}
		end

		-- Continuous rotation loop for spinners / loading rings.
		function Animator.Spin(instance, duration)
			local running = true
			local conn
			local speed = 360 / (duration or 1)
			local RunService = game:GetService("RunService")
			conn = RunService.RenderStepped:Connect(function(dt)
				if not running or not instance.Parent then
					conn:Disconnect()
					return
				end
				instance.Rotation = (instance.Rotation + speed * dt) % 360
			end)
			return {
				Stop = function()
					running = false
					if conn.Connected then conn:Disconnect() end
				end,
			}
		end

		return Animator
	end)

