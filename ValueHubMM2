	--============================================================================

	register("Component_Diagnostics", function(import)
		local Utility = import("Utility")
		local Animator = import("Animator")
		local Theme = import("Theme")
		local Registry = import("ComponentRegistry")
		local RunService = game:GetService("RunService")
		local Create = Utility.Create

		local CORNER_ANCHOR = {
			TopLeft = { Vector2.new(0, 0), UDim2.new(0, 12, 0, 12) },
			TopRight = { Vector2.new(1, 0), UDim2.new(1, -12, 0, 12) },
			BottomLeft = { Vector2.new(0, 1), UDim2.new(0, 12, 1, -12) },
			BottomRight = { Vector2.new(1, 1), UDim2.new(1, -12, 1, -12) },
		}

		local function floatingPill(ctx, corner)
			local colors = Theme.Get()
			local cfg = CORNER_ANCHOR[corner] or CORNER_ANCHOR.TopLeft
			local pill = Create("Frame", {
				BackgroundColor3 = colors.Background,
				BackgroundTransparency = 0.15,
				AnchorPoint = cfg[1],
				Position = cfg[2],
				Size = UDim2.fromOffset(0, 26),
				AutomaticSize = Enum.AutomaticSize.X,
				ZIndex = 600,
				Parent = ctx.Root,
			})
			Utility.Corner(8, pill)
			Utility.Stroke({ Color = colors.Border, Transparency = colors.BorderAlpha }, pill)
			Utility.Padding({ Left = UDim.new(0, 10), Right = UDim.new(0, 10) }, pill)
			return pill, colors
		end

		-- ---------- FPS Counter ----------
		local function buildFPSCounter(parent, opts, ctx)
			local pill, colors = floatingPill(ctx, opts.Corner or "TopRight")
			local label = Create("TextLabel", {
				Text = "FPS: --", Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = colors.Text,
				BackgroundTransparency = 1, Size = UDim2.new(0, 0, 1, 0), AutomaticSize = Enum.AutomaticSize.X,
				Parent = pill,
			})

			local frames, elapsed = 0, 0
			local conn = RunService.RenderStepped:Connect(function(dt)
				frames += 1
				elapsed += dt
				if elapsed >= 0.5 then
					local fps = math.floor(frames / elapsed + 0.5)
					label.Text = "FPS: " .. fps
					label.TextColor3 = fps >= 50 and colors.Success or (fps >= 30 and colors.Warning or colors.Error)
					frames, elapsed = 0, 0
				end
			end)

			local api = { Instance = pill }
			function api.Destroy() conn:Disconnect(); pill:Destroy() end
			return api
		end
