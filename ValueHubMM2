			Size = UDim2.new(1, -SIDEBAR_WIDTH, 1, 0),
			BackgroundTransparency = 1,
			ClipsDescendants = true,
			ZIndex = 2,
			Parent = body,
		})
		self.ContentHolder = contentHolder

		-- Backdrop used by popups + the mobile drawer to catch outside clicks
		local backdrop = Creator.New("TextButton", {
			Name = "Backdrop",
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			Visible = false,
			ZIndex = 40,
			Parent = mainFrame,
		})
		self._backdrop = backdrop

		-- Dragging + resizing -----------------------------------------------------
		if props.Draggable ~= false then
			Draggable.MakeDraggable(topBar, holder)
		end
		if props.Resizable ~= false then
			local grip = Creator.New("TextButton", {
				Name = "ResizeGrip",
				Size = UDim2.fromOffset(18, 18),
				Position = UDim2.new(1, -18, 1, -18),
				BackgroundTransparency = 1,
				AutoButtonColor = false,
				Text = "",
				ZIndex = 5,
				Parent = mainFrame,
			})
			Creator.New("ImageLabel", {
				Size = UDim2.fromOffset(10, 10),
				Position = UDim2.new(1, -12, 1, -12),
				BackgroundTransparency = 1,
				ImageTransparency = 0.5,
				Image = "rbxasset://textures/ui/InGameChat/icons/ic-dots-menu.png",
				Rotation = 45,
				ZIndex = 5,
				Parent = grip,
			})
			local minSize = props.MinSize or Vector2.new(460, 320)
			Draggable.MakeResizable(grip, holder, minSize)
		end

		-- Toggle keybind ------------------------------------------------------
		self.ToggleKey = props.ToggleKey
		if self.ToggleKey then
			UserInputService.InputBegan:Connect(function(input, processed)
				if processed then
					return
				end
				if input.KeyCode == self.ToggleKey then
					self:Toggle()
				end
			end)
		end

		-- Responsive: recompute mobile/desktop layout on size change ------------
		local function applyResponsive()
			local width = holder.AbsoluteSize.X
			local mobile = width < MOBILE_BREAKPOINT
			self.IsMobile = mobile
			if mobile then
				sidebar.Visible = self._drawerOpen == true
				sidebar.ZIndex = 60
				sidebar.Position = UDim2.new(0, 0, 0, 0)
				sidebar.Size = UDim2.new(0, math.min(220, width - 40), 1, 0)
				contentHolder.Position = UDim2.new(0, 0, 0, 0)
				contentHolder.Size = UDim2.new(1, 0, 1, 0)
				hamburger.Visible = true
				titleLabel.Position = UDim2.new(0, titleX + 34, 0, 6)
				subLabel.Position = UDim2.new(0, titleX + 34, 0, 24)
			else
				self._drawerOpen = false
				sidebar.Visible = true
				sidebar.ZIndex = 3
				sidebar.Position = UDim2.new(0, 0, 0, 0)
				sidebar.Size = UDim2.new(0, SIDEBAR_WIDTH, 1, 0)
				contentHolder.Position = UDim2.new(0, SIDEBAR_WIDTH, 0, 0)
				contentHolder.Size = UDim2.new(1, -SIDEBAR_WIDTH, 1, 0)
				hamburger.Visible = false
				titleLabel.Position = UDim2.new(0, titleX, 0, 6)
				subLabel.Position = UDim2.new(0, titleX, 0, 24)
				backdrop.Visible = false
				backdrop.BackgroundTransparency = 1
			end
		end
		holder:GetPropertyChangedSignal("AbsoluteSize"):Connect(applyResponsive)
		applyResponsive()

		hamburger.MouseButton1Click:Connect(function()
			self._drawerOpen = not self._drawerOpen
			sidebar.Visible = self._drawerOpen
			backdrop.Visible = self._drawerOpen
			backdrop.ZIndex = 55
			Creator.Snap(backdrop, { BackgroundTransparency = self._drawerOpen and 0.35 or 1 })
		end)
		backdrop.MouseButton1Click:Connect(function()
			if self._drawerOpen then
				self._drawerOpen = false
				sidebar.Visible = false
				Creator.Snap(backdrop, { BackgroundTransparency = 1 })
				task.delay(0.2, function()
					if not self._drawerOpen then
						backdrop.Visible = false
					end
				end)
			end
			self:CloseActivePopup()
		end)

		-- Mobile toggle bubble -- touch devices have no ToggleKey, so give
		-- them a small draggable floating button that Window:Toggle()s.
		-- Lives directly on the ScreenGui (not the Holder), and the
		-- ScreenGui itself is never disabled, so this keeps working even
		-- while the window is hidden.
		if UserInputService.TouchEnabled then
			local fabHolder = Creator.New("Frame", {
				Name = "MobileToggleHolder",
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -18, 1, -100),
				Size = UDim2.fromOffset(52, 52),
				BackgroundTransparency = 1,
				ClipsDescendants = false,
				ZIndex = 999,
				Parent = screenGui,
			})
			if not self.LowGraphicsMode then
				Creator.Shadow(fabHolder, 26, 0.35)
			end

			local fab = Creator.New("TextButton", {
				Name = "MobileToggle",
				Size = UDim2.new(1, 0, 1, 0),
				BackgroundColor3 = Themes.Get("Accent"),
				AutoButtonColor = false,
				Text = "\226\152\176",
				Font = Enum.Font.GothamBold,
				TextSize = 20,
				TextColor3 = Color3.new(1, 1, 1),
				ZIndex = 1000,
				Parent = fabHolder,
			}, {
				Creator.Corner(999),
				Creator.Stroke({ Color = Color3.new(1, 1, 1), Thickness = 1, Transparency = 0.7 }),
			})
			Themes.Register(fab, { BackgroundColor3 = "Accent" })

			local dragDistance = 0
			Draggable.MakeDraggable(fab, fabHolder, {
				OnStart = function()
					dragDistance = 0
				end,
				OnUpdate = function()
					dragDistance += 1
				end,
			})
			fab.MouseButton1Click:Connect(function()
				if dragDistance < 4 then
					self:Toggle()
				end
			end)
			fab.MouseButton1Down:Connect(function()
				Creator.Snap(fab, { Size = UDim2.new(0.88, 0, 0.88, 0), Position = UDim2.new(0.06, 0, 0.06, 0) }, 0.08)
			end)
			fab.MouseButton1Up:Connect(function()
				Creator.Snap(fab, { Size = UDim2.new(1, 0, 1, 0), Position = UDim2.new(0, 0, 0, 0) }, 0.12)
			end)

			self.FAB = fab
			self.FABHolder = fabHolder
		end

		-- Notifications + tooltips ------------------------------------------------
		self.Notifications = Notification.new(screenGui)
		self.TooltipManager = Tooltip.new(screenGui)

		self._context = {
			Theme = Themes,
			Config = self.ConfigManager,
			Window = self,
			Tooltip = self.TooltipManager,
		}

		-- open/close animation ------------------------------------------------
		holder.Size = UDim2.new(0, 0, 0, 0)
		local targetSize = props.Size or UDim2.fromOffset(640, 460)
		holder.Position = props.Position or UDim2.new(0.5, -(targetSize.X.Offset / 2), 0.5, -(targetSize.Y.Offset / 2))
		holder.Size = UDim2.new(targetSize.X.Scale, 0, targetSize.Y.Scale, 0)
		Creator.Animate(holder, { Size = targetSize }, 0.35, Enum.EasingStyle.Back)

		return self
	end

	function Window:_filterTabs(query: string)
		query = query:lower()
		for _, tab in ipairs(self.Tabs) do
			local visible = query == "" or tab.Name:lower():find(query, 1, true) ~= nil
			tab.Button.Visible = visible
		end
	end

	function Window:OpenPopup(anchor: GuiObject, builder: (Frame) -> ())
		self:CloseActivePopup()

		self._backdrop.Visible = true
		self._backdrop.ZIndex = 90
		self._backdrop.BackgroundTransparency = 1

		local popupHolder = Creator.New("Frame", {
			Name = "Popup",
			BackgroundTransparency = 1,
			ZIndex = 100,
			Parent = self.Overlay,
		})

		local function reposition()
			local absPos = anchor.AbsolutePosition
			local mainAbsPos = self.MainFrame.AbsolutePosition
			popupHolder.Position = UDim2.new(
				0,
				absPos.X - mainAbsPos.X,
				0,
				absPos.Y - mainAbsPos.Y + anchor.AbsoluteSize.Y + 4
			)
			popupHolder.Size = UDim2.new(0, anchor.AbsoluteSize.X, 0, 0)
		end
		reposition()
		local resizeConn = self.MainFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(reposition)
		local moveConn = anchor:GetPropertyChangedSignal("AbsolutePosition"):Connect(reposition)

		local onClose = builder(popupHolder)

		-- flip above the anchor if the popup would overflow past the bottom
		-- of the window (Overlay clips to the window bounds)
		do
			local mainAbsSize = self.MainFrame.AbsoluteSize
			local popupBottom = popupHolder.Position.Y.Offset + popupHolder.AbsoluteSize.Y
			if popupHolder.AbsoluteSize.Y > 0 and popupBottom > mainAbsSize.Y - 8 then
				local anchorAbsPos = anchor.AbsolutePosition
				local mainAbsPos = self.MainFrame.AbsolutePosition
				popupHolder.Position = UDim2.new(
					0,
					anchorAbsPos.X - mainAbsPos.X,
					0,
					anchorAbsPos.Y - mainAbsPos.Y - popupHolder.AbsoluteSize.Y - 4
				)
			end
		end

		local closed = false
		local function close()
			if closed then
				return
			end
			closed = true
			resizeConn:Disconnect()
			moveConn:Disconnect()
			if self._activePopup and self._activePopup.holder == popupHolder then
				self._activePopup = nil
				self._backdrop.Visible = false
			end
			if typeof(onClose) == "function" then
				local ok, err = pcall(onClose)
				if not ok then
					warn("[UILibrary] Popup onClose error: " .. tostring(err))
				end
			end
			popupHolder:Destroy()
		end

		self._activePopup = { holder = popupHolder, Close = close }
		local clickConn
		clickConn = self._backdrop.MouseButton1Click:Connect(function()
			close()
			if clickConn then
				clickConn:Disconnect()
			end
		end)

		return popupHolder, close
	end

	function Window:CloseActivePopup()
		if self._activePopup then
			self._activePopup.Close()
		end
	end

	function Window:CreateTab(props: { [string]: any })
		props = props or {}
		local name = props.Name or ("Tab " .. (#self.Tabs + 1))

		local button = Creator.New("TextButton", {
			Name = name,
			Size = UDim2.new(1, 0, 0, TAB_HEIGHT),
			BackgroundColor3 = Themes.Get("Accent"),
			BackgroundTransparency = 1,
			AutoButtonColor = false,
			Text = "",
			ZIndex = 4,
			LayoutOrder = #self.Tabs,
			Parent = self.TabScroll,
		}, { Creator.Corner(6) })

		-- Active-tab accent indicator: a thin bar that grows in on the left
		-- edge of the selected tab. Pure vector (no image asset needed).
		local indicator = Creator.New("Frame", {
			Name = "Indicator",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 4, 0.5, 0),
			Size = UDim2.fromOffset(3, 0),
			BackgroundColor3 = Themes.Get("Accent"),
			ZIndex = 5,
			Parent = button,
		}, { Creator.Corner(2) })
		Themes.Register(indicator, { BackgroundColor3 = "Accent" })

		if props.Icon then
			local tabIcon = Creator.New("ImageLabel", {
				Size = UDim2.fromOffset(16, 16),
				Position = UDim2.new(0, 10, 0.5, -8),
				BackgroundTransparency = 1,
				ImageColor3 = Themes.Get("SubText"),
				Name = "Icon",
				ZIndex = 5,
				Parent = button,
			})
			Creator.ApplyIcon(tabIcon, props.Icon, 16)
		end

		local label = Creator.New("TextLabel", {
			Name = "Label",
			Position = UDim2.new(0, props.Icon and 34 or 12, 0, 0),
			Size = UDim2.new(1, -(props.Icon and 44 or 22), 1, 0),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamMedium,
			Text = name,
			TextSize = 13,
			TextColor3 = Themes.Get("SubText"),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 5,
			Parent = button,
		})

		local page = Creator.New("ScrollingFrame", {
			Name = name .. "Page",
			Size = UDim2.new(1, 0, 1, 0),
			BackgroundTransparency = 1,
			BorderSizePixel = 0,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = Themes.Get("Border"),
			CanvasSize = UDim2.new(0, 0, 0, 0),
			Visible = false,
			ZIndex = 2,
			Parent = self.ContentHolder,
		}, { Creator.Padding(12) })
		local pageLayout = Creator.ListLayout(Enum.FillDirection.Vertical, 10)
		pageLayout.Parent = page
		bindCanvas(page, pageLayout, 24)

		local tab = {
			Name = name,
			Button = button,
			Page = page,
			Sections = {},
		}

		local function refreshVisualState()
			local active = self.ActiveTab == tab
			Creator.Animate(button, {
				BackgroundTransparency = active and 0.85 or 1,
			}, 0.15)
			Creator.Animate(label, {
				TextColor3 = active and Themes.Get("Text") or Themes.Get("SubText"),
			}, 0.15)
			Creator.Animate(indicator, {
				Size = active and UDim2.fromOffset(3, 18) or UDim2.fromOffset(3, 0),
			}, 0.2, Enum.EasingStyle.Back)
			local icon = button:FindFirstChild("Icon")
			if icon then
				Creator.Animate(icon, {
					ImageColor3 = active and Themes.Get("Accent") or Themes.Get("SubText"),
				}, 0.15)
			end
		end
		tab.RefreshVisualState = refreshVisualState

		button.MouseEnter:Connect(function()
			if self.ActiveTab ~= tab then
				Creator.Snap(button, { BackgroundTransparency = 0.92 })
			end
		end)
		button.MouseLeave:Connect(function()
			if self.ActiveTab ~= tab then
				Creator.Snap(button, { BackgroundTransparency = 1 })
			end
		end)
		button.MouseButton1Click:Connect(function()
			self:SelectTab(tab)
			if self.IsMobile and self._drawerOpen then
				self._drawerOpen = false
				self.Sidebar.Visible = false
				Creator.Snap(self._backdrop, { BackgroundTransparency = 1 })
			end
		end)

		table.insert(self.Tabs, tab)

		function tab.CreateSection(_self, sectionProps)
			local section = Section.new(page, sectionProps, self._context)
			table.insert(tab.Sections, section)
			return section
		end

		if not self.ActiveTab then
			self:SelectTab(tab)
		end

		return tab
	end

	function Window:SelectTab(tab)
		if self.ActiveTab == tab then
			return
		end
		local previous = self.ActiveTab
		self.ActiveTab = tab

		if previous then
			previous.Page.Visible = false
			previous.RefreshVisualState()
		end

		tab.Page.Visible = true
		tab.Page.GroupTransparency = 0
		tab.RefreshVisualState()

		-- subtle pop-in for the freshly shown page
		local originalPos = tab.Page.Position
		tab.Page.Position = originalPos + UDim2.fromOffset(0, 6)
		Creator.Animate(tab.Page, { Position = originalPos }, 0.18)

		-- staggered pop-in for each section card on this tab: slide up +
		-- fade in, offset by a growing delay so cards cascade in rather
		-- than all appearing at once.
		for index, section in ipairs(tab.Sections) do
			local root = section.Root
			if root and root.Parent then
				local settledPos = root.Position
				local settledTransparency = root.BackgroundTransparency
				root.Position = settledPos + UDim2.fromOffset(0, 12)
				root.BackgroundTransparency = 1
				task.delay(math.min((index - 1) * 0.05, 0.25), function()
					if root.Parent then
						Creator.Animate(root, { Position = settledPos }, 0.24, Enum.EasingStyle.Back)
						Creator.Animate(root, { BackgroundTransparency = settledTransparency }, 0.24)
					end
				end)
			end
		end

		self.TabChanged:Fire(tab)
	end

	function Window:ToggleMinimize()
		self.Minimized = not self.Minimized
		self.Body.Visible = not self.Minimized
		local target = self.Minimized and UDim2.new(self.Holder.Size.X.Scale, self.Holder.Size.X.Offset, 0, TOPBAR_HEIGHT)
			or UDim2.new(self.Holder.Size.X.Scale, self.Holder.Size.X.Offset, 0, self._restoreHeight or 460)
		if not self.Minimized then
			self.Body.Visible = true
		end
		if self.Minimized then
			self._restoreHeight = self.Holder.AbsoluteSize.Y
		end
		Creator.Animate(self.Holder, { Size = target }, 0.25)
		if self.Minimized then
			task.delay(0.25, function()
				if self.Minimized then
					self.Body.Visible = false
				end
			end)
		end
	end

	function Window:Show()
		if self.Visible then
			return
		end
		self.Visible = true
		self.Holder.Visible = true
		if self.BlurBackground and not self.LowGraphicsMode then
			self:_applyBlur(true)
		end
		local target = self.Holder.Size
		self.Holder.Size = UDim2.new(target.X.Scale, target.X.Offset * 0.94, target.Y.Scale, target.Y.Offset * 0.94)
		Creator.Animate(self.Holder, { Size = target }, 0.2)
		self.VisibilityChanged:Fire(true)
	end

	function Window:Hide()
		if not self.Visible then
			return
		end
		self.Visible = false
		self:_applyBlur(false)
		-- Holder (not the whole ScreenGui) so the mobile toggle bubble and
		-- notifications keep working while the window itself is hidden.
		self.Holder.Visible = false
		self.VisibilityChanged:Fire(false)
	end

	function Window:Toggle()
		if self.Visible then
			self:Hide()
		else
			self:Show()
		end
	end

	function Window:_applyBlur(enabled: boolean)
		if enabled then
			if not self._blur then
				self._blur = Creator.New("BlurEffect", { Size = 12, Parent = Lighting })
			end
			self._blur.Enabled = true
		elseif self._blur then
			self._blur.Enabled = false
		end
	end

	function Window:SetTheme(name: string)
		Themes.SetTheme(name)
	end

	function Window:Notify(props: { [string]: any })
		return self.Notifications:Push(props)
	end

	function Window:Destroy()
		if self.Destroyed then
			return
		end
		self.Destroyed = true
		if self._blur then
			self._blur:Destroy()
		end
		self.Notifications:Destroy()
		self.TooltipManager:Destroy()
		self.ScreenGui:Destroy()
	end

	return Window
end)()


--[[
	UILibrary -- a modern, performance-first Roblox UI toolkit.

	This whole file is self-contained and self-running: paste it into a
	single LocalScript (or loadstring it from one raw link) and the hub
	built at the bottom appears immediately. No other files needed.

	To make it yours: edit the BuildXTab() functions near the bottom of
	this file (search for "YOUR HUB STARTS HERE"), or delete them and
	write your own -- everything above that point is just the library
	and doesn't need to be touched. See README.md for the full API.
]]


local UILibrary = {}
UILibrary.Version = "1.0.0"
UILibrary.Themes = Themes
UILibrary.Windows = {} :: { any }

-- Creates a new, fully independent window (its own ScreenGui, drag state,
-- config manager, notification stack). Multiple windows can coexist.
function UILibrary:CreateWindow(props: { [string]: any }?)
	local window = Window.new(props or {})
	table.insert(self.Windows, window)
	return window
end

function UILibrary:SetTheme(name: string)
	Themes.SetTheme(name)
end

function UILibrary:GetThemeNames(): { string }
	local names = {}
	for name in pairs(Themes.Palettes) do
		table.insert(names, name)
	end
	table.sort(names)
	return names
end

-- Drops a ready-made live theme editor (preset dropdown + a colour picker
-- per palette key, all bound to Themes.SetCustomColor) into any Section.
--   local editorTab = Window:CreateTab({Name = "Appearance"})
--   local editorSection = editorTab:CreateSection({Name = "Theme"})
--   UILibrary:CreateThemeEditor(editorSection)
function UILibrary:CreateThemeEditor(section)
	section:CreateDropdown({
		Title = "Theme",
		Options = self:GetThemeNames(),
		Default = Themes.Current,
		Tooltip = "Switch between built-in themes or Custom",
		Callback = function(value)
			Themes.SetTheme(value)
		end,
	})

	local editableKeys = {
		"Accent",
		"Background",
		"Secondary",
		"Tertiary",
		"Elevated",
		"Border",
		"Text",
		"SubText",
		"Success",
		"Warning",
		"Error",
	}

	for _, key in ipairs(editableKeys) do
		section:CreateColorPicker({
			Title = key,
			Default = Themes.Palettes.Custom[key],
			Callback = function(color)
				Themes.SetCustomColor(key, color)
			end,
		})
	end
end

function UILibrary:DestroyAll()
	for _, window in ipairs(self.Windows) do
		window:Destroy()
	end
	table.clear(self.Windows)
end

