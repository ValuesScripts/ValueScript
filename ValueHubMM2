	register("Component_Keybind", function(import)
		local Utility = import("Utility")
		local Animator = import("Animator")
		local Theme = import("Theme")
		local Base = import("ComponentBase")
		local Registry = import("ComponentRegistry")
		local Config = import("Config")
		local Input = import("Input")
		local Create = Utility.Create

		local function build(parent, opts, ctx)
			local colors = Theme.Get()
			local bound = opts.Default

			local card = Base.Card(parent, opts, { Inline = true, ControlSize = UDim2.fromOffset(88, 28) })
			local chip = Create("TextButton", {
				Text = bound and Input.LabelFor(bound) or "None",
				Font = Enum.Font.GothamMedium,
				TextSize = 12,
				TextColor3 = colors.Text,
				AutoButtonColor = false,
				BackgroundColor3 = colors.Elevated,
				BackgroundTransparency = 0.1,
				Size = UDim2.fromScale(1, 1),
				Parent = card.Control,
			})
			Utility.Corner(8, chip)
			local stroke = Utility.Stroke({ Color = colors.Border, Transparency = colors.BorderAlpha }, chip)

			local api = {}
			api.Changed = import("Signal").new()
			api.Pressed = import("Signal").new()
			api.Released = import("Signal").new()
			api.Instance = card.Root

			local recording = false
			local unbindRecorder
			local breathing

			local function stopRecording()
				recording = false
				if breathing then breathing.Stop(); breathing = nil end
				chip.Text = bound and Input.LabelFor(bound) or "None"
				Animator.Snap(stroke, { Color = colors.Border, Transparency = colors.BorderAlpha }, 0.15)
			end

			-- Serialized as "Kind:Name" since a bind may be either a KeyCode
			-- (keyboard) or a UserInputType (mouse button). Enum categories
			-- don't expose a readable `.Name` string (indexing one looks up
			-- an item by that name instead), so the kind is hardcoded.
			local function serializeBound(value)
				if not value then return nil end
				if value.EnumType == Enum.KeyCode then
					return "KeyCode:" .. value.Name
				end
				return "UserInputType:" .. value.Name
			end
			local function deserializeBound(str)
				if not str then return nil end
				local kind, name = str:match("^(.-):(.+)$")
				if not kind then return nil end
				if kind == "KeyCode" then
					return Enum.KeyCode[name]
				elseif kind == "UserInputType" then
					return Enum.UserInputType[name]
				end
				return nil
			end

			local function setBound(value, silent)
				bound = value
				chip.Text = bound and Input.LabelFor(bound) or "None"
				if not silent then
					if opts.Callback then task.spawn(opts.Callback, bound) end
					api.Changed:Fire(bound)
					if opts.Flag then Config.Set(opts.Flag, serializeBound(bound)) end
				end
			end

			chip.MouseButton1Click:Connect(function()
				if recording then return end
				recording = true
				chip.Text = "..."
				Animator.Snap(stroke, { Color = colors.Accent, Transparency = 0.2 }, 0.15)
				breathing = Animator.Breathe(stroke, "Transparency", 0.2, 0.6, 0.5)

				unbindRecorder = Input.RecordNext(function(id, input)
					if not recording then return end
					if id == Enum.KeyCode.Escape or id == Enum.KeyCode.Backspace then
						setBound(nil, false)
					else
						setBound(id, false)
					end
					stopRecording()
				end)
			end)

			local conn = Input.KeyPressed:Connect(function(id)
				if not recording and bound and id == bound then
					api.Pressed:Fire()
				end
			end)
			local conn2 = Input.KeyReleased:Connect(function(id)
				if not recording and bound and id == bound then
					api.Released:Fire()
				end
			end)

			function api.Set(value, silent) setBound(value, silent) end
			function api.Get() return bound end
			function api.Destroy()
				conn:Disconnect()
				conn2:Disconnect()
				if breathing then breathing.Stop() end
				card.Root:Destroy()
			end

			if opts.Flag then
				Config.Register(opts.Flag, serializeBound(bound), function(v)
					setBound(deserializeBound(v), true)
				end)
			end

			return api
		end

		Registry.Register("Keybind", build, { "Keybind", "Hotkey" })
		return build
	end)

