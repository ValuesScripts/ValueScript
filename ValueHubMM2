	register("Component_Dropdown", function(import)
		local Utility = import("Utility")
		local Animator = import("Animator")
		local Theme = import("Theme")
		local Base = import("ComponentBase")
		local Registry = import("ComponentRegistry")
		local Config = import("Config")
		local Icons = import("Icons")
		local RunService = game:GetService("RunService")
		local Create = Utility.Create

		local function optText(option)
			if type(option) == "table" then return option.Text or option.Name or tostring(option) end
			return tostring(option)
		end

		local function build(parent, opts, ctx)
			local colors = Theme.Get()
			local multi = opts.Multi == true
			local searchable = opts.Searchable == true
			local options = opts.Options or {}

			local selectedSet = {}
			local selectedSingle = nil
			if multi then
				for _, v in ipairs(opts.Default or {}) do selectedSet[v] = true end
			else
				selectedSingle = opts.Default
			end

			local card = Base.Card(parent, opts, { Inline = false })

			local field = Create("TextButton", {
				Name = "Field",
				Text = "",
				AutoButtonColor = false,
				BackgroundColor3 = colors.Elevated,
				BackgroundTransparency = 0.1,
				Size = UDim2.new(1, 0, 0, 38),
				Parent = card.Body,
			})
			Utility.Corner(10, field)
			local stroke = Utility.Stroke({ Color = colors.Border, Transparency = colors.BorderAlpha, Thickness = 1 }, field)

			local valueLabel = Create("TextLabel", {
				Text = "Select...",
				Font = Enum.Font.Gotham,
				TextSize = 13,
				TextColor3 = colors.SubText,
				TextXAlignment = Enum.TextXAlignment.Left,
				TextTruncate = Enum.TextTruncate.AtEnd,
				BackgroundTransparency = 1,
				Position = UDim2.new(0, 12, 0, 0),
				Size = UDim2.new(1, -34, 1, 0),
				Parent = field,
			})

			local chevron = Create("ImageLabel", {
				ImageColor3 = colors.SubText,
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(12, 12),
				Position = UDim2.new(1, -12, 0.5, 0),
				AnchorPoint = Vector2.new(1, 0.5),
				Parent = field,
			})
			Icons.Apply(chevron, Icons.ChevronDown)

			local api = {}
			api.Changed = import("Signal").new()
			api.Instance = card.Root

			local function refreshLabel()
				if multi then
					local count, first = 0, nil
					for k, v in pairs(selectedSet) do
						if v then
							count += 1
							first = first or k
						end
					end
					valueLabel.Text = (count == 0 and "None selected") or (count == 1 and optText(first)) or (count .. " selected")
					valueLabel.TextColor3 = count == 0 and colors.SubText or colors.Text
				else
					valueLabel.Text = selectedSingle and optText(selectedSingle) or (opts.Placeholder or "Select...")
