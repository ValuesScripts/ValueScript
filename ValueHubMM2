	--============================================================================

	register("Component_Loaders", function(import)
		local Utility = import("Utility")
		local Animator = import("Animator")
		local Theme = import("Theme")
		local Base = import("ComponentBase")
		local Registry = import("ComponentRegistry")
		local Create = Utility.Create

		-- ---------- Spinner / Loading Circle ----------
		local function buildSpinner(parent, opts, ctx)
			local colors = Theme.Get()
			local size = opts.Size or 28
			local dotCount = opts.Dots or 8

			local wrap = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size), Parent = parent })
			local ring = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = wrap })

			for i = 1, dotCount do
				local pos = Base.PlaceRadial(i, dotCount, size / 2 - size / 10)
				local dot = Create("Frame", {
					BackgroundColor3 = opts.Color or colors.Accent,
					BackgroundTransparency = 1 - (i / dotCount) * 0.9,
					Size = UDim2.fromOffset(size / 6, size / 6),
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = pos,
					Parent = ring,
				})
				Utility.Corner(size / 6, dot)
			end

			local spin = Animator.Spin(ring, opts.Speed or 0.9)
			local api = { Instance = wrap }
			function api.Destroy() spin.Stop(); wrap:Destroy() end
			return api
		end
		Registry.Register("Spinner", buildSpinner, { "Spinner", "LoadingCircle", "Loader" })

		-- ---------- Circular Progress ----------
		local function buildCircularProgress(parent, opts, ctx)
			local colors = Theme.Get()
			local size = opts.Size or 72
			local segments = opts.Segments or 36
			local value = Utility.Clamp(opts.Default or 0, 0, 100)

			local wrap = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.fromOffset(size, size), Parent = parent })
			local dots = {}
			for i = 1, segments do
				local pos, rot = Base.PlaceRadial(i, segments, size / 2 - 4)
				local tick = Create("Frame", {
					BackgroundColor3 = colors.MutedText,
					BackgroundTransparency = 0.75,
					Size = UDim2.fromOffset(3, size / 8),
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = pos,
					Rotation = rot,
					Parent = wrap,
				})
				Utility.Corner(2, tick)
				dots[i] = tick
			end

			local label = Create("TextLabel", {
				Text = math.floor(value) .. "%",
				Font = Enum.Font.GothamBold,
				TextSize = size / 5,
				TextColor3 = colors.Text,
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(1, 1),
				Parent = wrap,
			})

			local function render(v, animate)
				local filled = math.floor((v / 100) * segments + 0.5)
				for i, tick in ipairs(dots) do
					local target = i <= filled
					local color = target and (opts.Color or colors.Accent) or colors.MutedText
					local transparency = target and 0.05 or 0.75
					if animate then
						Animator.Smooth(tick, { BackgroundColor3 = color, BackgroundTransparency = transparency }, 0.15)
					else
						tick.BackgroundColor3 = color
						tick.BackgroundTransparency = transparency
					end
				end
				label.Text = math.floor(v) .. "%"
			end
			render(value, false)

			local api = { Instance = wrap }
			function api.Set(v, animate) value = Utility.Clamp(v, 0, 100); render(value, animate ~= false) end
			function api.Get() return value end
			function api.Destroy() wrap:Destroy() end
			return api
		end
		Registry.Register("CircularProgress", buildCircularProgress, { "CircularProgress" })

		-- ---------- Progress Bar ----------
		local function buildProgressBar(parent, opts, ctx)
			local colors = Theme.Get()
			local value = Utility.Clamp(opts.Default or 0, 0, 100)

			local card
			if opts.Title then
				card = Base.Card(parent, opts, { Inline = false, ValueLabel = true })
				card.Value.Text = math.floor(value) .. "%"
			end

			local track = Create("Frame", {
				BackgroundColor3 = colors.MutedText,
				BackgroundTransparency = 0.8,
				Size = UDim2.new(1, 0, 0, 10),
				Parent = card and card.Body or parent,
			})
			Utility.Corner(5, track)
			local fill = Create("Frame", {
				BackgroundColor3 = opts.Color or colors.Accent,
				Size = UDim2.new(value / 100, 0, 1, 0),
				Parent = track,
			})
			Utility.Corner(5, fill)
			local Animator = import("Animator")
			Utility.Gradient(ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 200, 200)),
			}), 0, NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.75), NumberSequenceKeypoint.new(1, 0.9),
			}), fill)

			local api = { Instance = card and card.Root or track }
			function api.Set(v, animate)
				value = Utility.Clamp(v, 0, 100)
				local tweenFn = (animate ~= false) and Animator.Smooth or function(inst, props) for k, p in pairs(props) do inst[k] = p end end
				tweenFn(fill, { Size = UDim2.new(value / 100, 0, 1, 0) }, 0.25)
				if card then card.Value.Text = math.floor(value) .. "%" end
			end
			function api.Get() return value end
			function api.Destroy() (card and card.Root or track):Destroy() end
			return api
		end
		Registry.Register("ProgressBar", buildProgressBar, { "ProgressBar" })

		-- ---------- Skeleton Loading ----------
		local function buildSkeleton(parent, opts, ctx)
			local colors = Theme.Get()
			local holder = Create("Frame", {
				BackgroundColor3 = colors.ElevatedAlt,
				Size = opts.Size or UDim2.new(1, 0, 0, 46),
				ClipsDescendants = true,
				Parent = parent,
			})
			Utility.Corner(10, holder)
			local sheen = Create("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.fromScale(0.4, 1),
				Parent = holder,
			})
			local Animator = import("Animator")
			Utility.Gradient(ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
				ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
				ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255)),
			}), 0, NumberSequence.new({
				NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.88), NumberSequenceKeypoint.new(1, 1),
			}), sheen)

			local running = true
			local function loop()
				if not running or not holder.Parent then return end
				sheen.Position = UDim2.new(-0.4, 0, 0, 0)
				local tween = Animator.Tween(sheen, { Position = UDim2.new(1, 0, 0, 0) }, 1.1, Animator.Easing.Sine, Enum.EasingDirection.InOut)
				tween.Completed:Once(function() if running then loop() end end)
			end
			loop()

			local api = { Instance = holder }
			function api.Destroy() running = false; holder:Destroy() end
			return api
		end
		Registry.Register("Skeleton", buildSkeleton, { "Skeleton" })

		return true
	end)

