local Toggle = (function()
	-- Toggle: switch control with a sliding knob and colour-tween state change.


	local Toggle = {}
	Toggle.__index = Toggle

	local SWITCH_W, SWITCH_H = 38, 20

	function Toggle.new(parent: Instance, props: { [string]: any }, context: { [string]: any })
		props = props or {}
		local Theme = context.Theme
		local self = setmetatable({}, Toggle)
		self._context = context
		self.Callback = props.Callback
		self.Value = props.Default == true

		local row = Row.new(parent, props, context, { ControlWidth = SWITCH_W })
		self.Root = row.Holder

		local switch = Creator.New("TextButton", {
			Name = "Switch",
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.fromOffset(SWITCH_W, SWITCH_H),
			BackgroundColor3 = self.Value and Theme.Get("Accent") or Theme.Get("Border"),
			AutoButtonColor = false,
			Text = "",
			ZIndex = 3,
			Parent = row.Holder,
		}, { Creator.Corner(999) })
		self.Switch = switch

		local knob = Creator.New("Frame", {
			Name = "Knob",
			AnchorPoint = Vector2.new(0, 0.5),
			Position = self.Value and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
			Size = UDim2.fromOffset(16, 16),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 4,
			Parent = switch,
		}, { Creator.Corner(999) })
		self.Knob = knob

		local function render(animated: boolean)
			local color = self.Value and Theme.Get("Accent") or Theme.Get("Border")
			local pos = self.Value and UDim2.new(1, -18, 0.5, 0) or UDim2.new(0, 2, 0.5, 0)
			if animated then
				Creator.Snap(switch, { BackgroundColor3 = color }, 0.15)
				Creator.Animate(knob, { Position = pos }, 0.18, Enum.EasingStyle.Back)
			else
				switch.BackgroundColor3 = color
				knob.Position = pos
			end
		end

		local function set(value: boolean, silent: boolean?)
			value = value == true
			if self.Value == value then
				return
			end
			self.Value = value
			render(true)
			if not silent and self.Callback then
				local ok, err = pcall(self.Callback, self.Value)
				if not ok then
					warn("[UILibrary] Toggle callback error: " .. tostring(err))
				end
			end
		end
		self.Set = function(_self, value, silent)
			set(value, silent)
		end
		self.Get = function(_self)
			return self.Value
		end

		local function activate()
			set(not self.Value)
		end

		switch.MouseButton1Click:Connect(activate)
		row.Holder.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				-- clicking anywhere on the row (not just the switch) toggles it
			end
		end)
		row.Title.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				activate()
			end
		end)

		if props.Flag and context.Config then
			context.Config:Register(props.Flag, {
				Get = function()
					return self.Value
				end,
				Set = function(value)
					-- config load should actually re-apply effects, not just
					-- silently sync the visual state
					set(value, false)
				end,
			})
		end

		if props.Default then
			if props.Callback then
				task.defer(function()
					local ok, err = pcall(self.Callback, self.Value)
					if not ok then
						warn("[UILibrary] Toggle initial callback error: " .. tostring(err))
					end
				end)
			end
		end

		return self
	end

	function Toggle:SetVisible(visible: boolean)
		self.Root.Visible = visible
	end

	function Toggle:OnChanged(fn: (boolean) -> ())
		local previous = self.Callback
		self.Callback = function(value)
			if previous then
				previous(value)
			end
			fn(value)
		end
	end

	function Toggle:Destroy()
		self.Root:Destroy()
	end

	return Toggle
end)()


