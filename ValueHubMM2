		-- ---------- Graph / Mini Chart (pure-Frame line & bar rendering) ----------
		local function buildChart(parent, opts, ctx)
			local colors = Theme.Get()
			local data = opts.Data or {}
			local height = opts.Height or 90
			local chartType = opts.Type or "Line"

			local card
			local host
			if opts.Title then
				card = Base.Card(parent, opts, { Inline = false, Hoverable = false })
				host = card.Body
			else
				host = parent
			end

			local canvas = Create("Frame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, height),
				Parent = host,
			})

			local api = { Instance = card and card.Root or canvas }

			local function render()
				for _, c in ipairs(canvas:GetChildren()) do c:Destroy() end
				if #data == 0 then return end
				local maxV, minV = math.max(table.unpack(data)), math.min(table.unpack(data))
				if maxV == minV then maxV += 1 end

				if chartType == "Bar" then
					local barGap = 4
					local barWidth = (1 / #data)
					for i, v in ipairs(data) do
						local pct = (v - minV) / (maxV - minV)
						local bar = Create("Frame", {
							BackgroundColor3 = opts.Color or colors.Accent,
							BackgroundTransparency = 0.1,
							AnchorPoint = Vector2.new(0, 1),
							Position = UDim2.new(barWidth * (i - 1), barGap / 2, 1, 0),
							Size = UDim2.new(barWidth, -barGap, math.max(pct, 0.03), 0),
							Parent = canvas,
						})
						Utility.Corner(3, bar)
					end
				else
					local points = {}
					for i, v in ipairs(data) do
						local x = (i - 1) / (#data - 1 > 0 and (#data - 1) or 1)
						local y = 1 - (v - minV) / (maxV - minV)
						points[i] = Vector2.new(x, y)
					end
					for i = 1, #points - 1 do
						local a, b = points[i], points[i + 1]
						local ax, ay = a.X * canvas.AbsoluteSize.X, a.Y * height
						local bx, by = b.X * canvas.AbsoluteSize.X, b.Y * height
						local dist = math.sqrt((bx - ax) ^ 2 + (by - ay) ^ 2)
						local angle = math.deg(math.atan2(by - ay, bx - ax))
						local segment = Create("Frame", {
							BackgroundColor3 = opts.Color or colors.Accent,
							AnchorPoint = Vector2.new(0, 0.5),
							Position = UDim2.new(a.X, 0, 0, ay),
							Size = UDim2.new(0, dist, 0, 2),
							Rotation = angle,
							Parent = canvas,
						})
						Utility.Corner(1, segment)
					end
					for _, p in ipairs(points) do
						local dot = Create("Frame", {
							BackgroundColor3 = opts.Color or colors.Accent,
							AnchorPoint = Vector2.new(0.5, 0.5),
							Position = UDim2.new(p.X, 0, 0, p.Y * height),
							Size = UDim2.fromOffset(5, 5),
							Parent = canvas,
						})
						Utility.Corner(3, dot)
					end
				end
			end
			render()

			function api.SetData(newData) data = newData; render() end
			function api.Destroy() (card and card.Root or canvas):Destroy() end
			return api
		end
		Registry.Register("Chart", buildChart, { "Graph" })
		Registry.Register("Chart", buildChart, { "MiniChart" }, { Height = 40 })

