			for _, row in ipairs(rows) do
				local r = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 18), Parent = holder })
				Create("TextLabel", {
					Text = row[1], Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = colors.SubText,
