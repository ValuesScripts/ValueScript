-- Module: Info -- static/dynamic text elements
----------------------------------------------------------------------------
local function BuildInfoTab()
	local Tab = Window:CreateTab({ Name = "Info", Icon = "lucide:info" })
	local Section = Tab:CreateSection({ Name = "About" })

	Section:CreateLabel({ Text = "UILibrary Demo", Bold = true })
	Section:CreateParagraph({
		Title = "What is this?",
		Content = "This tab shows Label, Paragraph and Divider -- plain display elements with no callback, useful for changelogs, instructions or credits.",
	})
	Section:CreateDivider()
	Section:CreateLabel({ Text = "Built with UILibrary v" .. UILibrary.Version, Muted = true })
end

----------------------------------------------------------------------------
-- Module: Settings -- built-in live theme editor + config save/load
----------------------------------------------------------------------------
local function BuildSettingsTab()
	local Tab = Window:CreateTab({ Name = "Settings", Icon = "lucide:settings" })

	local ThemeSection = Tab:CreateSection({ Name = "Theme" })
	UILibrary:CreateThemeEditor(ThemeSection)

	local ConfigSection = Tab:CreateSection({ Name = "Config" })

	ConfigSection:CreateButton({
		Title = "Save Config",
		Callback = function()
			if Window.ConfigManager:Save("default") then
				Window:Notify({ Title = "Config", Content = "Saved as 'default'.", Type = "Success" })
			else
				Window:Notify({ Title = "Config", Content = "Failed to save.", Type = "Error" })
			end
		end,
	})

	ConfigSection:CreateButton({
		Title = "Load Config",
		Callback = function()
			if Window.ConfigManager:Load("default") then
				Window:Notify({ Title = "Config", Content = "Loaded 'default'.", Type = "Info" })
			else
				Window:Notify({ Title = "Config", Content = "No saved config found.", Type = "Warning" })
			end
		end,
	})
end

-- Register every module here, in the order tabs should appear:
BuildMainTab()
BuildVisualsTab()
BuildKeybindsTab()
BuildInfoTab()
BuildSettingsTab()
