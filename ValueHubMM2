local ConfigManager = (function()
	-- Flag-based config system: every saveable element registers itself under
	-- a string "Flag" with Get/Set functions. Save serialises all flags to
	-- JSON; Load restores them and re-fires each element's callback.
	--
	-- Persistence is pluggable. By default it tries the de-facto executor
	-- file API (writefile/readfile/isfile/listfiles/makefolder), guarded by
	-- pcall so it degrades to in-memory-only (with a single warning) on
	-- platforms that don't expose it -- e.g. plain Roblox Studio/live game.
	-- Call ConfigManager.SetProvider(...) to back it with DataStoreService
	-- or any other store for a shipped game.

	local HttpService = game:GetService("HttpService")

	type FlagEntry = {
		Get: () -> any,
		Set: (value: any) -> (),
	}

	type Provider = {
		Save: (folder: string, name: string, data: string) -> boolean,
		Load: (folder: string, name: string) -> string?,
		List: (folder: string) -> { string },
		Delete: (folder: string, name: string) -> boolean,
		Exists: (folder: string, name: string) -> boolean,
	}

	local ConfigManager = {}
	ConfigManager.__index = ConfigManager

	local warnedNoProvider = false

	local function fileProviderAvailable(): boolean
		-- Reading an undeclared global is nil in Luau (not an error), so this
		-- is safe to check directly across Studio, live games, and executors.
		local ok, result = pcall(function()
			return typeof(writefile) == "function"
				and typeof(readfile) == "function"
				and typeof(isfile) == "function"
				and typeof(isfolder) == "function"
				and typeof(makefolder) == "function"
		end)
		return ok and result == true
	end

	-- Executor-file backed provider. Every call is pcall-wrapped: some
	-- executors implement a subset of the API, and Studio implements none of it.
	local FileProvider: Provider = {
		Save = function(folder, name, data)
			local ok = pcall(function()
				if not isfolder(folder) then
					makefolder(folder)
				end
				writefile(folder .. "/" .. name .. ".json", data)
			end)
			return ok
		end,
		Load = function(folder, name)
			local ok, result = pcall(function()
				local path = folder .. "/" .. name .. ".json"
				if isfile(path) then
					return readfile(path)
				end
				return nil
			end)
			if ok then
				return result
			end
			return nil
		end,
		List = function(folder)
			local ok, result = pcall(function()
				local names = {}
				if isfolder(folder) then
					for _, path in ipairs(listfiles(folder)) do
						local name = path:match("([^/\\]+)%.json$")
						if name then
							table.insert(names, name)
						end
					end
				end
				return names
			end)
			if ok then
				return result
			end
			return {}
		end,
		Delete = function(folder, name)
			local ok = pcall(function()
				local path = folder .. "/" .. name .. ".json"
				if isfile(path) then
					delfile(path)
				end
			end)
			return ok
		end,
		Exists = function(folder, name)
			local ok, result = pcall(function()
				return isfile(folder .. "/" .. name .. ".json")
			end)
			return ok and result == true
		end,
	}

	-- No-op provider used when no file API is present. Keeps everything
	-- working in-memory for the session instead of erroring.
	local MemoryStore: { [string]: { [string]: string } } = {}
	local MemoryProvider: Provider = {
		Save = function(folder, name, data)
			MemoryStore[folder] = MemoryStore[folder] or {}
			MemoryStore[folder][name] = data
			return true
		end,
		Load = function(folder, name)
			local bucket = MemoryStore[folder]
			return bucket and bucket[name] or nil
		end,
		List = function(folder)
			local bucket = MemoryStore[folder]
			local names = {}
			if bucket then
				for name in pairs(bucket) do
					table.insert(names, name)
				end
			end
			return names
		end,
		Delete = function(folder, name)
			local bucket = MemoryStore[folder]
			if bucket then
				bucket[name] = nil
			end
			return true
		end,
		Exists = function(folder, name)
			local bucket = MemoryStore[folder]
			return bucket ~= nil and bucket[name] ~= nil
		end,
	}

	function ConfigManager.new(folderName: string)
		local self = setmetatable({}, ConfigManager)
		self.Folder = folderName
		self.Flags = {} :: { [string]: FlagEntry }
		self.Provider = if fileProviderAvailable() then FileProvider else MemoryProvider
		self.Changed = Signal.new()

		if self.Provider == MemoryProvider and not warnedNoProvider then
			warnedNoProvider = true
			warn("[UILibrary] No file API detected -- configs will persist for this session only. Call ConfigManager:SetProvider() to back saves with DataStoreService or another store.")
		end

		return self
	end

	function ConfigManager:SetProvider(provider: Provider)
		self.Provider = provider
	end

	-- Called by elements (Toggle, Slider, Dropdown, Textbox, Keybind,
	-- ColorPicker) when constructed with a Flag.
	function ConfigManager:Register(flag: string, entry: FlagEntry)
		if self.Flags[flag] then
			warn("[UILibrary] Duplicate config flag: " .. flag)
		end
		self.Flags[flag] = entry
	end

	function ConfigManager:Unregister(flag: string)
		self.Flags[flag] = nil
	end

	function ConfigManager:GatherValues(): { [string]: any }
		local values = {}
		for flag, entry in pairs(self.Flags) do
			local ok, value = pcall(entry.Get)
			if ok then
				values[flag] = value
			end
		end
		return values
	end

	function ConfigManager:Save(name: string): boolean
		local values = self:GatherValues()
		local ok, encoded = pcall(function()
			return HttpService:JSONEncode(values)
		end)
		if not ok then
			warn("[UILibrary] Failed to encode config: " .. tostring(encoded))
			return false
		end
		local saved = self.Provider.Save(self.Folder, name, encoded)
		if saved then
			self.Changed:Fire("Saved", name)
		end
		return saved
	end

	function ConfigManager:Load(name: string): boolean
		local raw = self.Provider.Load(self.Folder, name)
		if not raw then
			return false
		end
		local ok, decoded = pcall(function()
			return HttpService:JSONDecode(raw)
		end)
		if not ok or typeof(decoded) ~= "table" then
			warn("[UILibrary] Failed to decode config: " .. name)
			return false
		end
		for flag, value in pairs(decoded) do
			local entry = self.Flags[flag]
			if entry then
				local setOk, err = pcall(entry.Set, value)
				if not setOk then
					warn(string.format("[UILibrary] Failed to apply flag '%s': %s", flag, tostring(err)))
				end
			end
		end
		self.Changed:Fire("Loaded", name)
		return true
	end

	function ConfigManager:Delete(name: string): boolean
		return self.Provider.Delete(self.Folder, name)
	end

	function ConfigManager:Exists(name: string): boolean
		return self.Provider.Exists(self.Folder, name)
	end

	function ConfigManager:List(): { string }
		return self.Provider.List(self.Folder)
	end

	function ConfigManager:SaveAutoload(name: string)
		self.Provider.Save(self.Folder, "__autoload", name)
	end

	function ConfigManager:GetAutoload(): string?
		return self.Provider.Load(self.Folder, "__autoload")
	end

	return ConfigManager
end)()


