local Slider = (function()
	-- Slider: drag (mouse + touch) or click-to-set, with Min/Max/Step and a
	-- live value readout. Only listens to global InputChanged while the
	-- pointer is actually down -- no polling loop when idle.

	local UserInputService = game:GetService("UserInputService")

	local Slider = {}
	Slider.__index = Slider

	local function isPointer(inputType: Enum.UserInputType): boolean
		return inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch
	end

	function Slider.new(parent: Instance, props: { [string]: any }, context: { [string]: any })
		props = props or {}
		local Theme = context.Theme
		local self = setmetatable({}, Slider)
		self._context = context
		self.Callback = props.Callback
		self.Min = props.Min or 0
		self.Max = props.Max or 100
		self.Rounding = props.Rounding or 0
		self.Suffix = props.Suffix or ""
		self.Value = math.clamp(props.Default or self.Min, self.Min, self.Max)

		local root = Creator.New("Frame", {
			Name = (props.Title or "Slider") .. "Slider",
			Size = UDim2.new(1, 0, 0, 46),
			BackgroundColor3 = Theme.Get("Tertiary"),
			LayoutOrder = props.LayoutOrder or 0,
			Visible = props.Visible ~= false,
			ZIndex = 2,
			Parent = parent,
		}, { Creator.Corner(6), Creator.Padding(8, 8, 10, 8, 10) })
		Theme.Register(root, { BackgroundColor3 = "Tertiary" })
		self.Root = root

		if props.Tooltip and context.Tooltip then
			context.Tooltip:Bind(root, props.Tooltip)
		end

		local title = Creator.New("TextLabel", {
			Name = "Title",
			Size = UDim2.new(1, -70, 0, 16),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamMedium,
			Text = props.Title or "",
			TextSize = 13,
			TextColor3 = Theme.Get("Text"),
			TextXAlignment = Enum.TextXAlignment.Left,
			ZIndex = 3,
			Parent = root,
		})
		Theme.Register(title, { TextColor3 = "Text" })

		local valueLabel = Creator.New("TextLabel", {
			Name = "Value",
			AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.new(1, 0, 0, 0),
			Size = UDim2.fromOffset(70, 16),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamMedium,
			Text = tostring(self.Value) .. self.Suffix,
			TextSize = 13,
			TextColor3 = Theme.Get("Accent"),
			TextXAlignment = Enum.TextXAlignment.Right,
			ZIndex = 3,
			Parent = root,
		})
		Theme.Register(valueLabel, { TextColor3 = "Accent" })
		self.ValueLabel = valueLabel

		local track = Creator.New("Frame", {
			Name = "Track",
			Position = UDim2.new(0, 0, 0, 24),
			Size = UDim2.new(1, 0, 0, 8),
			BackgroundColor3 = Theme.Get("Border"),
			ZIndex = 3,
			Parent = root,
		}, { Creator.Corner(4) })
		Theme.Register(track, { BackgroundColor3 = "Border" })
		self.Track = track

		local function fraction(value: number): number
			if self.Max == self.Min then
				return 0
			end
			return (value - self.Min) / (self.Max - self.Min)
		end

		local fill = Creator.New("Frame", {
			Name = "Fill",
			Size = UDim2.new(fraction(self.Value), 0, 1, 0),
			BackgroundColor3 = Theme.Get("Accent"),
			ZIndex = 4,
			Parent = track,
		}, { Creator.Corner(4) })
		Theme.Register(fill, { BackgroundColor3 = "Accent" })
		self.Fill = fill

		local knob = Creator.New("Frame", {
			Name = "Knob",
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(1, 0, 0.5, 0),
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 5,
			Parent = fill,
		}, { Creator.Corner(999), Creator.Stroke({ Color = Theme.Get("Accent"), Thickness = 2 }) })
		local knobStroke = knob:FindFirstChildOfClass("UIStroke")
		if knobStroke then
			Theme.Register(knobStroke, { Color = "Accent" })
		end

		local function roundValue(v: number): number
			if self.Rounding <= 0 then
				return math.round(v)
			end
			local mult = 10 ^ self.Rounding
			return math.round(v * mult) / mult
		end

		local function render(value: number, animated: boolean)
			local frac = fraction(value)
			if animated then
				Creator.Snap(fill, { Size = UDim2.new(frac, 0, 1, 0) }, 0.08)
			else
				fill.Size = UDim2.new(frac, 0, 1, 0)
			end
			local decimals = self.Rounding
			valueLabel.Text = (decimals > 0 and string.format("%." .. decimals .. "f", value) or tostring(math.floor(value)))
				.. self.Suffix
		end

		local function set(value: number, silent: boolean?, animated: boolean?)
			value = roundValue(math.clamp(value, self.Min, self.Max))
			if self.Value == value then
				return
			end
			self.Value = value
			render(value, animated ~= false)
			if not silent and self.Callback then
				local ok, err = pcall(self.Callback, self.Value)
				if not ok then
					warn("[UILibrary] Slider callback error: " .. tostring(err))
				end
			end
		end
		self.Set = function(_self, value, silent)
			set(value, silent, false)
		end
		self.Get = function(_self)
			return self.Value
		end

		local dragging = false
		local dragConn: RBXScriptConnection? = nil

		local function updateFromX(x: number)
			local abs = track.AbsolutePosition.X
			local size = track.AbsoluteSize.X
			local frac = math.clamp((x - abs) / size, 0, 1)
			set(self.Min + frac * (self.Max - self.Min), false, false)
		end

		local function beginDrag(input: InputObject)
			if not isPointer(input.UserInputType) then
				return
			end
			dragging = true
			updateFromX(input.Position.X)
			dragConn = UserInputService.InputChanged:Connect(function(moveInput)
				if dragging and (moveInput.UserInputType == Enum.UserInputType.MouseMovement or moveInput.UserInputType == Enum.UserInputType.Touch) then
					updateFromX(moveInput.Position.X)
				end
			end)
		end

		local function endDrag()
			if dragging then
				dragging = false
				if dragConn then
					dragConn:Disconnect()
					dragConn = nil
				end
			end
		end

		track.InputBegan:Connect(beginDrag)
		UserInputService.InputEnded:Connect(function(input)
			if isPointer(input.UserInputType) then
				endDrag()
			end
		end)

		if props.Flag and context.Config then
			context.Config:Register(props.Flag, {
				Get = function()
					return self.Value
				end,
				Set = function(value)
					-- config load should actually re-apply effects, not just
					-- silently sync the visual state
					set(value, false, false)
				end,
			})
		end

		return self
	end

	function Slider:OnChanged(fn: (number) -> ())
		local previous = self.Callback
		self.Callback = function(value)
			if previous then
				previous(value)
			end
			fn(value)
		end
	end

	function Slider:SetVisible(visible: boolean)
		self.Root.Visible = visible
	end

	function Slider:Destroy()
		self.Root:Destroy()
	end

	return Slider
end)()


local Dropdown = (function()
