	register("Component_Toggle", function(import)
		local Utility = import("Utility")
		local Animator = import("Animator")
		local Theme = import("Theme")
		local Base = import("ComponentBase")
		local Registry = import("ComponentRegistry")
		local Config = import("Config")
		local Icons = import("Icons")
		local Create = Utility.Create

		local radioGroups = {}

		local function build(parent, opts, ctx)
			local style = opts.Style or "Switch"
			local colors = Theme.Get()
			local controlSize = (style == "Switch") and UDim2.fromOffset(42, 24) or UDim2.fromOffset(22, 22)

			local card = Base.Card(parent, opts, { Inline = true, ControlSize = controlSize })
			local holder = card.Control
			local state = (opts.Default == true)

			local track, knob, box, checkIcon, dot

			if style == "Switch" then
				track = Create("Frame", {
					BackgroundColor3 = state and colors.Accent or colors.MutedText,
					BackgroundTransparency = state and 0.1 or 0.75,
					Size = UDim2.fromScale(1, 1),
					Parent = holder,
				})
				Utility.Corner(12, track)
				knob = Create("Frame", {
					BackgroundColor3 = Color3.fromRGB(255, 255, 255),
					Size = UDim2.fromOffset(18, 18),
					Position = state and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0),
					AnchorPoint = Vector2.new(0, 0.5),
					Parent = track,
				})
				Utility.Corner(9, knob)
				Utility.Shadow({ Transparency = 0.7, Spread = 6 }, knob)
			elseif style == "Radio" then
				track = Create("Frame", {
					BackgroundTransparency = 1,
					Size = UDim2.fromScale(1, 1),
					Parent = holder,
				})
				Utility.Corner(11, track)
				Utility.Stroke({ Color = state and colors.Accent or colors.MutedText, Thickness = 2, Transparency = 0.2 }, track)
				dot = Create("Frame", {
					BackgroundColor3 = colors.Accent,
					Size = state and UDim2.fromOffset(12, 12) or UDim2.fromOffset(0, 0),
					Position = UDim2.fromScale(0.5, 0.5),
					AnchorPoint = Vector2.new(0.5, 0.5),
					Parent = track,
				})
				Utility.Corner(6, dot)
			else -- Checkbox
				track = Create("Frame", {
					BackgroundColor3 = state and colors.Accent or colors.Elevated,
					BackgroundTransparency = state and 0 or 0.1,
					Size = UDim2.fromScale(1, 1),
					Parent = holder,
				})
				Utility.Corner(7, track)
				Utility.Stroke({ Color = state and colors.Accent or colors.MutedText, Thickness = 1.5, Transparency = state and 0 or 0.35 }, track)
				checkIcon = Create("ImageLabel", {
					ImageColor3 = Color3.fromRGB(255, 255, 255),
					ImageTransparency = state and 0 or 1,
					BackgroundTransparency = 1,
					Size = UDim2.fromOffset(12, 12),
					Position = UDim2.fromScale(0.5, 0.5),
					AnchorPoint = Vector2.new(0.5, 0.5),
					Parent = track,
				})
				Icons.Apply(checkIcon, Icons.Check)
			end

			local hitbox = Create("TextButton", {
				Text = "",
				AutoButtonColor = false,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 1, 0),
				ZIndex = 5,
				Parent = card.Header,
			})

			local api = {}
			api.Changed = import("Signal").new()
			api.Instance = card.Root

			local suppressCallback = false

			local function applyVisual(value, animate)
				local tweenFn = animate and Animator.Snap or function(inst, props) for k, v in pairs(props) do inst[k] = v end end
				if style == "Switch" then
					tweenFn(track, { BackgroundColor3 = value and colors.Accent or colors.MutedText, BackgroundTransparency = value and 0.1 or 0.75 }, 0.22)
					if animate then
						Animator.Tween(knob, { Position = value and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0) }, 0.22, Animator.Easing.Back, Enum.EasingDirection.Out)
					else
						knob.Position = value and UDim2.new(1, -21, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
					end
				elseif style == "Radio" then
					local stroke = track:FindFirstChildOfClass("UIStroke")
					if stroke then tweenFn(stroke, { Color = value and colors.Accent or colors.MutedText }, 0.18) end
					tweenFn(dot, { Size = value and UDim2.fromOffset(12, 12) or UDim2.fromOffset(0, 0) }, 0.18)
				else
					tweenFn(track, { BackgroundColor3 = value and colors.Accent or colors.Elevated, BackgroundTransparency = value and 0 or 0.1 }, 0.18)
					local stroke = track:FindFirstChildOfClass("UIStroke")
					if stroke then tweenFn(stroke, { Color = value and colors.Accent or colors.MutedText, Transparency = value and 0 or 0.35 }, 0.18) end
					tweenFn(checkIcon, { ImageTransparency = value and 0 or 1 }, 0.15)
				end
			end

			local function setState(value, silent, animate)
				if style == "Radio" and value == false and state == false then return end
				state = value
				applyVisual(value, animate ~= false)
				if style == "Radio" and value and opts.Group then
					local group = radioGroups[opts.Group]
					if group then
						for _, other in ipairs(group) do
							if other ~= api then other._setSilent(false) end
						end
					end
				end
				if not silent then
					if opts.Callback then task.spawn(opts.Callback, value) end
					api.Changed:Fire(value)
					if opts.Flag then Config.Set(opts.Flag, value) end
				end
			end

			api._setSilent = function(v) setState(v, true, true) end

			hitbox.MouseButton1Click:Connect(function()
				if style == "Radio" then
					setState(true, false, true)
				else
					setState(not state, false, true)
				end
			end)

			function api.Set(value, silent) setState(value, silent) end
			function api.Get() return state end
			function api.Destroy() card.Root:Destroy() end

			if opts.Group and style == "Radio" then
				radioGroups[opts.Group] = radioGroups[opts.Group] or {}
				table.insert(radioGroups[opts.Group], api)
			end

			if opts.Flag then
				Config.Register(opts.Flag, state, function(value) setState(value, true, false) end)
			end

			return api
		end

		Registry.Register("Toggle", build, { "Toggle" })
		Registry.Register("Toggle", build, { "Switch" }, { Style = "Switch" })
		Registry.Register("Toggle", build, { "Checkbox" }, { Style = "Checkbox" })
		Registry.Register("Toggle", build, { "Radio" }, { Style = "Radio" })
		return build
	end)

