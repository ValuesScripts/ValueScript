	register("Component_Slider", function(import)
		local Utility = import("Utility")
		local Animator = import("Animator")
		local Theme = import("Theme")
		local Base = import("ComponentBase")
		local Registry = import("ComponentRegistry")
		local Config = import("Config")
		local UserInputService = game:GetService("UserInputService")
		local Create = Utility.Create

		local function build(parent, opts, ctx)
			local colors = Theme.Get()
			local min = opts.Min or 0
			local max = opts.Max or 100
			local increment = opts.Increment or opts.Step or 1
			local suffix = opts.Suffix or ""
			local value = Utility.Clamp(opts.Default or min, min, max)

			local card = Base.Card(parent, opts, { Inline = false, ValueLabel = true })
			card.Value.Text = tostring(Utility.Round(value, 2)) .. suffix

			local trackHolder = Create("Frame", {
				Name = "TrackHolder",
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 20),
				Parent = card.Body,
			})

			local track = Create("Frame", {
				Name = "Track",
				BackgroundColor3 = colors.MutedText,
				BackgroundTransparency = 0.75,
				Size = UDim2.new(1, 0, 0, 6),
				Position = UDim2.new(0, 0, 0.5, 0),
				AnchorPoint = Vector2.new(0, 0.5),
				Parent = trackHolder,
			})
			Utility.Corner(3, track)

			local function pctOf(v) return (v - min) / (max - min) end

			local fill = Create("Frame", {
				Name = "Fill",
				BackgroundColor3 = colors.Accent,
				Size = UDim2.new(pctOf(value), 0, 1, 0),
				Parent = track,
			})
			Utility.Corner(3, fill)

			local knob = Create("Frame", {
				Name = "Knob",
				BackgroundColor3 = Color3.fromRGB(255, 255, 255),
				Size = UDim2.fromOffset(15, 15),
				Position = UDim2.new(pctOf(value), 0, 0.5, 0),
				AnchorPoint = Vector2.new(0.5, 0.5),
				ZIndex = 2,
				Parent = track,
			})
			Utility.Corner(8, knob)
			Utility.Shadow({ Transparency = 0.65, Spread = 8 }, knob)

			local hitbox = Create("TextButton", {
				Text = "",
				AutoButtonColor = false,
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 0, 20),
				Parent = trackHolder,
			})

			local api = {}
			api.Changed = import("Signal").new()
			api.Instance = card.Root

			local function updateVisual(v, animate)
				local pct = pctOf(v)
				if animate then
					Animator.Snap(fill, { Size = UDim2.new(pct, 0, 1, 0) }, 0.12)
					Animator.Snap(knob, { Position = UDim2.new(pct, 0, 0.5, 0) }, 0.12)
				else
					fill.Size = UDim2.new(pct, 0, 1, 0)
					knob.Position = UDim2.new(pct, 0, 0.5, 0)
				end
				card.Value.Text = tostring(Utility.Round(v, 2)) .. suffix
			end

			local function setValue(v, silent, animate)
				v = Utility.Clamp(v, min, max)
				v = math.floor((v - min) / increment + 0.5) * increment + min
				v = Utility.Round(Utility.Clamp(v, min, max), 4)
				value = v
				updateVisual(v, animate)
				if not silent then
					if opts.Callback then task.spawn(opts.Callback, v) end
					api.Changed:Fire(v)
					if opts.Flag then Config.Set(opts.Flag, v) end
				end
			end

			local dragging = false
			local function fromScreenX(x)
				local pct = Utility.Clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
				setValue(min + pct * (max - min), false, false)
			end

			hitbox.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					Animator.Snap(knob, { Size = UDim2.fromOffset(18, 18) }, 0.12)
					fromScreenX(input.Position.X)
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					fromScreenX(input.Position.X)
				end
			end)

			UserInputService.InputEnded:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
					dragging = false
					Animator.Snap(knob, { Size = UDim2.fromOffset(15, 15) }, 0.15)
				end
			end)

			function api.Set(v, silent) setValue(v, silent, true) end
			function api.Get() return value end
			function api.Destroy() card.Root:Destroy() end

			if opts.Flag then
				Config.Register(opts.Flag, value, function(v) setValue(v, true, true) end)
			end

			return api
		end

		Registry.Register("Slider", build, { "Slider" })
		return build
	end)

