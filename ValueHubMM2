local Tooltip = (function()
	-- Tooltip manager: one shared floating label reused for every bound
	-- element (no per-element instance) -- hover on PC, long-press on mobile.

	local UserInputService = game:GetService("UserInputService")

	local Tooltip = {}
	Tooltip.__index = Tooltip

	function Tooltip.new(screenGui: ScreenGui)
		local self = setmetatable({}, Tooltip)

		local label = Creator.New("TextLabel", {
			Name = "TooltipLabel",
			BackgroundColor3 = Themes.Get("Elevated"),
			AutomaticSize = Enum.AutomaticSize.XY,
			Size = UDim2.fromOffset(0, 0),
			Font = Enum.Font.Gotham,
			Text = "",
			TextSize = 12,
			TextColor3 = Themes.Get("Text"),
			TextWrapped = true,
			Visible = false,
			ZIndex = 1000,
			Parent = screenGui,
		}, {
			Creator.Corner(6),
			Creator.Stroke({ Color = Themes.Get("Border"), Thickness = 1 }),
			Creator.Padding(6, 6, 8, 6, 8),
		})
		Themes.Register(label, { BackgroundColor3 = "Elevated", TextColor3 = "Text" })
		local stroke = label:FindFirstChildOfClass("UIStroke")
		if stroke then
			Themes.Register(stroke, { Color = "Border" })
		end
		label.TextTransparency = 1
		self.Label = label
		self.ScreenGui = screenGui

		return self
	end

	function Tooltip:_show(text: string, x: number, y: number)
		self.Label.Text = text
		self.Label.Position = UDim2.fromOffset(x + 14, y + 14)
		self.Label.Visible = true
		Creator.Snap(self.Label, { TextTransparency = 0, BackgroundTransparency = 0 }, 0.12)
	end

	function Tooltip:_hide()
		if not self.Label.Visible then
			return
		end
		local tween = Creator.Snap(self.Label, { TextTransparency = 1, BackgroundTransparency = 1 }, 0.1)
		tween.Completed:Connect(function()
			if self.Label.TextTransparency >= 1 then
				self.Label.Visible = false
			end
		end)
	end

	-- Binds a tooltip to `instance`. Returns a disconnect function.
	function Tooltip:Bind(instance: GuiObject, text: string)
		local conns = {}

		table.insert(
			conns,
			instance.MouseEnter:Connect(function()
				local pos = UserInputService:GetMouseLocation()
				self:_show(text, pos.X, pos.Y - 36)
			end)
		)
		table.insert(
			conns,
			instance.MouseMoved:Connect(function(x, y)
				if self.Label.Visible then
					self.Label.Position = UDim2.fromOffset(x + 14, y + 14)
				end
			end)
		)
		table.insert(
			conns,
			instance.MouseLeave:Connect(function()
				self:_hide()
			end)
		)

		-- mobile: long press
		local pressStart = 0
		table.insert(
			conns,
			instance.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.Touch then
					pressStart = os.clock()
					task.delay(0.45, function()
						if pressStart ~= 0 and os.clock() - pressStart >= 0.45 then
							local pos = input.Position
							self:_show(text, pos.X, pos.Y - 50)
						end
					end)
				end
			end)
		)
		table.insert(
			conns,
			instance.InputEnded:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.Touch then
					pressStart = 0
					self:_hide()
				end
			end)
		)

		return function()
			for _, conn in ipairs(conns) do
				conn:Disconnect()
			end
		end
	end

	function Tooltip:Destroy()
		self.Label:Destroy()
	end

	return Tooltip
end)()


