	end)

	--============================================================================
	-- MODULE: Init
	-- Bootstraps the whole library: creates the root ScreenGui, eagerly
	-- imports every component builder (so ComponentRegistry is fully
	-- populated before user code runs), assembles the shared context object,
	-- wires the global toggle keybind + mobile floating button, and returns
	-- the public Library table (Window/Notification/Config/Theme API).
	--============================================================================

	register("Init", function(import)

		local Utility = import("Utility")
		local Theme = import("Theme")
		local Animator = import("Animator")
		local Icons = import("Icons")
		local Acrylic = import("Acrylic")
		local Draggable = import("Draggable")
		local Input = import("Input")
		local Config = import("Config")
		local Notifications = import("Notifications")
		local Registry = import("ComponentRegistry")
		local Overlays = import("Overlays")
		local WindowModule = import("Window")
		local SectionModule = import("Section")
		local Signal = import("Signal")
		local UserInputService = game:GetService("UserInputService")

		-- Eagerly import every component builder so Registry.Methods is fully
		-- populated (Section:CreateToggle, :CreateSlider, ...) before any user
		-- code has a chance to call it.
		local componentModules = {
			"Component_Button", "Component_Toggle", "Component_Slider", "Component_Textbox",
			"Component_Dropdown", "Component_Keybind", "Component_ColorPicker", "Component_Text",
			"Component_Loaders", "Component_Media", "Component_Indicators", "Component_DataDisplay",
			"Component_Diagnostics", "Component_Extra",
		}
		for _, name in ipairs(componentModules) do
			import(name)
		end
		SectionModule._InstallMethods()

		local root = Utility.Create("ScreenGui", {
			Name = "AuraLibrary",
			ResetOnSpawn = false,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
			DisplayOrder = 999,
			IgnoreGuiInset = true,
			Parent = Utility.GetGuiParent(),
		})
		Utility.ProtectGui(root)

		Notifications.Init(root)

		local ctx = {
			Theme = Theme, Animator = Animator, Utility = Utility, Icons = Icons,
			Acrylic = Acrylic, Draggable = Draggable, Input = Input, Config = Config,
			Notifications = Notifications, Registry = Registry, Root = root, Overlays = Overlays,
		}

		local Library = {}
		Library.Theme = Theme
		Library.Notifications = Notifications
		Library.Config = Config
		Library.Input = Input
		Library.Root = root
		Library._Windows = {}

		function Library:CreateWindow(opts)
			opts = opts or {}
			if opts.Theme then Theme.Set(opts.Theme) end
			local window = WindowModule.new(root, opts, ctx)
			table.insert(self._Windows, window)
			return window
		end

		function Library:SetTheme(name) return Theme.Set(name) end
		function Library:RegisterTheme(name, colors, activate) Theme.Register(name, colors, activate) end
		function Library:ExportTheme(name) return Theme.Export(name) end
		function Library:ImportTheme(name, data, activate) return Theme.Import(name, data, activate) end
		function Library:ListThemes() return Theme.List() end

		function Library:Notify(opts) return Notifications.Notify(opts) end
		function Library:Promise(executor, opts) return Notifications.Promise(executor, opts) end

		function Library:ToggleAll()
			for _, w in ipairs(self._Windows) do w:Toggle() end
		end
		function Library:ShowAll()
			for _, w in ipairs(self._Windows) do w:Show() end
		end
		function Library:HideAll()
			for _, w in ipairs(self._Windows) do w:Hide() end
		end

		function Library:CreateModal(opts) return Overlays.Modal(root, opts) end
		function Library:Confirm(opts) return Overlays.Confirm(root, opts) end
		function Library:CreatePopup(opts) return Overlays.Popup(root, opts) end
		function Library:CreateContextMenu(x, y, items) return Overlays.ContextMenu(root, x, y, items) end
		function Library:AttachContextMenu(target, items) return Overlays.AttachContextMenu(root, target, items) end
		function Library:CreateCommandPalette(opts) return Overlays.CommandPalette(root, opts, ctx) end

		function Library:SetToggleKeybind(key, modifiers) Input.SetToggleKeybind(key, modifiers) end
		function Library:IsMobile() return Input.IsMobile() end

		function Library:SaveConfig(name) return Config.Save(name) end
		function Library:LoadConfig(name) return Config.Load(name) end
		function Library:SetAutoSave(enabled, name) Config.SetAutoSave(enabled, name) end
		function Library:SetLoadOnStartup(name) return Config.SetLoadOnStartup(name) end
		function Library:ExportConfig() return Config.Export() end
		function Library:ImportConfig(json, activate) return Config.Import(json, activate) end
		function Library:CopyConfig() return Config.CopyToClipboard() end
		function Library:PasteConfig() return Config.LoadFromClipboard() end
		function Library:ListConfigs() return Config.ListConfigs() end

		function Library:Destroy()
			for _, w in ipairs(self._Windows) do
				w:Destroy()
			end
			root:Destroy()
		end

		Input.ToggleRequested:Connect(function()
			Library:ToggleAll()
		end)

		-- ---------- Mobile floating toggle button ----------
		if Input.IsMobile() then
			local colors = Theme.Get()
			local mobileBtn = Utility.Create("TextButton", {
				Name = "MobileToggle",
				Text = "",
				BackgroundColor3 = colors.Accent,
				AutoButtonColor = false,
				Size = UDim2.fromOffset(54, 54),
				Position = UDim2.new(1, -74, 0.5, 0),
				AnchorPoint = Vector2.new(0.5, 0.5),
				ZIndex = 1000,
				Parent = root,
			})
			Utility.Corner(1000, mobileBtn)
			Utility.Shadow({ Transparency = 0.4, Spread = 22 }, mobileBtn)

			local hamburgerIcon = Utility.Create("ImageLabel", {
				ImageColor3 = Color3.new(1, 1, 1),
				BackgroundTransparency = 1,
				Size = UDim2.fromOffset(22, 22),
				Position = UDim2.fromScale(0.5, 0.5),
				AnchorPoint = Vector2.new(0.5, 0.5),
				ZIndex = 1001,
				Parent = mobileBtn,
			})
			Icons.Apply(hamburgerIcon, Icons.Menu)

			local dragging, startPos, startInputPos, totalDelta = false, nil, nil, 0

			mobileBtn.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
					dragging = true
					totalDelta = 0
					startInputPos = input.Position
					startPos = mobileBtn.Position
				end
			end)

			UserInputService.InputChanged:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
					local delta = input.Position - startInputPos
					totalDelta = math.max(totalDelta, delta.Magnitude)
					mobileBtn.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
				end
			end)

			UserInputService.InputEnded:Connect(function(input)
				if dragging and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
					dragging = false
					if totalDelta < 6 then
						Library:ToggleAll()
					else
						local viewport = root.AbsoluteSize
						local centerX = mobileBtn.AbsolutePosition.X + mobileBtn.AbsoluteSize.X / 2
						local snapLeft = centerX < viewport.X / 2
						local targetX = snapLeft and (mobileBtn.AbsoluteSize.X / 2 + 10) or (viewport.X - mobileBtn.AbsoluteSize.X / 2 - 10)
						local targetY = Utility.Clamp(mobileBtn.AbsolutePosition.Y + mobileBtn.AbsoluteSize.Y / 2, 50, viewport.Y - 50)
						Animator.Open(mobileBtn, { Position = UDim2.fromOffset(targetX, targetY) }, 0.32)
					end
				end
			end)

			function Library:SetMobileButtonOpacity(alpha)
				mobileBtn.BackgroundTransparency = 1 - Utility.Clamp(alpha, 0, 1)
			end
		end

		-- Config auto-load: deferred so the developer's UI-construction code
		-- (which registers every component's Flag/default/setter) finishes
		-- running first, within the same synchronous thread, before saved
		-- values are applied on top of them.
		task.defer(function()
			pcall(function() Config.AutoLoad() end)
		end)

		return Library
	end)

	return import("Init")
end)()

return AuraLibrary
