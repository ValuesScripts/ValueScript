--[[
	UILibrary -- single-file bundle. Generated from the modular source;
	see README.md for the source-of-truth module layout.

	Usage (Studio / ModuleScript):
		local UILibrary = require(path.to.UILibrary)

	Usage (executor, if you host this file yourself):
		local UILibrary = loadstring(game:HttpGet("<your raw url>"))()
]]


local Signal = (function()
	-- Lightweight event object. Avoids BindableEvent overhead (no engine marshalling)
	-- for purely in-Lua pub/sub used throughout the library.

	local Signal = {}
	Signal.__index = Signal

	type Connection = {
		Connected: boolean,
		Disconnect: (self: Connection) -> (),
		Destroy: (self: Connection) -> (),
	}

	type Signal = typeof(setmetatable(
		{} :: { _handlers: { { Callback: (...any) -> (), Connected: boolean } } },
		Signal
	))

	function Signal.new(): Signal
		return setmetatable({
			_handlers = {},
		}, Signal) :: any
	end

	function Signal.Connect(self: Signal, fn: (...any) -> ()): Connection
		local handler = { Callback = fn, Connected = true }
		table.insert(self._handlers, handler)

		local connection = {} :: Connection
		connection.Connected = true
		connection.Disconnect = function(_self)
			if not handler.Connected then
				return
			end
			handler.Connected = false
			connection.Connected = false
			local index = table.find(self._handlers, handler)
			if index then
				table.remove(self._handlers, index)
			end
		end
		connection.Destroy = connection.Disconnect
		return connection
	end

	function Signal.Once(self: Signal, fn: (...any) -> ()): Connection
		local connection: Connection
		connection = self:Connect(function(...)
			connection:Disconnect()
			fn(...)
		end)
		return connection
	end

	function Signal.Wait(self: Signal): ...any
		local thread = coroutine.running()
		local connection: Connection
		connection = self:Connect(function(...)
			connection:Disconnect()
			task.spawn(thread, ...)
		end)
		return coroutine.yield()
	end

	function Signal.Fire(self: Signal, ...: any)
		-- clone so a handler disconnecting mid-fire doesn't shift indices under us
		local handlers = table.clone(self._handlers)
		for _, handler in ipairs(handlers) do
			if handler.Connected then
				local ok, err = pcall(handler.Callback, ...)
				if not ok then
					warn("[UILibrary] Signal handler error: " .. tostring(err))
				end
			end
		end
	end

	function Signal.DisconnectAll(self: Signal)
		table.clear(self._handlers)
	end

	return Signal
end)()


local Creator = (function()
	-- Instance construction + animation helpers shared by every component.
	-- Centralising this keeps allocation patterns consistent and cheap:
	-- one New() call per instance, no intermediate table churn.

	local TweenService = game:GetService("TweenService")

	local Creator = {}

	local EASE = Enum.EasingStyle.Quint
	local DIRECTION = Enum.EasingDirection.Out

	function Creator.New(className: string, properties: { [string]: any }?, children: { Instance }?): Instance
		local inst = Instance.new(className)
		if properties then
			for prop, value in pairs(properties) do
				if prop ~= "Parent" then
					(inst :: any)[prop] = value
				end
			end
		end
		if children then
			for _, child in ipairs(children) do
				child.Parent = inst
			end
		end
		if properties and properties.Parent then
			inst.Parent = properties.Parent
		end
		return inst
	end

	function Creator.Corner(radius: number?): UICorner
		return Creator.New("UICorner", { CornerRadius = UDim.new(0, radius or 6) }) :: UICorner
	end

	function Creator.Stroke(props: { Color: Color3?, Thickness: number?, Transparency: number? }?): UIStroke
		props = props or {}
		return Creator.New("UIStroke", {
			Color = props.Color or Color3.new(0, 0, 0),
			Thickness = props.Thickness or 1,
			Transparency = props.Transparency or 0,
			ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
		}) :: UIStroke
	end

	function Creator.Padding(all: number?, top: number?, right: number?, bottom: number?, left: number?): UIPadding
		return Creator.New("UIPadding", {
			PaddingTop = UDim.new(0, top or all or 0),
			PaddingRight = UDim.new(0, right or all or 0),
			PaddingBottom = UDim.new(0, bottom or all or 0),
			PaddingLeft = UDim.new(0, left or all or 0),
		}) :: UIPadding
	end

	function Creator.ListLayout(direction: Enum.FillDirection?, gap: number?, alignment: Enum.HorizontalAlignment?): UIListLayout
		return Creator.New("UIListLayout", {
			FillDirection = direction or Enum.FillDirection.Vertical,
			Padding = UDim.new(0, gap or 6),
			HorizontalAlignment = alignment or Enum.HorizontalAlignment.Left,
			SortOrder = Enum.SortOrder.LayoutOrder,
		}) :: UIListLayout
	end

	function Creator.Tween(instance: Instance, info: TweenInfo, properties: { [string]: any }): Tween
		local tween = TweenService:Create(instance, info, properties)
		tween:Play()
		return tween
	end

	-- Standard "premium" easing used across hover/press/open/close animations
	-- so the whole library reads as one motion language.
	function Creator.Animate(instance: Instance, properties: { [string]: any }, duration: number?, style: Enum.EasingStyle?, direction: Enum.EasingDirection?): Tween
		return Creator.Tween(
			instance,
			TweenInfo.new(duration or 0.22, style or EASE, direction or DIRECTION),
			properties
		)
	end

	-- Quick, snappy tween for micro-interactions (button press, toggle flick).
	function Creator.Snap(instance: Instance, properties: { [string]: any }, duration: number?): Tween
		return Creator.Tween(
			instance,
			TweenInfo.new(duration or 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			properties
		)
	end

	-- Cheap dependency-free "elevation" shadow: one extra semi-transparent
	-- rounded Frame beneath the surface, no external image asset to fetch
	-- (nothing that can 404 or get flagged as an unverified download).
	--
	-- `holder` must be a plain, non-layout Frame (ClipsDescendants = false)
	-- that you parent both the shadow and your real content into, e.g.:
	--   local holder = Creator.New("Frame", {BackgroundTransparency = 1, ClipsDescendants = false, Parent = list})
	--   Creator.Shadow(holder)
	--   local card = Creator.New("Frame", {ZIndex = 2, Parent = holder, ...})
	-- Reserved for top-level/overlay surfaces (window chrome, notifications,
	-- dropdown/colorpicker popups, tooltips) -- not per-row elements, to keep
	-- instance count low on large option lists.
	function Creator.Shadow(holder: Instance, radius: number?, intensity: number?): Frame
		local shadow = Creator.New("Frame", {
			Name = "Shadow",
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 1 - (intensity or 0.4),
			Size = UDim2.new(1, 20, 1, 20),
			Position = UDim2.new(0, -10, 0, -6),
			ZIndex = 1,
			Parent = holder,
		}) :: Frame
		Creator.New("UICorner", { CornerRadius = UDim.new(0, (radius or 10) + 8) }).Parent = shadow
		Creator.New("UIGradient", {
			Rotation = 90,
			Transparency = NumberSequence.new({
				NumberSequenceKeypoint.new(0, 0.2),
				NumberSequenceKeypoint.new(1, 1),
			}),
		}).Parent = shadow
		return shadow
	end

	-- Normalises an icon prop (assetId number, "123", "rbxassetid://123",
	-- or a full rbxasset/http url) into a usable Image string. Returns ""
	-- for nil/empty so callers can just set ImageLabel.Image directly.
	function Creator.ResolveIcon(icon: (string | number)?): string
		if icon == nil then
			return ""
		end
		if typeof(icon) == "number" then
			return "rbxassetid://" .. tostring(icon)
		end
		local s = icon :: string
		if s == "" then
			return ""
		end
		if s:match("^rbxassetid://") or s:match("^rbxasset://") or s:match("^http") then
			return s
		end
		if s:match("^%d+$") then
			return "rbxassetid://" .. s
		end
		return s
	end

	-- Lucide icon support ("lucide:icon-name", matching WindUI's own
	-- convention), backed by the real open-source lucide-roblox icon data
	-- (https://github.com/VirtualButFake/lucide-roblox), fetched once and
	-- cached. Requires a script executor (loadstring + HttpGet); falls
	-- back to no icon rather than erroring when that's unavailable (plain
	-- Studio, no internet, etc.) so a missing icon never breaks the UI.
	local LUCIDE_DATA_URL = "https://raw.githubusercontent.com/VirtualButFake/lucide-roblox/master/src/icons.luau"
	local lucideData: { any }? = nil
	local lucideLoadAttempted = false

	local function loadLucideData(): { any }?
		if lucideLoadAttempted then
			return lucideData
		end
		lucideLoadAttempted = true
		local ok, result = pcall(function()
			return loadstring(game:HttpGet(LUCIDE_DATA_URL))()
		end)
		if ok then
			lucideData = result
		else
			warn("[UILibrary] Lucide icons unavailable (needs a script executor with loadstring/HttpGet): " .. tostring(result))
		end
		return lucideData
	end

	-- Mirrors lucide-roblox's own GetAsset(name, size) algorithm against
	-- the fetched icon set: {Id, Url, ImageRectSize, ImageRectOffset}.
	function Creator.GetLucideAsset(name: string, size: number?): { [string]: any }?
		local data = loadLucideData()
		if not data then
			return nil
		end
		local iconIndices: { string } = data[1]
		local idIndices: { number } = data[2]
		local iconRegistry: { [number]: any } = data[3]

		local iconIndex = table.find(iconIndices, name)
		if not iconIndex then
			return nil
		end

		size = size or 48
		local currentDifference = math.huge
		local currentSize = size
		for registrySize in pairs(iconRegistry) do
			local diff = math.abs(size - registrySize)
			if diff < currentDifference then
				currentDifference = diff
				currentSize = registrySize
			end
		end

		local icon = iconRegistry[currentSize][iconIndex]
		if icon == nil then
			return nil
		end

		return {
			Id = idIndices[icon[1]],
			Url = "rbxassetid://" .. idIndices[icon[1]],
			ImageRectSize = Vector2.new(icon[2][1], icon[2][2]),
			ImageRectOffset = Vector2.new(icon[3][1], icon[3][2]),
		}
	end

	-- Applies an Icon prop to an ImageLabel. Accepts everything
	-- ResolveIcon does (asset id/rbxassetid/rbxasset/http url), plus
	-- "lucide:icon-name" for the full Lucide set via GetLucideAsset.
	function Creator.ApplyIcon(imageLabel: ImageLabel, icon: (string | number)?, size: number?)
		if typeof(icon) == "string" and (icon :: string):match("^lucide:") then
			local name = (icon :: string):sub(8)
			local asset = Creator.GetLucideAsset(name, size)
			if asset then
				imageLabel.Image = asset.Url
				imageLabel.ImageRectOffset = asset.ImageRectOffset
				imageLabel.ImageRectSize = asset.ImageRectSize
				return
			end
			-- fetch failed or name not found -- leave blank rather than
			-- showing a broken/mismatched sprite region
			imageLabel.Image = ""
			imageLabel.ImageRectOffset = Vector2.zero
			imageLabel.ImageRectSize = Vector2.zero
			return
		end

		imageLabel.Image = Creator.ResolveIcon(icon)
		imageLabel.ImageRectOffset = Vector2.zero
		imageLabel.ImageRectSize = Vector2.zero
	end

	return Creator
end)()


local Draggable = (function()
	-- Shared drag + resize logic for window chrome. Works identically for
	-- mouse (PC) and touch (mobile) since both surface through InputObject.

	local UserInputService = game:GetService("UserInputService")

	local Draggable = {}

	local function isPointerInput(inputType: Enum.UserInputType): boolean
		return inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch
	end

	-- Makes `target` draggable by pressing on `handle`. Position-only, clamped
	-- optionally to keep the window on-screen.
	function Draggable.MakeDraggable(handle: GuiObject, target: GuiObject, opts: { OnStart: (() -> ())?, OnUpdate: ((UDim2) -> ())?, OnEnd: (() -> ())?, Clamp: boolean? }?)
		opts = opts or {}
		local dragging = false
		local dragInput: InputObject? = nil
		local dragStart: Vector3 = Vector3.zero
		local startPos: UDim2 = target.Position

		local beganConn = handle.InputBegan:Connect(function(input: InputObject)
			if not isPointerInput(input.UserInputType) then
				return
			end
			dragging = true
			dragStart = input.Position
			startPos = target.Position
			if opts.OnStart then
				opts.OnStart()
			end

			local changedConn: RBXScriptConnection
			changedConn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					dragging = false
					changedConn:Disconnect()
					if opts.OnEnd then
						opts.OnEnd()
					end
				end
			end)
		end)

		local changedConn2 = handle.InputChanged:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
			end
		end)

		local inputChangedConn = UserInputService.InputChanged:Connect(function(input: InputObject)
			if dragging and input == dragInput then
				local delta = input.Position - dragStart
				local newPos = UDim2.new(
					startPos.X.Scale,
					startPos.X.Offset + delta.X,
					startPos.Y.Scale,
					startPos.Y.Offset + delta.Y
				)
				target.Position = newPos
				if opts.OnUpdate then
					opts.OnUpdate(newPos)
				end
			end
		end)

		return {
			Disconnect = function()
				dragging = false
				beganConn:Disconnect()
				changedConn2:Disconnect()
				inputChangedConn:Disconnect()
			end,
		}
	end

	-- Makes `target` resizable by dragging `handle` (typically a small grip
	-- in the bottom-right corner). Enforces a minimum size.
	function Draggable.MakeResizable(handle: GuiObject, target: GuiObject, minSize: Vector2, opts: { OnUpdate: ((UDim2) -> ())? }?)
		opts = opts or {}
		local resizing = false
		local dragInput: InputObject? = nil
		local dragStart: Vector3 = Vector3.zero
		local startSize: UDim2 = target.Size

		local beganConn = handle.InputBegan:Connect(function(input: InputObject)
			if not isPointerInput(input.UserInputType) then
				return
			end
			resizing = true
			dragStart = input.Position
			startSize = target.Size

			local changedConn: RBXScriptConnection
			changedConn = input.Changed:Connect(function()
				if input.UserInputState == Enum.UserInputState.End then
					resizing = false
					changedConn:Disconnect()
				end
			end)
		end)

		local changedConn2 = handle.InputChanged:Connect(function(input: InputObject)
			if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
				dragInput = input
			end
		end)

		local inputChangedConn = UserInputService.InputChanged:Connect(function(input: InputObject)
			if resizing and input == dragInput then
				local delta = input.Position - dragStart
				local newWidth = math.max(minSize.X, startSize.X.Offset + delta.X)
				local newHeight = math.max(minSize.Y, startSize.Y.Offset + delta.Y)
				local newSize = UDim2.new(startSize.X.Scale, newWidth, startSize.Y.Scale, newHeight)
				target.Size = newSize
				if opts.OnUpdate then
					opts.OnUpdate(newSize)
				end
			end
		end)

		return {
			Disconnect = function()
				resizing = false
				beganConn:Disconnect()
				changedConn2:Disconnect()
				inputChangedConn:Disconnect()
			end,
		}
	end

	return Draggable
end)()


local Row = (function()
	-- Shared "label left, control right" row shell used by Toggle, Slider,
	-- Dropdown, Textbox, Keybind and ColorPicker so every element shares the
	-- exact same card, spacing, hover and tooltip behaviour.


	local Row = {}

	function Row.new(parent: Instance, props: { [string]: any }, context: { [string]: any }, opts: { [string]: any }?)
		opts = opts or {}
		local Theme = context.Theme
		local height = opts.Height or 38

		local holder = Creator.New("Frame", {
			Name = (props.Title or "Row") .. "Row",
			Size = UDim2.new(1, 0, 0, height),
			BackgroundColor3 = Theme.Get("Tertiary"),
			LayoutOrder = props.LayoutOrder or 0,
			Visible = props.Visible ~= false,
			ZIndex = 2,
			Parent = parent,
		}, {
			Creator.Corner(6),
			Creator.Padding(0, 0, 10, 0, 10),
		})
		Theme.Register(holder, { BackgroundColor3 = "Tertiary" })

		local title = Creator.New("TextLabel", {
			Name = "Title",
			Size = UDim2.new(1, -((opts.ControlWidth or 0) + 10), 1, 0),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamMedium,
			Text = props.Title or "",
			TextSize = 13,
			TextColor3 = Theme.Get("Text"),
			TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd,
			ZIndex = 3,
			Parent = holder,
		})
		Theme.Register(title, { TextColor3 = "Text" })

		if props.Tooltip and context.Tooltip then
			context.Tooltip:Bind(holder, props.Tooltip)
		end

		holder.MouseEnter:Connect(function()
			Creator.Snap(holder, { BackgroundColor3 = Theme.Get("Elevated") })
		end)
		holder.MouseLeave:Connect(function()
			Creator.Snap(holder, { BackgroundColor3 = Theme.Get("Tertiary") })
		end)

		return { Holder = holder, Title = title }
	end

	return Row
end)()


local Themes = (function()
	-- Central theme registry. Elements register {property -> paletteKey} maps
	-- once at creation time; switching theme is then a single O(registered)
	-- pass, never a Descendants scan of the whole UI tree.


	type Palette = {
		Accent: Color3,
		AccentDark: Color3,
		Background: Color3,
		Secondary: Color3,
		Tertiary: Color3,
		Elevated: Color3,
		Border: Color3,
		Text: Color3,
		SubText: Color3,
		Success: Color3,
		Warning: Color3,
		Error: Color3,
		Font: Enum.Font,
	}

	local Themes = {}
	Themes.Current = "Dark"
	Themes.Changed = Signal.new()

	Themes.Palettes = {
		Dark = {
			Accent = Color3.fromRGB(88, 101, 242),
			AccentDark = Color3.fromRGB(64, 75, 199),
			Background = Color3.fromRGB(22, 22, 26),
			Secondary = Color3.fromRGB(30, 30, 35),
			Tertiary = Color3.fromRGB(38, 38, 44),
			Elevated = Color3.fromRGB(46, 46, 53),
			Border = Color3.fromRGB(54, 54, 61),
			Text = Color3.fromRGB(242, 242, 247),
			SubText = Color3.fromRGB(160, 160, 170),
			Success = Color3.fromRGB(87, 201, 128),
			Warning = Color3.fromRGB(230, 180, 80),
			Error = Color3.fromRGB(235, 92, 92),
			Font = Enum.Font.GothamMedium,
		} :: Palette,

		Light = {
			Accent = Color3.fromRGB(79, 92, 235),
			AccentDark = Color3.fromRGB(60, 72, 200),
			Background = Color3.fromRGB(245, 245, 249),
			Secondary = Color3.fromRGB(255, 255, 255),
			Tertiary = Color3.fromRGB(237, 237, 242),
			Elevated = Color3.fromRGB(255, 255, 255),
			Border = Color3.fromRGB(222, 222, 229),
			Text = Color3.fromRGB(26, 26, 30),
			SubText = Color3.fromRGB(105, 105, 115),
			Success = Color3.fromRGB(45, 160, 90),
			Warning = Color3.fromRGB(195, 135, 20),
			Error = Color3.fromRGB(205, 60, 60),
			Font = Enum.Font.GothamMedium,
		} :: Palette,

		Midnight = {
			Accent = Color3.fromRGB(122, 142, 255),
			AccentDark = Color3.fromRGB(92, 108, 212),
			Background = Color3.fromRGB(9, 10, 16),
			Secondary = Color3.fromRGB(15, 16, 24),
			Tertiary = Color3.fromRGB(21, 23, 33),
			Elevated = Color3.fromRGB(27, 29, 42),
			Border = Color3.fromRGB(38, 40, 56),
			Text = Color3.fromRGB(233, 235, 245),
			SubText = Color3.fromRGB(138, 141, 163),
			Success = Color3.fromRGB(90, 210, 150),
			Warning = Color3.fromRGB(240, 190, 90),
			Error = Color3.fromRGB(240, 100, 110),
			Font = Enum.Font.GothamMedium,
		} :: Palette,

		Modern = {
			Accent = Color3.fromRGB(0, 199, 161),
			AccentDark = Color3.fromRGB(0, 162, 132),
			Background = Color3.fromRGB(17, 19, 22),
			Secondary = Color3.fromRGB(25, 27, 31),
			Tertiary = Color3.fromRGB(33, 36, 41),
			Elevated = Color3.fromRGB(41, 44, 50),
			Border = Color3.fromRGB(51, 55, 61),
			Text = Color3.fromRGB(240, 242, 240),
			SubText = Color3.fromRGB(153, 158, 156),
			Success = Color3.fromRGB(0, 199, 161),
			Warning = Color3.fromRGB(240, 180, 70),
			Error = Color3.fromRGB(235, 95, 95),
			Font = Enum.Font.GothamMedium,
		} :: Palette,
	} :: { [string]: Palette }

	-- "Custom" starts as a clone of Dark; ThemeEditor / ConfigManager mutate
	-- this table in place and call Themes.SetTheme("Custom") to preview.
	Themes.Palettes.Custom = table.clone(Themes.Palettes.Dark)

	type RegistryEntry = { [string]: string }
	local Registry: { [Instance]: RegistryEntry } = {}
	local Cleanup: { [Instance]: RBXScriptConnection } = {}

	local function applyMap(instance: Instance, map: RegistryEntry, palette: Palette)
		for prop, key in pairs(map) do
			local value = (palette :: any)[key]
			if value ~= nil then
				local ok = pcall(function()
					(instance :: any)[prop] = value
				end)
				if not ok then
					-- property/type mismatch (e.g. Font key applied to a Frame) -- ignore
				end
			end
		end
	end

	-- Registers `instance` for automatic property updates on theme switch.
	-- `map` example: {BackgroundColor3 = "Secondary", TextColor3 = "Text"}
	function Themes.Register(instance: Instance, map: RegistryEntry): Instance
		Registry[instance] = map
		applyMap(instance, map, Themes.Palettes[Themes.Current])

		if not Cleanup[instance] then
			Cleanup[instance] = instance.AncestryChanged:Connect(function(_, parent)
				if not parent then
					Themes.Unregister(instance)
				end
			end)
		end
		return instance
	end

	function Themes.Unregister(instance: Instance)
		Registry[instance] = nil
		local conn = Cleanup[instance]
		if conn then
			conn:Disconnect()
			Cleanup[instance] = nil
		end
	end

	function Themes.Get(key: string): any
		return (Themes.Palettes[Themes.Current] :: any)[key]
	end

	function Themes.GetPalette(): Palette
		return Themes.Palettes[Themes.Current]
	end

	function Themes.SetTheme(name: string, customPalette: Palette?)
		if name == "Custom" and customPalette then
			Themes.Palettes.Custom = customPalette
		end
		local palette = Themes.Palettes[name]
		if not palette then
			warn("[UILibrary] Unknown theme: " .. tostring(name))
			return
		end
		Themes.Current = name

		for instance, map in pairs(Registry) do
			if instance.Parent then
				applyMap(instance, map, palette)
			else
				Themes.Unregister(instance)
			end
		end

		Themes.Changed:Fire(name, palette)
	end

	-- Applies a single changed key (e.g. from the live theme editor) to every
	-- registered instance without a full theme switch.
	function Themes.SetCustomColor(key: string, value: Color3)
		Themes.Palettes.Custom[key :: any] = value :: any
		if Themes.Current == "Custom" then
			for instance, map in pairs(Registry) do
				if instance.Parent then
					for prop, mapKey in pairs(map) do
						if mapKey == key then
							pcall(function()
								(instance :: any)[prop] = value
							end)
						end
					end
				else
