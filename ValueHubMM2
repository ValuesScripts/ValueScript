			end

			local api = { Instance = holder }
			function api.Destroy() holder:Destroy() end
			return api
		end
		Registry.Register("ExecutorInfo", buildExecutorInfo, { "ExecutorInfo" })

		return true
	end)

	--============================================================================
	-- COMPONENTS: DatePicker, TimePicker, RadialMenu, FloatingButton, Tooltip
	--============================================================================

	register("Component_Extra", function(import)
		local Utility = import("Utility")
		local Animator = import("Animator")
		local Theme = import("Theme")
		local Base = import("ComponentBase")
		local Registry = import("ComponentRegistry")
		local Config = import("Config")
		local Icons = import("Icons")
		local Draggable = import("Draggable")
		local RunService = game:GetService("RunService")
		local Create = Utility.Create

		local function daysInMonth(year, month)
			local days = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 }
			local d = days[month]
			if month == 2 and (year % 4 == 0 and (year % 100 ~= 0 or year % 400 == 0)) then d = 29 end
			return d
		end

		-- ---------- Date Picker ----------
		local function buildDatePicker(parent, opts, ctx)
			local colors = Theme.Get()
			local now = os.date("*t")
			local date = opts.Default or { Year = now.year, Month = now.month, Day = now.day }

			local card = Base.Card(parent, opts, { Inline = true, ControlSize = UDim2.fromOffset(120, 28) })
			local field = Create("TextButton", {
				Text = string.format("%04d-%02d-%02d", date.Year, date.Month, date.Day),
				Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = colors.Text,
				AutoButtonColor = false, BackgroundColor3 = colors.Elevated, BackgroundTransparency = 0.1,
				Size = UDim2.fromScale(1, 1), Parent = card.Control,
			})
			Utility.Corner(8, field)
			Utility.Stroke({ Color = colors.Border, Transparency = colors.BorderAlpha }, field)

			local api = {}
			api.Changed = import("Signal").new()
			api.Instance = card.Root

			local function fireChange(silent)
				field.Text = string.format("%04d-%02d-%02d", date.Year, date.Month, date.Day)
				if not silent then
					if opts.Callback then task.spawn(opts.Callback, date) end
					api.Changed:Fire(date)
					if opts.Flag then Config.Set(opts.Flag, date) end
				end
			end

			local popupOpen, catcher, popup, renderConn
			local function closePopup()
				if not popupOpen then return end
				popupOpen = false
				if renderConn then renderConn:Disconnect() end
				local p, c = popup, catcher
				popup, catcher = nil, nil
				if p then p:Destroy() end
				if c then c:Destroy() end
			end

			local function openPopup()
				popupOpen = true
				local viewMonth, viewYear = date.Month, date.Year

				catcher = Create("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 899, Parent = ctx.Root })
				catcher.MouseButton1Click:Connect(closePopup)

				popup = Create("Frame", {
					BackgroundColor3 = colors.ElevatedAlt, BackgroundTransparency = 0.05,
					Size = UDim2.fromOffset(220, 240),
					Position = UDim2.fromOffset(field.AbsolutePosition.X - 220 + field.AbsoluteSize.X, field.AbsolutePosition.Y + field.AbsoluteSize.Y + 6),
					ZIndex = 900, ClipsDescendants = true, Parent = ctx.Root,
				})
				Utility.Corner(12, popup)
				Utility.Stroke({ Color = colors.Border, Transparency = colors.BorderAlpha }, popup)
				Utility.Shadow({ Transparency = 0.5, Spread = 26 }, popup)
				Utility.Padding({ All = 10 }, popup)

				local header = Create("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 24), ZIndex = 901, Parent = popup })
				local monthLabel = Create("TextLabel", {
					Text = os.date("%B", os.time({ year = viewYear, month = viewMonth, day = 1 })) .. " " .. viewYear,
					Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = colors.Text,
					BackgroundTransparency = 1, Size = UDim2.new(1, -60, 1, 0), Position = UDim2.new(0, 30, 0, 0),
					TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 901, Parent = header,
				})
				local prevBtn = Create("ImageButton", { ImageColor3 = colors.SubText, BackgroundTransparency = 1, Size = UDim2.fromOffset(11, 11), Position = UDim2.new(0, 4, 0.5, 0), AnchorPoint = Vector2.new(0, 0.5), ZIndex = 901, Parent = header })
				Icons.Apply(prevBtn, Icons.ChevronLeft)
				local nextBtn = Create("ImageButton", { ImageColor3 = colors.SubText, BackgroundTransparency = 1, Size = UDim2.fromOffset(11, 11), Position = UDim2.new(1, -4, 0.5, 0), AnchorPoint = Vector2.new(1, 0.5), ZIndex = 901, Parent = header })
				Icons.Apply(nextBtn, Icons.ChevronRight)

				local grid = Create("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 0, 30), Size = UDim2.new(1, 0, 1, -30), ZIndex = 901, Parent = popup })
				Create("UIGridLayout", { CellSize = UDim2.fromOffset(26, 26), CellPadding = UDim2.fromOffset(2, 2), Parent = grid })

				local function renderGrid()
					for _, c in ipairs(grid:GetChildren()) do
						if c:IsA("TextButton") then c:Destroy() end
					end
					monthLabel.Text = os.date("%B", os.time({ year = viewYear, month = viewMonth, day = 1 })) .. " " .. viewYear
					for d = 1, daysInMonth(viewYear, viewMonth) do
						local isSelected = (d == date.Day and viewMonth == date.Month and viewYear == date.Year)
						local dayBtn = Create("TextButton", {
							Text = tostring(d), Font = Enum.Font.Gotham, TextSize = 12,
							TextColor3 = isSelected and Color3.new(1, 1, 1) or colors.Text,
							BackgroundColor3 = colors.Accent, BackgroundTransparency = isSelected and 0.1 or 1,
							AutoButtonColor = false, ZIndex = 902, Parent = grid,
						})
						Utility.Corner(6, dayBtn)
						dayBtn.MouseButton1Click:Connect(function()
							date = { Year = viewYear, Month = viewMonth, Day = d }
							fireChange(false)
							closePopup()
						end)
					end
				end
				renderGrid()

				prevBtn.MouseButton1Click:Connect(function()
					viewMonth -= 1
					if viewMonth < 1 then viewMonth = 12; viewYear -= 1 end
					renderGrid()
				end)
				nextBtn.MouseButton1Click:Connect(function()
					viewMonth += 1
					if viewMonth > 12 then viewMonth = 1; viewYear += 1 end
					renderGrid()
				end)

				renderConn = RunService.RenderStepped:Connect(function()
					if not field.Parent then closePopup(); return end
					popup.Position = UDim2.fromOffset(field.AbsolutePosition.X - 220 + field.AbsoluteSize.X, field.AbsolutePosition.Y + field.AbsoluteSize.Y + 6)
				end)
			end

			field.MouseButton1Click:Connect(function() if popupOpen then closePopup() else openPopup() end end)

			function api.Set(v, silent) date = v; fireChange(silent) end
			function api.Get() return date end
			function api.Destroy() closePopup(); card.Root:Destroy() end
			if opts.Flag then Config.Register(opts.Flag, date, function(v) date = v; fireChange(true) end) end
			return api
		end
		Registry.Register("DatePicker", buildDatePicker, { "DatePicker" })

		-- ---------- Time Picker ----------
		local function buildTimePicker(parent, opts, ctx)
			local colors = Theme.Get()
			local time = opts.Default or { Hour = 12, Minute = 0 }

			local card = Base.Card(parent, opts, { Inline = true, ControlSize = UDim2.fromOffset(110, 30) })
			local holder = card.Control
			Utility.ListLayout({ FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Right, Padding = UDim.new(0, 4) }, holder)

			local api = {}
			api.Changed = import("Signal").new()
			api.Instance = card.Root

			local function fire(silent)
				if not silent then
					if opts.Callback then task.spawn(opts.Callback, time) end
					api.Changed:Fire(time)
					if opts.Flag then Config.Set(opts.Flag, time) end
				end
			end

			local function stepper(key, max)
				local box = Create("Frame", { BackgroundColor3 = colors.Elevated, BackgroundTransparency = 0.1, Size = UDim2.fromOffset(48, 30), Parent = holder })
				Utility.Corner(7, box)
				local label = Create("TextLabel", {
					Text = string.format("%02d", time[key]), Font = Enum.Font.GothamMedium, TextSize = 12, TextColor3 = colors.Text,
					BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, -14), Parent = box,
				})
				local upBtn = Create("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(0.5, 0, 0, 7), Position = UDim2.new(0, 0, 1, -7), Parent = box })
				local downBtn = Create("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.new(0.5, 0, 0, 7), Position = UDim2.new(0.5, 0, 1, -7), Parent = box })
				local upImg = Create("ImageLabel", { ImageColor3 = colors.MutedText, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = upBtn })
				Icons.Apply(upImg, Icons.ChevronUp)
				local downImg = Create("ImageLabel", { ImageColor3 = colors.MutedText, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Parent = downBtn })
				Icons.Apply(downImg, Icons.ChevronDown)
				upBtn.MouseButton1Click:Connect(function()
					time[key] = (time[key] + 1) % (max + 1)
					label.Text = string.format("%02d", time[key])
					fire(false)
				end)
				downBtn.MouseButton1Click:Connect(function()
					time[key] = (time[key] - 1) % (max + 1)
					label.Text = string.format("%02d", time[key])
					fire(false)
				end)
				return label
			end

			local hourLabel = stepper("Hour", 23)
			Create("TextLabel", { Text = ":", Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = colors.SubText, BackgroundTransparency = 1, Size = UDim2.fromOffset(8, 30), Parent = holder })
			local minuteLabel = stepper("Minute", 59)

			function api.Set(v, silent)
				time = v
				hourLabel.Text = string.format("%02d", time.Hour)
				minuteLabel.Text = string.format("%02d", time.Minute)
				fire(silent)
			end
			function api.Get() return time end
			function api.Destroy() card.Root:Destroy() end
			if opts.Flag then Config.Register(opts.Flag, time, function(v) api.Set(v, true) end) end
			return api
		end
		Registry.Register("TimePicker", buildTimePicker, { "TimePicker" })

		-- ---------- Radial Menu ----------
		local function buildRadialMenu(parent, opts, ctx)
			local colors = Theme.Get()
			local items = opts.Items or {}
			local api = {}
			api.Instance = nil

			local function open(centerX, centerY)
				local radius = opts.Radius or 90
				local catcher = Create("TextButton", { Text = "", AutoButtonColor = false, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ZIndex = 949, Parent = ctx.Root })
				local wrap = Create("Frame", {
					BackgroundTransparency = 1, Size = UDim2.fromOffset(radius * 2 + 60, radius * 2 + 60),
					Position = UDim2.fromOffset(centerX, centerY), AnchorPoint = Vector2.new(0.5, 0.5),
					ZIndex = 950, Parent = ctx.Root,
				})
				local center = Create("Frame", { BackgroundColor3 = colors.ElevatedAlt, BackgroundTransparency = 0.1, Size = UDim2.fromOffset(46, 46), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 951, Parent = wrap })
				Utility.Corner(23, center)
				Utility.Stroke({ Color = colors.Border, Transparency = colors.BorderAlpha }, center)

				local spawned = { center }
				local function close()
					catcher:Destroy()
					for _, inst in ipairs(spawned) do
						Animator.Close(inst, { Size = UDim2.fromOffset(0, 0) }, 0.16)
					end
					task.delay(0.18, function() wrap:Destroy() end)
				end
				catcher.MouseButton1Click:Connect(close)

				for i, item in ipairs(items) do
					local Base2 = import("ComponentBase")
					local pos = Base2.PlaceRadial(i, #items, radius)
					local btn = Create("TextButton", {
						Text = "", AutoButtonColor = false, BackgroundColor3 = colors.Elevated, BackgroundTransparency = 0.1,
						Size = UDim2.fromOffset(0, 0), Position = pos, AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 952, Parent = wrap,
					})
					Utility.Corner(20, btn)
					Utility.Stroke({ Color = colors.Border, Transparency = colors.BorderAlpha }, btn)
					local icon = Icons.Resolve(item.Icon)
					if icon then
						Create("ImageLabel", { Image = icon, ImageColor3 = colors.Text, BackgroundTransparency = 1, Size = UDim2.fromOffset(16, 16), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5), ZIndex = 953, Parent = btn })
					else
						Create("TextLabel", { Text = item.Text or "", Font = Enum.Font.GothamMedium, TextSize = 10, TextColor3 = colors.Text, BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), TextWrapped = true, ZIndex = 953, Parent = btn })
					end
					Animator.Open(btn, { Size = UDim2.fromOffset(40, 40) }, 0.28)
					table.insert(spawned, btn)
					btn.MouseButton1Click:Connect(function()
						close()
						if item.Callback then task.spawn(item.Callback) end
					end)
				end
			end

			function api.Open(x, y) open(x, y) end
			return api
		end
		Registry.Register("RadialMenu", buildRadialMenu, { "RadialMenu" })

		-- ---------- Floating Button (draggable, section-attached) ----------
		local function buildFloatingButton(parent, opts, ctx)
			local colors = Theme.Get()
			local btn = Create("ImageButton", {
				Image = Icons.Resolve(opts.Icon) or "",
