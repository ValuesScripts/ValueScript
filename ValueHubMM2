		-- ---------- RichText / Markdown ----------
		local function mdToRichText(src)
			local out = src
			out = out:gsub("%*%*(.-)%*%*", "<b>%1</b>")
			out = out:gsub("%*(.-)%*", "<i>%1</i>")
			out = out:gsub("`(.-)`", '<font face="RobotoMono">%1</font>')
			out = out:gsub("^#### (.-)$", '<font size="15"><b>%1</b></font>')
			out = out:gsub("^### (.-)$", '<font size="17"><b>%1</b></font>')
			out = out:gsub("^## (.-)$", '<font size="19"><b>%1</b></font>')
			out = out:gsub("^# (.-)$", '<font size="22"><b>%1</b></font>')
			out = out:gsub("\n%- (.-)\n", "\n• %1\n")
			return out
		end

