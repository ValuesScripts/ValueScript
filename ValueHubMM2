		-- ---------- Console / Terminal / Log Viewer ----------
		local LOG_COLORS_KEY = { Info = "Info", Success = "Success", Warning = "Warning", Error = "Error" }
		local MAX_LINES = 200

		local function buildConsole(parent, opts, ctx)
			local colors = Theme.Get()
			local hasInput = opts.Input == true

			local holder = Create("Frame", {
				BackgroundColor3 = colors.Background, BackgroundTransparency = 0.1,
				Size = UDim2.new(1, 0, 0, opts.Height or 200), Parent = parent,
			})
			Utility.Corner(10, holder)
			Utility.Stroke({ Color = colors.Border, Transparency = colors.BorderAlpha }, holder)

			local list = Create("ScrollingFrame", {
				BackgroundTransparency = 1,
				Size = UDim2.new(1, 0, 1, hasInput and -36 or 0),
				CanvasSize = UDim2.new(0, 0, 0, 0),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollBarThickness = 3,
				Parent = holder,
			})
			Utility.Padding({ All = 8 }, list)
			Utility.ListLayout({ Padding = UDim.new(0, 2) }, list)

			local lineCount = 0
			local function log(text, level)
				level = level or "Info"
				local color = colors[LOG_COLORS_KEY[level]] or colors.SubText
				local line = Create("TextLabel", {
					Text = string.format("[%s] %s", os.date("%H:%M:%S"), text),
					Font = Enum.Font.RobotoMono, TextSize = 12, TextColor3 = color,
					TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true,
					BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y, Parent = list,
				})
				lineCount += 1
				if lineCount > MAX_LINES then
					local oldest = list:FindFirstChildOfClass("TextLabel")
					if oldest then oldest:Destroy() end
					lineCount -= 1
				end
				task.defer(function()
					list.CanvasPosition = Vector2.new(0, math.max(0, list.AbsoluteCanvasSize.Y - list.AbsoluteSize.Y))
				end)
			end

			if hasInput then
				local inputRow = Create("Frame", {
					BackgroundTransparency = 1, Position = UDim2.new(0, 0, 1, -36),
					Size = UDim2.new(1, 0, 0, 36), Parent = holder,
				})
				Utility.Padding({ All = 6 }, inputRow)
				local box = Create("TextBox", {
					Text = "", PlaceholderText = opts.Placeholder or "Type a command and press Enter...",
					PlaceholderColor3 = colors.MutedText, Font = Enum.Font.RobotoMono, TextSize = 12,
					TextColor3 = colors.Text, TextXAlignment = Enum.TextXAlignment.Left,
					BackgroundColor3 = colors.Elevated, BackgroundTransparency = 0.1,
					Size = UDim2.fromScale(1, 1), Parent = inputRow,
				})
				Utility.Corner(6, box)
				Utility.Padding({ Left = UDim.new(0, 8) }, box)
				box.FocusLost:Connect(function(enterPressed)
					if enterPressed and box.Text ~= "" then
						log("> " .. box.Text, "Info")
						if opts.OnCommand then task.spawn(opts.OnCommand, box.Text) end
						box.Text = ""
					end
				end)
			end

			if opts.Lines then
				for _, entry in ipairs(opts.Lines) do
					log(entry.Text or entry, entry.Level)
				end
			end

			local api = { Instance = holder }
			function api.Log(text, level) log(text, level) end
			function api.Clear()
				for _, c in ipairs(list:GetChildren()) do
					if c:IsA("TextLabel") then c:Destroy() end
				end
				lineCount = 0
			end
			function api.Destroy() holder:Destroy() end
			return api
		end
		Registry.Register("Console", buildConsole, { "Console", "LogViewer" })
		Registry.Register("Console", buildConsole, { "Terminal" }, { Input = true })

