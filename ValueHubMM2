		Theme.Current = "Dark"

		function Theme.Get()
			return Theme.Themes[Theme.Current]
		end

		function Theme.Set(name)
			if not Theme.Themes[name] then return false end
			Theme.Current = name
			Theme.Changed:Fire(Theme.Themes[name], name)
			return true
		end

		-- Registers (or overwrites) a custom theme, e.g. produced by the theme editor.
		function Theme.Register(name, colors, activate)
			Theme.Themes[name] = colors
			if activate then
				Theme.Set(name)
			end
		end

		function Theme.List()
			local names = {}
			for name in pairs(Theme.Themes) do
				table.insert(names, name)
			end
			table.sort(names)
			return names
		end

		-- Exports the active (or named) theme as a JSON-ready plain table.
		function Theme.Export(name)
			local colors = Theme.Themes[name or Theme.Current]
			local out = {}
			for key, value in pairs(colors) do
				if typeof(value) == "Color3" then
					out[key] = { R = value.R, G = value.G, B = value.B }
				else
					out[key] = value
				end
			end
			return out
		end

		-- Imports a theme previously produced by Theme.Export.
		function Theme.Import(name, data, activate)
			local colors = {}
			for key, value in pairs(data) do
				if type(value) == "table" and value.R then
					colors[key] = Color3.new(value.R, value.G, value.B)
				else
					colors[key] = value
				end
			end
			Theme.Register(name, colors, activate)
			return colors
		end

		return Theme
	end)

