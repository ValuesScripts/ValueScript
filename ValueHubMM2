local function BuildVisualsTab()
	local Tab = Window:CreateTab({ Name = "Visuals", Icon = "lucide:palette" })
	local Section = Tab:CreateSection({ Name = "Rendering" })

	Section:CreateDropdown({
		Title = "Game Mode",
		Options = { "Solo", "Duo", "Squad", "Custom" },
		Default = "Solo",
		Flag = "gameMode",
		Callback = function(value)
			print("Game Mode:", value)
		end,
	})

	Section:CreateDropdown({
		Title = "Active Modules",
		Multi = true,
		Options = { "ESP", "Tracers", "Fullbright", "Chams" },
		Default = { "ESP" },
		Flag = "activeModules",
		Callback = function(values)
			print("Active Modules:", table.concat(values, ", "))
		end,
	})

	Section:CreateColorPicker({
		Title = "Highlight Color",
		Default = Color3.fromRGB(88, 101, 242),
		Flag = "highlightColor",
		Callback = function(color)
			print("Highlight Color:", color)
		end,
	})

	Section:CreateDivider()

	local progress = Section:CreateProgressBar({ Title = "Cache Warmup", Default = 0 })
	task.spawn(function()
		for i = 0, 100, 5 do
			progress:Set(i / 100)
			task.wait(0.05)
		end
	end)
end

----------------------------------------------------------------------------
-- Module: Keybinds
-- Every Keybind fires Callback(true) on press and Callback(false) on
-- release. On a device with no keyboard (mobile), tapping the bound key
-- display fires press-then-release immediately instead of listening for
-- a physical key -- no special-casing needed in your own code.
----------------------------------------------------------------------------
local function BuildKeybindsTab()
	local Tab = Window:CreateTab({ Name = "Keybinds", Icon = "lucide:key-round" })
	local Section = Tab:CreateSection({ Name = "Bindings" })

	Section:CreateKeybind({
		Title = "Toggle UI",
		Default = Enum.KeyCode.RightControl,
		Flag = "toggleKeybind",
		Tooltip = "Click, then press a key (Esc to clear)",
		Callback = function(pressed)
			if pressed then
				print("Toggle UI keybind pressed")
			end
		end,
	})

	Section:CreateKeybind({
		Title = "Farm Item",
		Default = Enum.KeyCode.F,
		Flag = "farmKeybind",
		Callback = function(pressed)
			print("Farm Item:", pressed)
		end,
	})

	Section:CreateKeybind({
		Title = "Panic Button",
		Default = Enum.KeyCode.P,
		Flag = "panicKeybind",
		Callback = function(pressed)
			if pressed then
				Window:Notify({ Title = "Panic", Content = "Panic keybind triggered.", Type = "Warning", Duration = 3 })
			end
		end,
	})
end

